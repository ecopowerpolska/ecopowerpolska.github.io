---
// Kafelek.astro — jeden serwis: obrazek + nazwa + opis + domena jako link wychodzący, a pod nim
// wyniki PageSpeed Insights (src/data/pomiary.json, scripts/psi-realizacje.py, docs/POMIARY.md).
// Blok wyników stoi POZA linkiem kafelka, bo ma własny link „Sprawdź sam” (link w linku jest
// niedozwolony w HTML). Zero JavaScriptu: nawigację robi zwykły <a>, stany robi CSS.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import blog from '../data/blog.json';
import { tekst } from '../lib/tekst';

interface Props {
  nazwa: string;
  adres: string;
  opis?: string;
  obrazek?: ImageMetadata;
  alt?: string;
  /** Jedno zdanie „co zrobiliśmy” przy tej stronie (pole `zakres` w serwisy.json). Puste = brak akapitu. */
  zakres?: string;
  /** Kandydat na LCP — dokładnie JEDEN kafelek na stronie dostaje true. */
  pierwszy?: boolean;
  /** Wpis z src/data/pomiary.json dla tego adresu; brak = „pomiar w toku”. */
  pomiar?: unknown;
}

const { nazwa, adres, opis, obrazek, alt, zakres, pierwszy = false, pomiar } = Astro.props;
const zakresTekst = zakres?.trim() ?? '';

// Domena widoczna na kafelku — liczona z `adres`, nie osobne pole w schemacie.
// Dziś `nazwa` już JEST domeną („nadihome.pl”), więc pokazanie jej drugi raz byłoby
// powtórzeniem tego samego napisu w dwóch miejscach kafelka. Domenę pokazujemy
// osobno TYLKO gdy różni się od `nazwa` — czyli gdy w przyszłości ktoś wpisze
// nazwę marketingową („Nadi Home — studio wnętrz”), a adres zostanie techniczny.
// To samo pole `adres` służy więc podwójnie: celowi linku i etykiecie domeny.
let domena = '';
try {
  domena = new URL(adres).hostname.replace(/^www\./i, '');
} catch {
  domena = '';
}
const pokazDomene = domena !== '' && domena.toLowerCase() !== nazwa.trim().toLowerCase();

// Inicjały do placeholdera: dla nazwy domenopodobnej („nadihome.pl”) — dwie pierwsze
// litery przed kropką (jak dotąd: „NA”). Dla nazwy złożonej z kilku słów bez kropki
// („Nadi Home”) — pierwsza litera dwóch pierwszych słów („NH”), bo to czytelniejszy
// skrót niż dwie litery jednego słowa.
const slowa = nazwa.trim().split(/\s+/);
const inicjaly =
  slowa.length >= 2 && !nazwa.includes('.')
    ? (slowa[0][0] + slowa[1][0]).toUpperCase()
    : nazwa.split('.')[0].slice(0, 2).toUpperCase();

// ── Wyniki PageSpeed Insights ────────────────────────────────────────────────────────────────
// Kształt wpisu pisze scripts/psi-realizacje.py; strategia z błędem pomiaru bywa `null`.
interface Wyniki {
  wydajnosc?: number | null;
  dostepnosc?: number | null;
  sprawdzoneMetody?: number | null;
  seo?: number | null;
  przegladanieAgentowe?: number | null;
  agentoweZdane?: number;
  agentoweWszystkie?: number;
}
interface Pomiar {
  data?: string | null;
  mobile?: Wyniki | null;
  desktop?: Wyniki | null;
  teren?: string;
}
const p = (pomiar ?? null) as Pomiar | null;
const jestPomiar = !!(p && (p.mobile || p.desktop));
const KATEGORIE: { klucz: keyof Wyniki; nazwa: string }[] = [
  { klucz: 'wydajnosc', nazwa: 'Wydajność' },
  { klucz: 'dostepnosc', nazwa: 'Ułatwienia dostępu' },
  { klucz: 'sprawdzoneMetody', nazwa: 'Sprawdzone metody' },
  { klucz: 'seo', nazwa: 'SEO' },
  { klucz: 'przegladanieAgentowe', nazwa: 'Przeglądanie agentowe' },
];
// Próg jak w PageSpeed Insights: 90–100 = dobry (wypełniona akcentem), poniżej 90 = obrys bez wypełnienia.
// Liczba jest zawsze widoczna — kolor jej nie zastępuje. Osobnego tonu dla 0–49 motyw nie ma (jeden akcent).
const klasaWyniku = (w: number) => (w >= 90 ? 'pastylka--dobry' : 'pastylka--ponizej');
const dataPomiaru = (() => {
  const m = (p?.data ?? '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  return m ? `${m[3]}.${m[2]}.${m[1]}` : '';
})();
// Dane terenowe CrUX: `brak` albo FAST/AVERAGE/SLOW, z dopiskiem „(domena)”, gdy to wynik całej domeny.
const KATEGORIA_TERENU: Record<string, string> = { FAST: 'szybka', AVERAGE: 'do poprawy', SLOW: 'wolna' };
const teren = (p?.teren ?? 'brak').trim();
const terenKategoria = KATEGORIA_TERENU[teren.split(' ')[0]] ?? '';
const terenZdanie = terenKategoria
  ? `Wrażenia użytkowników (Chrome, ostatnie 28 dni${teren.includes('domena') ? ', cała domena' : ''}): ${terenKategoria}.`
  : 'Wrażenia użytkowników: brak danych — strona nowa; Chrome zbiera je od prawdziwych odwiedzin przez 28 dni.';
const adresPsi = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(adres)}`;
// Id nagłówka bloku pomiaru — unikalne na stronie, bo kafelków jest kilka.
const idPomiaru = `pomiar-${(domena || nazwa).toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// Link w treści strony (<main>), nie w stopce: bez `nofollow`, tylko `noopener` — reguła 4 skilla
// linkowanie-zewnetrzne (dofollow = brak nofollow). Pary A↔B i stopki pilnuje raport tego skilla.
// Strona klienta i PageSpeed otwierają się w NOWEJ KARCIE (Piotr 2026-10-27 17:45: z cudzej strony trudno
// wrócić na EcoPower); dopisek dla czytnika ekranu z blog.json (to samo pole co przy guziku udostępnienia).
const nowaKarta = tekst(blog.udostepnijNowaKarta, '(otwiera się w nowej karcie)');
// Znak nowej karty nie może zostać sam w wierszu („Garderoba na wymiar Warszawa” przy 1440 px): ostatnie słowo nazwy
// i znak stoją razem w jednym bloku bez łamania.
const slowaNazwy = nazwa.trim().split(/\s+/);
const ostatnieSlowo = slowaNazwy.pop() ?? '';
const poczatekNazwy = slowaNazwy.length ? `${slowaNazwy.join(' ')} ` : '';
---

<div class="kafelek">
  <a class="kafelek__link" href={adres} target="_blank" rel="noopener">
    <span class="kafelek__obraz">
      {
        obrazek ? (
          <Image
            src={obrazek}
            alt={alt ?? ''}
            width={720}
            height={450}
            format="webp"
            densities={[1, 2]}
            loading={pierwszy ? 'eager' : 'lazy'}
            fetchpriority={pierwszy ? 'high' : 'auto'}
            decoding="async"
          />
        ) : (
          <span class="kafelek__zastepnik" aria-hidden="true">
            {inicjaly}
          </span>
        )
      }
    </span>

    <span class="kafelek__stopka">
      <span class="kafelek__nazwa">
        {poczatekNazwy}
        <span class="kafelek__koniec-nazwy">{ostatnieSlowo}<svg class="kafelek__wyjscie" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg></span>
      </span>
      {opis && <span class="kafelek__opis">{opis}</span>}
      {zakresTekst && <span class="kafelek__zakres">{zakresTekst}</span>}
      {pokazDomene && <span class="kafelek__domena">{domena}</span>}
      <span class="tylko-czytnik"> {nowaKarta}</span>
    </span>
  </a>

  {/* Osobna karta (D17): ramka i jaśniejsze tło odcinają oficjalny pomiar Google od naszego opisu realizacji.
      Ikona prędkościomierza to własny rysunek, NIE logo Google (WSPOLNE §IV). */}
  <div class="pomiar" role="group" aria-labelledby={idPomiaru}>
    <p class="pomiar__naglowek" id={idPomiaru}>
      <svg class="pomiar__ikona" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.2 17.5a9 9 0 1 1 15.6 0" /><path d="M12 13.5l4-5" /><circle cx="12" cy="14" r="1.6" /><path d="M6.6 9.2l1 .8M12 5.6v1.3M17.4 9.2l-1 .8" /></svg>
      Oficjalny pomiar Google PageSpeed Insights
    </p>
    <p class="pomiar__zrodlo">
      Pomiar wykonany narzędziem Google, nie naszym; wynik sprawdzisz sam.
      <span class="pomiar__linki">
        <a href={adresPsi} target="_blank" rel="noopener">
          Sprawdź sam<span class="tylko-czytnik"> wyniki {domena || nazwa} w PageSpeed Insights {nowaKarta}</span>
        </a>
        <a href="/jak-sprawdzic-szybkosc-strony/">Jak czytać wynik<span aria-hidden="true"> →</span></a>
      </span>
    </p>
    {
      jestPomiar ? (
        <table class="pomiar__tabela">
          <caption class="pomiar__tytul">Wyniki w skali 0–100</caption>
          <thead>
            <tr>
              <th scope="col" class="pomiar__rog"><span class="tylko-czytnik">Kategoria</span></th>
              <th scope="col">Telefon</th>
              <th scope="col">Komputer</th>
            </tr>
          </thead>
          <tbody>
            {KATEGORIE.map(({ klucz, nazwa: kategoria }) => (
              <tr>
                <th scope="row">{kategoria}</th>
                {[p?.mobile, p?.desktop].map((w) => {
                  const wynik = w?.[klucz];
                  const agent = klucz === 'przegladanieAgentowe' && w?.agentoweWszystkie;
                  return (
                    <td>
                      {typeof wynik === 'number' ? (
                        <span class={`pastylka ${klasaWyniku(wynik)}`}>{wynik}</span>
                      ) : (
                        <span class="pomiar__brak">w toku</span>
                      )}
                      {agent && typeof wynik === 'number' && (
                        <span class="pomiar__ulamek">
                          <span class="tylko-czytnik">testów zdanych: </span>
                          {w?.agentoweZdane}/{w?.agentoweWszystkie}
                        </span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="pomiar__tytul">Pomiar w toku.</p>
      )
    }
    {
      jestPomiar && (
        <p class="pomiar__nota">
          {dataPomiaru && <>Pomiar z {dataPomiaru}. </>}
          {terenZdanie}
        </p>
      )
    }
  </div>
</div>

<style>
  /* Karta WYPEŁNIONA, bez obwódki — granicę niesie tło, nie kreska. Powód nie jest
     estetyczny: hairline na jasnym tle nie dobija do progu 3:1 dla elementu
     nietekstowego (patrz motyw.css). Wypełnienie tego problemu nie ma, bo nie pełni
     roli granicy niosącej znaczenie — treść kafelka jest tekstem, zmierzonym osobno. */
  /* Bez overflow: hidden na karcie — przycinałby obrys fokusu linku w środku; zaokrąglenie
     góry niesie sam obszar obrazka. */
  .kafelek {
    /* Kontener zapytań: blok pomiaru zwęża się według szerokości KARTY, nie okna (D17). */
    container: kafelek / inline-size;
    display: flex;
    flex-direction: column;
    background: var(--powierzchnia);
    border-radius: var(--promien);
    height: 100%;
  }

  .kafelek__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: var(--promien) var(--promien) 0 0;
    text-decoration: none;
    color: var(--tekst);
    transition: background-color 160ms ease;
  }

  /* Komplet stanów: spoczynek (wyżej), najechanie, aktywny, fokus (globalny
     :focus-visible w motywie). Stanu „wyłączony” ten element nie ma — kafelek
     albo istnieje, albo jest ukryty polem `ukryty` w panelu. */
  .kafelek__link:hover {
    background: var(--powierzchnia-mocna);
    text-decoration: none;
  }

  .kafelek__link:hover .kafelek__nazwa {
    color: var(--akcent);
  }

  .kafelek__link:active {
    opacity: 0.85;
  }

  .kafelek__obraz {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 16:10 = proporcja zrzutu 1440×900; inne obrazki przycina `cover`. */
    aspect-ratio: 16 / 10;
    background: var(--powierzchnia-mocna);
    border-radius: var(--promien) var(--promien) 0 0;
    overflow: hidden;
  }

  .kafelek__obraz :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Zastępnik zdjęcia: inicjały w kroju nagłówkowym, na wyraźnie ciemniejszym
     wypełnieniu niż reszta karty — to samodzielny, dopracowany element (odznaka
     z monogramem), a nie „dziura po brakującym pliku”. Świadomie BEZ podpisu
     „grafika do uzupełnienia": to była notatka redakcyjna, nie treść dla gościa
     strony — w panelu redaktor i tak widzi puste pole „Obrazek kafelka”. */
  .kafelek__zastepnik {
    font-family: var(--font-display);
    font-size: var(--t-xxl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--tekst-cichy);
  }

  .kafelek__stopka {
    display: flex;
    flex-direction: column;
    gap: var(--o-1);
    flex: 1;
    padding: var(--o-4) var(--o-4) var(--o-6);
  }

  .kafelek__nazwa {
    font-family: var(--font-display);
    font-size: var(--t-l);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 160ms ease;
  }

  .kafelek__opis {
    font-size: var(--t-s);
    color: var(--tekst-cichy);
    line-height: 1.5;
  }

  .kafelek__zakres {
    margin-top: var(--o-2);
    padding-top: var(--o-2);
    border-top: 1px solid var(--linia);
    font-size: var(--t-s);
    color: var(--tekst);
    line-height: 1.5;
  }

  .kafelek__domena {
    margin-top: var(--o-2);
    font-size: var(--t-xs);
    color: var(--tekst-cichy);
  }

  /* ── Wyniki PageSpeed Insights ──────────────────────────────────────────────────────────────
     Tabela semantyczna: wiersz = kategoria (pełna nazwa — pięć nazw w kolumnach nie mieści się
     w karcie 340–390 px), kolumny Telefon i Komputer. Pary kolorów zmierzone (WCAG):
     #f4f5f1 na #166653 6,27:1 (pastylka „dobry”), #15201a na #e8eae2 13,8:1, #4b5a4f na #e8eae2
     6,02:1, #166653 na #e8eae2 5,65:1 (link, obrys pastylki „poniżej 90”). Od 2026-10-27 (D17) blok stoi
     na --pomiar-tlo = #f4f5f1: #15201a 15,3:1, #4b5a4f 6,67:1, #166653 6,27:1 (link, ikona, obrys pastylki).
     Obrys karty #c7ccc0 jest ozdobą (1,35:1 do kafelka) — granicę niesie też różnica tła, nie tylko kreska. */
  /* Karta w karcie: margines od krawędzi kafelka, obrys 1 px i tło o stopień jaśniejsze (tokeny --pomiar-*
     w motyw.css). Wszystkie teksty bloku stoją na #f4f5f1 — pary policzone niżej i w motyw.css. */
  .pomiar {
    margin: 0 var(--o-3) var(--o-3);
    padding: var(--o-3) var(--o-4) var(--o-4);
    background: var(--pomiar-tlo);
    border: 1px solid var(--pomiar-obrys);
    border-radius: var(--promien-maly);
    font-size: var(--t-xs);
    line-height: 1.4;
  }

  .pomiar__naglowek {
    display: flex;
    align-items: center;
    gap: var(--o-2);
    margin: 0;
    font-size: var(--t-s);
    font-weight: 600;
    line-height: 1.3;
    color: var(--tekst);
  }

  .pomiar__ikona {
    flex: 0 0 auto;
    color: var(--akcent);
  }

  .pomiar__zrodlo {
    margin: var(--o-1) 0 var(--o-3);
    padding-bottom: var(--o-3);
    border-bottom: 1px solid var(--pomiar-obrys);
    color: var(--tekst-cichy);
  }

  /* Dwa linki w jednym wierszu, cel dotyku 24 px wysokości (WCAG 2.5.8). */
  .pomiar__linki {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--o-4);
    margin-top: var(--o-1);
  }

  .pomiar__linki a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-weight: 600;
  }

  .pomiar__tabela {
    width: 100%;
    border-collapse: collapse;
  }

  .pomiar__tytul {
    margin: 0 0 var(--o-2);
    text-align: left;
    font-weight: 600;
    color: var(--tekst);
  }

  .pomiar__tabela th,
  .pomiar__tabela td {
    padding: 0.1875rem 0;
    text-align: left;
    vertical-align: middle;
  }

  .pomiar__tabela thead th {
    font-weight: 600;
    color: var(--tekst-cichy);
    padding-bottom: var(--o-1);
  }

  .pomiar__tabela tbody th {
    font-weight: 400;
    color: var(--tekst);
    padding-right: var(--o-2);
  }

  /* Kolumny wyników dopasowane do treści (width: 1% + nowrap), resztę szerokości bierze nazwa kategorii. */
  .pomiar__tabela thead th,
  .pomiar__tabela td {
    width: 1%;
    white-space: nowrap;
    padding-left: var(--o-3);
  }

  .pomiar__tabela thead .pomiar__rog {
    width: auto;
    padding-left: 0;
  }

  .pastylka {
    display: inline-block;
    min-width: 2.5rem;
    padding: 0.0625rem var(--o-2);
    border-radius: 999px;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .pastylka--dobry {
    background: var(--akcent);
    color: var(--tlo);
  }

  .pastylka--ponizej {
    border: 1px solid var(--akcent);
    color: var(--tekst);
  }

  .pomiar__ulamek {
    margin-left: var(--o-1);
    color: var(--tekst-cichy);
    font-variant-numeric: tabular-nums;
  }

  .pomiar__brak {
    color: var(--tekst-cichy);
  }

  .pomiar__nota {
    margin: var(--o-2) 0 0;
    color: var(--tekst-cichy);
  }

  .kafelek__koniec-nazwy {
    white-space: nowrap;
  }

  /* Znak „otwiera się w nowej karcie” przy nazwie strony klienta — sam kształt, słowo niesie czytnik. */
  .kafelek__wyjscie {
    display: inline-block;
    margin-left: 0.3em;
    vertical-align: 0.05em;
    color: var(--tekst-cichy);
  }

  .kafelek__link:hover .kafelek__wyjscie {
    color: var(--akcent);
  }

  /* Wąska karta (trzy w rzędzie przy 768–960 px, dwie przy 576–640 px): tabela potrzebuje 235 px, a karta
     z marginesami bloku dawała 166–230 px (zmierzone CDP 2026-10-27; przy 768 px tabela wystawała poza okno
     o 16 px). Mniejsze marginesy, ułamek testów pod pastylką, nazwa kategorii może złamać wyraz. */
  @container kafelek (max-width: 20rem) {
    .pomiar {
      margin: 0 var(--o-2) var(--o-2);
      padding: var(--o-3) var(--o-2);
    }

    .pomiar__tabela thead th,
    .pomiar__tabela td {
      padding-left: var(--o-1);
    }

    .pomiar__tabela td {
      white-space: normal;
    }

    .pomiar__tabela tbody th {
      overflow-wrap: anywhere;
      padding-right: var(--o-1);
    }

    .pastylka {
      min-width: 2.25rem;
      padding-inline: var(--o-1);
    }

    .pomiar__ulamek {
      display: block;
      margin-left: 0;
    }
  }

  .tylko-czytnik {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
