---
// Lejek: 3–4 paski o malejącej szerokości (100/80/60 %), wyśrodkowane, z podpisem w pasku. Bez JS.
// Najwęższy pasek ma co najmniej 60 % szerokości, żeby tekst mieścił się na 390 px.
interface Props {
  tytul: string;
  progi: { nazwa: string; opis?: string }[];
}
const { tytul, progi } = Astro.props;
---

<figure class="lejek">
  <figcaption class="lejek__tytul">{tytul}</figcaption>
  <ol class="lejek__progi">
    {
      progi.slice(0, 4).map((p) => (
        <li class="lejek__prog">
          <span class="lejek__nazwa">{p.nazwa}</span>
          {p.opis && <span class="lejek__opis">{p.opis}</span>}
        </li>
      ))
    }
  </ol>
</figure>

<!-- Style globalne z prefiksem klasy: ten sam HTML pisany ręcznie w Markdownie wpisu dostaje ten wygląd. -->
<style is:global>
  /* Selektory z nazwą znacznika: w treści wpisu wygrywają z regułami prozy (figure, figcaption, ol, li + li). */
  figure.lejek {
    margin: var(--o-8) 0 var(--o-12);
    font-family: var(--font-sans);
  }

  figure.lejek > figcaption.lejek__tytul {
    margin: 0 0 var(--o-3);
    color: var(--tekst);
    font-size: var(--t-s);
    font-weight: 700;
    text-align: center;
  }

  figure.lejek > ol.lejek__progi {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--o-2);
  }

  /* kontrast: #15201a na #e8eae2 = 14,6:1; #f4f5f1 na #166653 = 6,27:1; #f4f5f1 na #10231b = 15,0:1 */
  /* szerokości 100/80/60/60 % */
  ol.lejek__progi > li.lejek__prog {
    font-family: var(--font-sans);
    width: 60%;
    margin: 0;
    padding: var(--o-3) var(--o-4);
    border-radius: var(--promien);
    text-align: center;
    line-height: 1.3;
  }

  ol.lejek__progi > li.lejek__prog:nth-child(1) {
    width: 100%;
    background: var(--powierzchnia);
    border: 2px solid var(--akcent-jasny, #1f8a6c);
    color: var(--tekst);
  }

  ol.lejek__progi > li.lejek__prog:nth-child(2) {
    width: 80%;
    background: var(--akcent);
    color: var(--tlo);
  }

  ol.lejek__progi > li.lejek__prog:nth-child(n + 3) {
    background: var(--tlo-ciemne, #10231b);
    color: var(--na-ciemnym, #f4f5f1);
  }

  .lejek__nazwa {
    display: block;
    font-weight: 700;
  }

  .lejek__opis {
    display: block;
    font-size: var(--t-s);
  }
</style>
