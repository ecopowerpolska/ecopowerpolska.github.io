---
// Oferta.astro — sekcje oferty z src/data/oferta.json (faza 2, 2026-11-06). Sekcja bez tła i szerokości:
// pas (tło, 76 rem, wyśrodkowanie) daje strona, która ją wstawia (.pas/.pas__tresc z motyw.css).
// `uslugi`: etykieta + H2-teza, 4 klikalne karty usług z ceną „od” (cena.json) i lista pozostałych pozycji `zakres`.
// `proces`: 6 kroków 01–06, każdy 1 zdanie + „co robisz Ty”, link do opisu krok po kroku.
// `dostajesz` i `technologia`: zdjęte ze strony głównej (decyzja 7), zostają do użycia na stronie usługi.
// `kontakt`: dane spółki z firma.json (skrót). Pole `zakres` zostaje nietknięte — czyta je DaneStrukturalne.
// Zero JS. Każdy napis przez tekst(): wyczyszczone pole w panelu wraca do domyślnego.
import ofertaJson from '../data/oferta.json';
import firma from '../data/firma.json';
import cenaJson from '../data/cena.json';
import { tekst } from '../lib/tekst';

interface Props {
  czesc: 'uslugi' | 'proces' | 'dostajesz' | 'technologia' | 'kontakt';
}

const { czesc } = Astro.props;

interface Pozycja {
  nazwa?: string | null;
  opis?: string | null;
  link?: string | null;
  cena?: string | null;
  krotko?: string | null;
  ty?: string | null;
}

const o = ofertaJson as Record<string, unknown>;
const napis = (klucz: string, domyslny: string) => tekst(o[klucz] as string | null | undefined, domyslny);
const s = (v: unknown) => (typeof v === 'string' ? v.trim() : '');

// Lista z panelu bywa pusta albo ma wpis bez nazwy — taki wpis się nie pokazuje.
const pozycje = (klucz: string) =>
  (Array.isArray(o[klucz]) ? (o[klucz] as Pozycja[]) : [])
    .map((p) => ({
      nazwa: s(p?.nazwa),
      opis: s(p?.opis),
      link: s(p?.link),
      cena: s(p?.cena),
      krotko: s(p?.krotko),
      ty: s(p?.ty),
    }))
    .filter((p) => p.nazwa !== '');

// Cena „od” po nazwie pozycji z cena.json (ta sama zasada co {od: …} w tekstach usług).
const cennik = Object.values(cenaJson as Record<string, unknown>)
  .filter(Array.isArray)
  .flat() as { pozycja?: string; cena?: string; jednostka?: string }[];
const cenaOd = (pozycja: string) => {
  const p = cennik.find((c) => s(c?.pozycja) === pozycja);
  if (!p || !/\d/.test(s(p.cena))) return '';
  // Pozycja z jednostką (np. „miesięcznie”) to stała stawka, nie cena „od”.
  return s(p.jednostka) ? `${s(p.cena)} netto ${s(p.jednostka)}` : `od ${s(p.cena)} netto`;
};

const uslugi = pozycje('uslugi').map((u) => ({ ...u, cenaTekst: u.cena ? cenaOd(u.cena) : '' }));
// Pozostałe pozycje `zakres`: bez tych, które mają już kartę (ten sam adres i nazwa zbieżna z kartą).
const nazwyKart = new Set(['strony firmowe', 'sklepy internetowe']);
const inne = pozycje('zakres').filter((p) => !nazwyKart.has(p.nazwa.toLowerCase()));
const proces = pozycje('proces');
const technologia = pozycje('technologia');
const technologiaInne = pozycje('technologiaInne');
const dostajesz = (Array.isArray(o.dostajesz) ? (o.dostajesz as unknown[]) : []).map(s).filter(Boolean);

const mail = firma.email.toLowerCase();
const telefonCyfry = firma.telefon.replace(/\D/g, '');
const telefonTrojki = telefonCyfry.replace(/(\d{3})(?=\d)/g, '$1 ');
const adres = [firma.adresSiedziby, [firma.kodPocztowy, firma.miejscowosc].filter(Boolean).join(' ')]
  .filter(Boolean)
  .join(', ');
const numer = (i: number) => String(i + 1).padStart(2, '0');
---

{czesc === 'uslugi' && uslugi.length > 0 && (
  <section id="oferta" class="sekcja" aria-labelledby="oferta-naglowek" data-ujawnij>
    <span class="etykieta etykieta--srodek">{napis('uslugiEtykieta', 'Oferta')}</span>
    <h2 id="oferta-naglowek" class="sekcja__naglowek">{napis('uslugiNaglowek', 'Od pustej domeny do strony, którą zmieniasz sam.')}</h2>
    <ul class="siatka-3 uslugi">
      {uslugi.map((u) => (
        <li class="karta karta--link usluga">
          <h3 class="usluga__nazwa">
            {u.link ? <a href={u.link}>{u.nazwa}</a> : u.nazwa}
          </h3>
          {u.opis && <p class="usluga__opis">{u.opis}</p>}
          <p class="usluga__stopka">
            {u.cenaTekst && <span class="usluga__cena">{u.cenaTekst}</span>}
            {u.link && <span class="usluga__strzalka" aria-hidden="true">→</span>}
          </p>
        </li>
      ))}
    </ul>
    {inne.length > 0 && (
      <p class="inne">
        <span class="inne__etykieta">{napis('uslugiInneNaglowek', 'Robimy też')}:</span>{' '}
        {inne.map((p, i) => (
          <>
            {p.link ? <a href={p.link}>{p.nazwa}</a> : p.nazwa}
            {i < inne.length - 1 && <span class="inne__kropka" aria-hidden="true"> · </span>}
          </>
        ))}
      </p>
    )}
  </section>
)}

{czesc === 'proces' && proces.length > 0 && (
  <section id="jak-pracujemy" class="sekcja" aria-labelledby="proces-naglowek" data-ujawnij>
    <span class="etykieta etykieta--srodek">{napis('procesEtykieta', 'Proces')}</span>
    <h2 id="proces-naglowek" class="sekcja__naglowek">{napis('procesNaglowek', 'Jak pracujemy')}</h2>
    {/* Lista numerowana, bo to kolejne kroki; widoczny numer 01–06 jest ozdobą (aria-hidden), numer niesie <ol>. */}
    <ol class="siatka-3 proces">
      {proces.map((p, i) => (
        <li class="krok">
          <span class="numer-kroku" aria-hidden="true">{numer(i)}</span>
          <h3 class="krok__nazwa">{p.nazwa}</h3>
          <p class="krok__opis">{p.krotko || p.opis}</p>
          {p.ty && (
            <p class="krok__ty">
              <span class="krok__ty-etykieta">{napis('procesTy', 'Ty')}:</span> {p.ty}
            </p>
          )}
        </li>
      ))}
    </ol>
    <p class="sekcja__dalej">
      <a href={napis('procesLinkAdres', '/strony-internetowe-warszawa/#krok-po-kroku')}>
        {napis('procesLink', 'Szczegóły krok po kroku')}<span aria-hidden="true"> →</span>
      </a>
    </p>
  </section>
)}

{czesc === 'dostajesz' && dostajesz.length > 0 && (
  <section id="co-dostajesz" class="sekcja" aria-labelledby="dostajesz-naglowek">
    <h2 id="dostajesz-naglowek" class="sekcja__naglowek">{napis('dostajeszNaglowek', 'Co dostajesz')}</h2>
    <ul class="siatka-3 dostajesz">
      {dostajesz.map((t) => <li>{t}</li>)}
    </ul>
  </section>
)}

{czesc === 'technologia' && (technologia.length > 0 || technologiaInne.length > 0) && (
  <section id="astro-i-hosting" class="sekcja" aria-labelledby="technologia-naglowek">
    <h2 id="technologia-naglowek" class="sekcja__naglowek">{napis('technologiaNaglowek', 'Dlaczego Astro i jaki hosting')}</h2>
    {s(o.technologiaLead) && <p class="sekcja__lead">{s(o.technologiaLead)}</p>}
    <div class="technologia">
      {[
        { naglowek: napis('technologiaKolumnaProponujemy', 'Proponujemy'), lista: technologia },
        { naglowek: napis('technologiaKolumnaInne', 'Wykonamy też'), lista: technologiaInne },
      ]
        .filter((k) => k.lista.length > 0)
        .map((k) => (
          <div class="karta technologia__kolumna">
            <h3>{k.naglowek}</h3>
            <dl>
              {k.lista.map((p) => (
                <>
                  <dt translate="no">{p.nazwa}</dt>
                  <dd>{p.opis}</dd>
                </>
              ))}
            </dl>
          </div>
        ))}
    </div>
  </section>
)}

{czesc === 'kontakt' && (
  <section id="kontakt" class="sekcja kontakt" aria-labelledby="kontakt-naglowek">
    <h2 id="kontakt-naglowek" class="kontakt__naglowek">{napis('kontaktNaglowek', 'Kontakt')}</h2>
    <ul class="kontakt__dane">
      <li><a href={`mailto:${mail}`}>{mail}</a></li>
      {telefonCyfry && (
        <li><a href={`tel:+48${telefonCyfry}`}>{telefonTrojki}</a></li>
      )}
      {adres && (
        <li>{napis('kontaktSiedziba', 'Siedziba spółki')}: {adres}</li>
      )}
    </ul>
  </section>
)}

<style>
  .sekcja {
    scroll-margin-top: var(--o-8);
  }

  /* H2 nad siatką na środku (reguła Piotra); rozmiar --t-h2 z motyw.css. */
  .etykieta--srodek {
    text-align: center;
  }

  .sekcja__naglowek {
    max-width: 24ch;
    margin: 0 auto var(--o-8);
    text-align: center;
  }

  .sekcja__lead {
    max-width: 44rem;
    margin: calc(-1 * var(--o-4)) auto var(--o-8);
    text-align: center;
  }

  .sekcja__dalej {
    margin: var(--o-8) 0 0;
    text-align: center;
  }

  .sekcja__dalej a,
  .inne a {
    font-weight: 600;
  }

  .sekcja__dalej a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cel-dotyku);
  }

  /* ── Karty usług: cała karta klikalna (::after odnośnika), korzyść w zdaniu, cena „od” z cennika. ── */
  .usluga {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--o-2);
    padding: var(--o-6);
  }

  .usluga__nazwa {
    font-size: var(--t-l);
  }

  .usluga__nazwa a {
    color: var(--tekst);
    text-decoration: none;
  }

  .usluga__nazwa a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--promien-karty);
  }

  .usluga__nazwa a:focus-visible {
    outline: none;
  }

  .usluga__nazwa a:focus-visible::after {
    outline: 2px solid var(--akcent);
    outline-offset: 3px;
  }

  .usluga__opis {
    margin: 0;
    flex: 1;
  }

  .usluga__stopka {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--o-3);
    margin: var(--o-2) 0 0;
    font-weight: 600;
    color: var(--akcent);
  }

  .usluga__strzalka {
    margin-left: auto;
    font-size: var(--t-l);
    line-height: 1;
  }

  /* Siatka 4 kart przy 3 kolumnach: 3 + 1, niepełny rząd do lewej (siatka-3). */

  /* Pozostałe pozycje: jeden akapit z kropkami, linki podkreślone (tekst w bloku). */
  .inne {
    max-width: 56rem;
    margin: var(--o-8) auto 0;
    text-align: center;
    line-height: 1.9;
  }

  .inne__etykieta {
    font-weight: 600;
  }

  .inne a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .inne__kropka {
    color: var(--tekst-cichy);
  }

  /* ── Proces: numer 01–06 nad tytułem, bez pudełek, kreska u góry. ── */
  .proces {
    counter-reset: none;
    gap: var(--o-8) var(--o-6);
  }

  .krok {
    padding-top: var(--o-4);
    border-top: 2px solid var(--linia);
  }

  .krok__nazwa {
    margin-top: var(--o-3);
  }

  .krok__opis,
  .krok__ty {
    margin: var(--o-2) 0 0;
  }

  .krok__ty {
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  .krok__ty-etykieta {
    font-weight: 700;
    color: var(--akcent);
  }

  /* ── Co dostajesz / technologia (strona usługi) ── */
  .dostajesz li {
    padding-left: var(--o-6);
    position: relative;
  }

  .dostajesz li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--akcent);
    font-weight: 700;
  }

  .technologia {
    display: grid;
    gap: var(--o-6);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .technologia {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .technologia__kolumna {
    padding: var(--o-6);
  }

  .technologia dt {
    font-weight: 600;
    margin-top: var(--o-4);
  }

  .technologia dd {
    margin: 0;
  }

  /* ── Kontakt: same dane spółki, wyśrodkowane. ── */
  .kontakt {
    text-align: center;
  }

  .kontakt__naglowek {
    font-size: var(--t-xl);
    margin-bottom: var(--o-4);
  }

  .kontakt__dane {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--o-2) var(--o-8);
  }

  .kontakt__dane a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cel-dotyku);
    font-weight: 600;
    /* Adres e-mail to jedno długie słowo — przy 320 px musi móc się złamać (WCAG 1.4.10). */
    overflow-wrap: anywhere;
  }

  .kontakt__dane li {
    display: flex;
    align-items: center;
    min-height: var(--cel-dotyku);
  }
</style>
