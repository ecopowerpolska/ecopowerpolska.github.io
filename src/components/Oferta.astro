---
// Oferta.astro — sekcje oferty firmy z src/data/oferta.json (2026-10-23).
// `czesc="oferta"`: czym się zajmujemy, jak pracujemy, co dostajesz, dlaczego Astro i hosting.
// `czesc="kontakt"`: kontakt mailem i telefonem plus adres siedziby z firma.json (odpis KRS).
// Układ wyśrodkowany (D22, 2026-10-30): nagłówki, wstępy i kontakt na środku, siatki na pełną szerokość kontenera.
// Runda 7 (2026-10-30): „Jak pracujemy” i „Co dostajesz” to te same kafelki (3 w rzędzie, 4 przy czterech krokach),
// „Dlaczego Astro i jaki hosting” to dwie kolumny „Proponujemy” | „Wykonamy też” na pełną szerokość. Kolory tylko z motyw.css.
// Zero JS. Każdy napis przez tekst(): wyczyszczone pole w panelu wraca do domyślnego.
// Runda 5 (2026-10-27): pozycja „Czym się zajmujemy” z polem `link` (adres strony usługi) jest klikalna
// w całości — odnośnik siedzi w <h3> (nazwa = tekst odnośnika), a jego ::after rozpięty na kafelek.
// Wygląd w spoczynku bez zmian; fokus = obrys kafelka, najechanie = podkreślona nazwa.
import ofertaJson from '../data/oferta.json';
import firma from '../data/firma.json';
import { tekst } from '../lib/tekst';

interface Props {
  czesc: 'oferta' | 'kontakt';
}

const { czesc } = Astro.props;

interface Pozycja {
  nazwa?: string | null;
  opis?: string | null;
  link?: string | null;
}

const o = ofertaJson as Record<string, unknown>;
const napis = (klucz: string, domyslny: string) => tekst(o[klucz] as string | null | undefined, domyslny);

// Lista z panelu bywa pusta albo ma wpis bez nazwy — taki wpis po prostu się nie pokazuje.
const pozycje = (klucz: string): { nazwa: string; opis: string; link: string }[] =>
  (Array.isArray(o[klucz]) ? (o[klucz] as Pozycja[]) : [])
    .map((p) => ({ nazwa: p?.nazwa?.trim() ?? '', opis: p?.opis?.trim() ?? '', link: p?.link?.trim() ?? '' }))
    .filter((p) => p.nazwa !== '');

const zakres = pozycje('zakres');
const proces = pozycje('proces');
const technologia = pozycje('technologia');
const technologiaInne = pozycje('technologiaInne');
const dostajesz = (Array.isArray(o.dostajesz) ? (o.dostajesz as unknown[]) : [])
  .map((t) => (typeof t === 'string' ? t.trim() : ''))
  .filter(Boolean);

const mail = firma.email.toLowerCase();
const telefonCyfry = firma.telefon.replace(/\D/g, '');
const telefonTrojki = telefonCyfry.replace(/(\d{3})(?=\d)/g, '$1 ');
const adres = [firma.adresSiedziby, [firma.kodPocztowy, firma.miejscowosc].filter(Boolean).join(' ')]
  .filter(Boolean)
  .join(', ');
---

{
  czesc === 'oferta' ? (
    <>
      {zakres.length > 0 && (
        <section id="oferta" class="sekcja" aria-labelledby="oferta-naglowek" data-ujawnij>
          <h2 id="oferta-naglowek" class="sekcja__naglowek">{napis('zakresNaglowek', 'Czym się zajmujemy')}</h2>
          {o.zakresLead && <p class="sekcja__lead">{String(o.zakresLead)}</p>}
          <ul class="zakres">
            {zakres.map((p) => (
              <li class:list={[{ 'zakres__kafel': p.link }]}>
                <h3>{p.link ? <a class="zakres__link" href={p.link}>{p.nazwa}</a> : p.nazwa}</h3>
                {p.opis && <p>{p.opis}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {proces.length > 0 && (
        <section id="jak-pracujemy" class="sekcja" aria-labelledby="proces-naglowek" data-ujawnij>
          <h2 id="proces-naglowek" class="sekcja__naglowek">{napis('procesNaglowek', 'Jak pracujemy')}</h2>
          {/* Lista numerowana, bo to kolejne kroki (numer niesie <ol>, nie ozdoba). */}
          <ol class="kafle proces">
            {proces.map((p) => (
              <li>
                <h3>{p.nazwa}</h3>
                {p.opis && <p>{p.opis}</p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {dostajesz.length > 0 && (
        <section id="co-dostajesz" class="sekcja" aria-labelledby="dostajesz-naglowek" data-ujawnij>
          <h2 id="dostajesz-naglowek" class="sekcja__naglowek">{napis('dostajeszNaglowek', 'Co dostajesz')}</h2>
          <ul class="kafle dostajesz">
            {dostajesz.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )}

      {(technologia.length > 0 || technologiaInne.length > 0) && (
        <section id="astro-i-hosting" class="sekcja" aria-labelledby="technologia-naglowek" data-ujawnij>
          <h2 id="technologia-naglowek" class="sekcja__naglowek">
            {napis('technologiaNaglowek', 'Dlaczego Astro i jaki hosting')}
          </h2>
          {o.technologiaLead && <p class="sekcja__lead">{String(o.technologiaLead)}</p>}
          <div class="technologia">
            {technologia.length > 0 && (
              <div class="technologia__kolumna">
                <h3>{napis('technologiaKolumnaProponujemy', 'Proponujemy')}</h3>
                <dl>
                  {technologia.map((p) => (
                    <>
                      <dt translate="no">{p.nazwa}</dt>
                      <dd>{p.opis}</dd>
                    </>
                  ))}
                </dl>
              </div>
            )}
            {technologiaInne.length > 0 && (
              <div class="technologia__kolumna">
                <h3>{napis('technologiaKolumnaInne', 'Wykonamy też')}</h3>
                <dl>
                  {technologiaInne.map((p) => (
                    <>
                      <dt translate="no">{p.nazwa}</dt>
                      <dd>{p.opis}</dd>
                    </>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </section>
      )}
    </>
  ) : (
    <section id="kontakt" class="sekcja kontakt" aria-labelledby="kontakt-naglowek" data-ujawnij>
      <h2 id="kontakt-naglowek" class="sekcja__naglowek">{napis('kontaktNaglowek', 'Kontakt')}</h2>
      <p class="sekcja__lead">
        {napis(
          'kontaktTekst',
          'Napisz, jaki adres ma mieć strona, co ma robić i czy masz już domenę, teksty i zdjęcia.',
        )}
      </p>
      <ul class="kontakt__drogi">
        <li>
          <a class="kontakt__link" href={`mailto:${mail}`}>{napis('kontaktMail', `Napisz: ${mail}`)}</a>
        </li>
        {telefonCyfry && (
          <li>
            <a class="kontakt__link" href={`tel:+48${telefonCyfry}`}>
              {napis('kontaktTelefon', `Zadzwoń: ${telefonTrojki}`)}
            </a>
          </li>
        )}
      </ul>
      {adres && (
        <p class="kontakt__adres">
          {napis('kontaktSiedziba', 'Siedziba spółki')}: {adres}
        </p>
      )}
    </section>
  )
}

<style>
  .sekcja {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: var(--o-12) var(--o-6);
    border-top: 1px solid var(--linia);
  }

  .sekcja__naglowek {
    font-size: var(--t-xl);
    margin-bottom: var(--o-6);
    text-align: center;
  }

  .sekcja__lead {
    max-width: 44rem;
    margin: calc(-1 * var(--o-3)) auto var(--o-8);
    text-align: center;
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  h3 {
    font-size: var(--t-l);
    margin-bottom: var(--o-2);
  }

  li p,
  dd {
    margin: 0;
    max-width: var(--miara);
    color: var(--tekst-cichy);
    line-height: 1.55;
  }

  /* Zakres: siatka 1/2/3 kolumny, każda pozycja otwarta kreską u góry — bez kart i cieni. */
  .zakres {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .zakres {
    display: grid;
    gap: var(--o-8) var(--o-8);
    grid-template-columns: 1fr;
  }

  .zakres li {
    padding-top: var(--o-4);
    border-top: 2px solid var(--akcent);
  }

  /* Kafelek z odnośnikiem: cały klikalny (::after odnośnika rozpięty na <li>). */
  .zakres__kafel {
    position: relative;
  }

  .zakres__link {
    color: inherit;
    text-decoration: none;
  }

  .zakres__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .zakres__kafel:hover .zakres__link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .zakres__link:focus-visible {
    outline: none;
  }

  .zakres__link:focus-visible::after {
    outline: 2px solid var(--akcent);
    outline-offset: 3px;
    border-radius: var(--promien-maly);
  }

  /* Dwie kolumny i nieparzysta liczba pozycji (9 = 2 + 2 + 2 + 2 + 1): trzy ostatnie
     w jednym rzędzie, bez pozycji samotnej (D14). Siatka 6 ścieżek, pozycja zajmuje 3 albo 2. */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .zakres {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .zakres li {
      grid-column: span 3;
    }

    .zakres:has(> li:nth-child(2n + 1):last-child) > li:nth-last-child(-n + 3) {
      grid-column: span 2;
    }
  }

  @media (min-width: 64rem) {
    .zakres {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Kafelki „Jak pracujemy” i „Co dostajesz”: jedna siatka, ten sam wygląd (powierzchnia, kreska akcentu u góry).
     Telefon 1 kolumna, 40–64rem 2, od 64rem 3; cztery kroki mieszczą się w 4 kolumnach. Ostatni rząd od lewej. */
  .kafle {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--o-6);
    grid-template-columns: minmax(0, 1fr);
  }

  .kafle li {
    padding: var(--o-6);
    background: var(--powierzchnia);
    border-top: 2px solid var(--akcent);
    border-radius: var(--promien);
    line-height: 1.5;
  }

  .kafle li p {
    max-width: none;
  }

  @media (min-width: 40rem) {
    .kafle {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .kafle {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proces:has(> li:nth-child(4):last-child) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Proces: prawdziwa sekwencja, więc numer z licznika <ol> nad tytułem kroku. */
  .proces {
    counter-reset: krok;
  }

  .proces li {
    counter-increment: krok;
  }

  .proces li::before {
    content: counter(krok);
    display: block;
    margin-bottom: var(--o-2);
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.1;
    color: var(--akcent);
    font-variant-numeric: tabular-nums;
  }

  .proces h3 {
    margin-bottom: var(--o-2);
  }

  /* „Co dostajesz”: krótka kreska akcentu zamiast numeru. */
  .dostajesz li::before {
    content: '';
    display: block;
    width: 1.5rem;
    height: 2px;
    margin-bottom: var(--o-3);
    background: var(--akcent);
  }

  /* Astro i hosting: dwie kolumny na pełną szerokość, na telefonie jedna pod drugą. */
  .technologia {
    display: grid;
    gap: var(--o-6);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .technologia {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .technologia__kolumna {
    padding: var(--o-6);
    background: var(--powierzchnia);
    border-top: 2px solid var(--akcent);
    border-radius: var(--promien);
  }

  .technologia__kolumna h3 {
    margin-bottom: var(--o-4);
  }

  .technologia__kolumna dl {
    margin: 0;
  }

  .technologia dd {
    max-width: none;
  }

  .technologia dt {
    font-weight: 600;
    margin-top: var(--o-4);
  }

  .technologia dt:first-child {
    margin-top: 0;
  }

  /* Kontakt: dwa odnośniki z obrysem — para akcent/tło z motyw.css, bez nowego koloru. */
  .kontakt__drogi {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--o-3) var(--o-4);
    justify-content: center;
  }

  .kontakt__link {
    /* spoczynek */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: var(--o-2) var(--o-4);
    border: 2px solid var(--akcent);
    border-radius: var(--promien);
    font-weight: 600;
    color: var(--akcent);
    text-decoration: none;
    /* Adres e-mail to jedno długie słowo — przy 320 px musi móc się złamać (WCAG 1.4.10). */
    overflow-wrap: anywhere;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  /* najechanie */
  .kontakt__link:hover {
    background: var(--powierzchnia);
    text-decoration: none;
  }

  /* aktywny (wciśnięty) */
  .kontakt__link:active {
    transform: translateY(1px);
  }

  .kontakt__adres {
    margin: var(--o-6) 0 0;
    text-align: center;
    color: var(--tekst-cichy);
  }

  @media (prefers-reduced-motion: reduce) {
    .kontakt__link {
      transition: none;
    }
  }
</style>
