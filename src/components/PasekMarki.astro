---
// PasekMarki.astro — górny pasek tożsamości: znak + nazwa spółki, opcjonalnie
// licznik serwisów. Współdzielony przez index.astro i 404.astro, żeby marka była
// widoczna wszędzie, nie tylko na trasie ze spisem serwisów — brief wprost wymaga,
// żeby nagłówek „powiedział w sekundę, czym jest EcoPower".
import { Image } from 'astro:assets';

import firma from '../data/firma.json';
import strona from '../data/strona.json';
import { tekst } from '../lib/tekst';
import logo from '../assets/logo-ecopower-polska.png';

interface Props {
  /** Liczba widocznych serwisów. Pomijana (brak licznika) przy undefined albo 0 —
   * strona nie ma zgadywać ani obiecywać liczby, której nie zna. */
  liczbaSerwisow?: number;
}

const { liczbaSerwisow } = Astro.props;

// Dopisek licznika z panelu („3 serwisy w sieci").
const napisLicznika = tekst(strona.napisLicznika, 'w sieci');

// Odmiana liczebnika: 1 serwis / 2–4 serwisy / 5+ serwisów (z wyjątkiem 12–14,
// które mimo końcówki 2–4 biorą formę „serwisów"). Zostaje w kodzie świadomie:
// to gramatyka polszczyzny, nie treść do redagowania w panelu.
function odmiana(n: number): string {
  if (n === 1) return 'serwis';
  const ostatnia = n % 10;
  const dziesiatki = n % 100;
  if (ostatnia >= 2 && ostatnia <= 4 && !(dziesiatki >= 12 && dziesiatki <= 14)) return 'serwisy';
  return 'serwisów';
}
---

<header class="pasek">
  <div class="pasek__srodek">
    {/* Pełne logo firmowe: kwadrat EP + napis ECOPOWER POLSKA. Wybór Piotra
        2026-09-07 — zastępuje rysowany w kodzie znak „E rejestrowe" (D5).
        Plik jest RASTREM: Piotr dostarczył PNG, wersji wektorowej nie ma nigdzie
        na dysku, a w systemie nie ma potrace ani autotrace. `<Image>` wyda z niego
        WebP w potrzebnych szerokościach; źródło 3142 px starcza na każdy ekran.
        `loading="eager"`, bo logo stoi nad foldem — ale BEZ `fetchpriority="high"`:
        ten należy do zdjęcia pierwszego kafelka, kandydata na LCP (CLAUDE.md §4). */}
    <div class="pasek__marka">
      <Image
        class="znak"
        src={logo}
        alt={firma.nazwaKrotka}
        width={180}
        densities={[1.5, 2]}
        loading="eager"
      />
    </div>
    {
      !!liczbaSerwisow && liczbaSerwisow > 0 && (
        <p class="pasek__licznik">
          {liczbaSerwisow} {odmiana(liczbaSerwisow)} {napisLicznika}
        </p>
      )
    }
  </div>
</header>

<style>
  /* Pełna szerokość kontenera, przyklejony, z kreską u dołu. Świadomie BEZ
     frosted-glass/blur z poprzedniej wersji (styl apple.com/pl) — płaska kreska
     pasuje do kierunku „rejestr", blur nie wnosił nic poza cytatem z cudzego
     interfejsu. */
  .pasek {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--tlo);
    border-bottom: 1px solid var(--linia);
  }

  .pasek__srodek {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: var(--o-3) var(--o-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--o-2) var(--o-6);
  }

  .pasek__marka {
    display: flex;
    align-items: center;
    gap: var(--o-3);
    min-width: 0;
  }

  /* Wysokość rządzi, szerokość idzie za proporcją — logo jest szerokie (5,6:1),
     więc wiązanie go szerokością rozjeżdżałoby pasek na wąskich ekranach.
     Atrybuty width/height z <Image> zostają w HTML-u i trzymają proporcję,
     więc podmiana na `auto` nie wprowadza przeskoku układu (CLS). */
  .znak {
    flex: 0 0 auto;
    height: 32px;
    width: auto;
    display: block;
  }

  @media (max-width: 26rem) {
    .znak {
      height: 26px;
    }
  }

  .pasek__licznik {
    margin: 0;
    font-size: var(--t-s);
    color: var(--tekst-cichy);
    white-space: nowrap;
  }
</style>
