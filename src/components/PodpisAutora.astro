---
// Podpis autora na końcu wpisu: zdjęcie 72 px w ramce (kwadrat, nie kółko), imię, jedno zdanie, link do strony autora.
// Dane: src/data/autor.json. Bez JS.
import { Image } from 'astro:assets';
import autor from '../data/autor.json';
import zdjecie from '../assets/blog/autor-piotr-czwarnowski.jpg';
import { tekst } from '../lib/tekst';
---

<aside class="podpis-autora" aria-label={`Autor: ${autor.imie}`}>
  <Image class="podpis-autora__zdjecie" src={zdjecie} alt="" width={72} height={72} densities={[1, 2]} loading="lazy" decoding="async" />
  <div>
    <p class="podpis-autora__imie">{autor.imie}</p>
    <p class="podpis-autora__zdanie">{tekst(autor.podpis, '')}</p>
    <a class="podpis-autora__link" href={autor.adres}>{tekst(autor.linkPodpisu, 'Więcej o autorze')}</a>
  </div>
</aside>

<style>
  .podpis-autora {
    display: flex;
    gap: var(--o-4);
    align-items: flex-start;
    margin: var(--o-12) 0 0;
    padding: var(--o-6);
    background: #fff;
    border: var(--obrys-karty, 1px solid var(--linia));
    border-radius: var(--promien-karty, var(--promien));
    box-shadow: var(--cien-karty, none);
  }

  .podpis-autora__zdjecie {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border: 1px solid var(--linia);
    border-radius: var(--promien);
  }

  .podpis-autora__imie {
    margin: 0;
    font-weight: 700;
  }

  .podpis-autora__zdanie {
    margin: var(--o-1) 0 var(--o-2);
    font-size: var(--t-s);
    line-height: 1.5;
  }

  .podpis-autora__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--akcent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .podpis-autora__link:hover {
    color: var(--tekst);
  }
</style>
