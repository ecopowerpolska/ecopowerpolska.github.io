---
// Podpis na końcu wpisu: „EcoPower Polska” i jedno zdanie w liczbie mnogiej. Bez zdjęcia, bez imienia i bez linku (decyzja Piotra 2026-11-06).
import firma from '../data/firma.json';
---

<aside class="podpis-autora" aria-label={`Autor: ${firma.nazwaKrotka}`}>
  <div>
    <p class="podpis-autora__imie">{firma.nazwaKrotka}</p>
    <p class="podpis-autora__zdanie">Budujemy strony i sklepy w Astro i każdą mierzymy w PageSpeed Insights po publikacji.</p>
  </div>
</aside>

<style>
  .podpis-autora {
    display: flex;
    gap: var(--o-4);
    align-items: flex-start;
    margin: var(--o-12) 0 0;
    padding: var(--o-6);
    background: #fff;
    border: var(--obrys-karty, 1px solid var(--linia));
    border-radius: var(--promien-karty, var(--promien));
    box-shadow: var(--cien-karty, none);
  }

  .podpis-autora__imie {
    margin: 0;
    font-weight: 700;
  }

  .podpis-autora__zdanie {
    margin: var(--o-1) 0 0;
    font-size: var(--t-s);
    line-height: 1.5;
  }
</style>
