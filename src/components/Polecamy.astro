---
// Polecamy.astro: blok pod wpisem bloga z dwiema kartami do witryn Piotra (Studio Agat, Pan Stolarz).
// Szablon powtarzany pod każdym wpisem, więc linki mają rel="nofollow" (skill linkowanie-zewnetrzne, reguła 1);
// ruch użytkownika idzie, sygnał SEO niosą linki w treści wpisów. Kolory i odstępy wyłącznie z tokenów motyw.css.
const karty = [
  {
    nazwa: 'Studio Agat',
    opis: 'projektowanie wnętrz i kuchnie na wymiar',
    adres: 'https://studioagat.pl/projektowanie-wnetrz',
  },
  {
    nazwa: 'Pan Stolarz',
    opis: 'meble, szafy i garderoby na wymiar',
    adres: 'https://pan-stolarz.pl/meble-na-wymiar',
  },
];
---

<aside class="polecamy" aria-labelledby="polecamy-tytul">
  <h2 id="polecamy-tytul" class="polecamy__tytul">Polecamy</h2>
  <ul class="polecamy__lista">
    {karty.map((k) => (
      <li>
        <a class="polecamy__karta" href={k.adres} rel="nofollow">
          <span class="polecamy__nazwa">{k.nazwa}</span>
          <span class="polecamy__opis">{k.opis}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .polecamy {
    max-width: 40rem;
    margin: var(--o-12) 0 0;
  }

  .polecamy__tytul {
    margin: 0 0 var(--o-4);
    font-size: var(--t-l);
  }

  .polecamy__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--o-4);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 42rem) {
    .polecamy__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .polecamy__karta {
    /* spoczynek */
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--o-1);
    height: 100%;
    min-height: 44px;
    padding: var(--o-4) var(--o-6);
    background: var(--powierzchnia);
    border: 1px solid var(--linia);
    border-radius: var(--promien);
    color: var(--tekst);
    text-decoration: none;
  }

  .polecamy__nazwa {
    font-weight: 600;
    color: var(--akcent);
  }

  .polecamy__opis {
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* najechanie */
  .polecamy__karta:hover {
    background: var(--powierzchnia-mocna);
  }

  .polecamy__karta:hover .polecamy__nazwa {
    color: var(--tekst);
  }

  /* aktywny (wciśnięty) */
  .polecamy__karta:active {
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .polecamy__karta:active {
      transform: none;
    }
  }
</style>
