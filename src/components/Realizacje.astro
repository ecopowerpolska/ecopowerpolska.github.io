---
// Realizacje.astro — sekcja „Realizacje” strony głównej: strony z src/data/serwisy.json (bez ukrytych),
// w kolejności z pliku (= kolejność przeciągania w panelu, D8). Zero JavaScriptu.
// Obrazki to zrzuty żywych stron 1440×900 (headless Chrome), więc kafel ma proporcję 16:10.
import { getCollection } from 'astro:content';
import Kafelek from './Kafelek.astro';
import { tekst } from '../lib/tekst';
import blog from '../data/blog.json';
// Wyniki PageSpeed Insights pod kafelkami — plik generowany skryptem scripts/psi-realizacje.py
// (docs/POMIARY.md), nie jest w panelu CMS. Klucz = `adres` z serwisy.json, dosłownie.
import pomiary from '../data/pomiary.json';

interface Props {
  /** Nagłówek H2 sekcji; puste = wartość domyślna. */
  naglowek?: string | null;
  /** Zdanie pod nagłówkiem; puste = bez akapitu. */
  wstep?: string | null;
  /** Kotwica sekcji (menu „Realizacje”). */
  kotwica?: string;
  /** true tylko gdy sekcja stoi nad zgięciem i pierwszy zrzut jest kandydatem na LCP. */
  pierwszyEager?: boolean;
}

const { naglowek, wstep, kotwica = 'realizacje', pierwszyEager = false } = Astro.props;

const realizacje = await getCollection('serwisy', ({ data }) => !data.ukryty);
const idNaglowka = `${kotwica}-naglowek`;
const wstepTekst = wstep?.trim() ?? '';
// Pole `zakres` dochodzi do schematu w content.config.ts; odczyt odporny na jego brak.
const zakresWpisu = (dane: unknown): string | undefined => (dane as { zakres?: string }).zakres;
const pomiarAdresu = (adres: string): unknown => (pomiary.pomiary as Record<string, unknown>)[adres];
---

{
  realizacje.length > 0 && (
    <section class="realizacje" id={kotwica} aria-labelledby={idNaglowka}>
      <h2 id={idNaglowka} class="realizacje__naglowek" data-ujawnij>
        {tekst(naglowek, 'Realizacje')}
      </h2>
      {wstepTekst && <p class="realizacje__wstep" data-ujawnij>{wstepTekst}</p>}
      <ul class="realizacje__siatka">
        {realizacje.map((wpis, i) => (
          <li data-ujawnij>
            <Kafelek
              nazwa={wpis.data.nazwa}
              adres={wpis.data.adres}
              opis={wpis.data.opis}
              zakres={zakresWpisu(wpis.data)}
              obrazek={wpis.data.obrazek}
              alt={wpis.data.alt}
              pierwszy={pierwszyEager && i === 0}
              pomiar={pomiarAdresu(wpis.data.adres)}
            />
          </li>
        ))}
      </ul>
      <p class="realizacje__pomiar" data-ujawnij>
        Wyniki pod zrzutami to pomiary PageSpeed Insights.{' '}
        <a href="/jak-sprawdzic-szybkosc-strony/">Sprawdź szybkość swojej strony tak samo</a>.
      </p>
      {/* Przycisk drugorzędny do zakładki Efekty (runda 4, 2026-10-27): dodatkowa część portfolio. */}
      <p class="realizacje__dalej" data-ujawnij>
        <a class="realizacje__przycisk" href="/efekty/">
          {tekst(blog.linkEfektyRealizacje, 'Zobacz efekty, które dodajemy do stron')}
        </a>
      </p>
    </section>
  )
}

<style>
  .realizacje {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: 0 var(--o-6) var(--o-16);
    scroll-margin-top: var(--o-8);
  }

  .realizacje__naglowek {
    font-size: var(--t-xl);
    margin-bottom: var(--o-4);
    text-align: center;
  }

  .realizacje__wstep {
    max-width: 44rem;
    margin: 0 auto var(--o-8);
    text-align: center;
    color: var(--tekst-cichy);
    line-height: 1.5;
  }

  /* 3 / 2 / 1 kolumny, kafle równej szerokości, bez kafla samotnego w rzędzie (D14).
     Siatka 6 ścieżek: kafel zajmuje 2 (trzy w rzędzie) albo 3 (dwa w rzędzie).
     Trzy w rzędzie i reszta 1 (7 = 3 + 3 + 1): cztery ostatnie kafle stają parami
     na środku (3 + 2 + 2), ten sam rozmiar. Dwa w rzędzie i reszta 1 (7 = 2 + 2 + 2 + 1):
     trzy ostatnie kafle w jednym rzędzie (2 + 2 + 3). */
  .realizacje__siatka {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--o-6);
  }

  .realizacje__siatka > li {
    min-width: 0;
  }

  .realizacje__pomiar {
    margin: var(--o-6) auto 0;
    max-width: 44rem;
    text-align: center;
  }

  .realizacje__pomiar a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .realizacje__dalej {
    margin: var(--o-8) 0 0;
    text-align: center;
  }

  /* Przycisk drugorzędny: obrys akcentu, bez wypełnienia (główny przycisk strony to „Zapytaj o stronę”).
     Pary: #166653 na #f4f5f1 6,27:1 (spoczynek), #15201a na #e8eae2 13,8:1 (najechanie). */
  .realizacje__przycisk {
    /* spoczynek */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cel-dotyku);
    padding: var(--o-2) var(--o-4);
    font-weight: 600;
    color: var(--akcent);
    border: 1px solid var(--akcent);
    border-radius: var(--promien-maly);
    text-decoration: none;
  }

  /* najechanie */
  .realizacje__przycisk:hover {
    color: var(--tekst);
    background: var(--powierzchnia);
    text-decoration: none;
  }

  /* aktywny (wciśnięty) */
  .realizacje__przycisk:active {
    background: var(--powierzchnia-mocna);
  }

  @media (min-width: 36rem) and (max-width: 59.99rem) {
    .realizacje__siatka {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .realizacje__siatka > li {
      grid-column: span 3;
    }

    .realizacje__siatka:has(> li:nth-child(2n + 1):last-child) > li:nth-last-child(-n + 3) {
      grid-column: span 2;
    }
  }

  @media (min-width: 60rem) {
    .realizacje__siatka {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .realizacje__siatka > li {
      grid-column: span 2;
    }

    .realizacje__siatka:has(> li:nth-child(3n + 1):last-child) > li:nth-last-child(4),
    .realizacje__siatka:has(> li:nth-child(3n + 1):last-child) > li:nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    .realizacje__siatka:has(> li:nth-child(3n + 1):last-child) > li:nth-last-child(3),
    .realizacje__siatka:has(> li:nth-child(3n + 1):last-child) > li:nth-last-child(1) {
      grid-column: 4 / span 2;
    }
  }
</style>
