---
// Realizacje.astro — sekcja „Realizacje” strony głównej: strony z src/data/serwisy.json (bez ukrytych),
// w kolejności z pliku (= kolejność przeciągania w panelu, D8). Zero JavaScriptu.
// Faza 2 (2026-11-06): karta .karta.karta--link z motyw.css; H3 = zdanie z wynikiem (`teza` + PSI telefonu),
// pod nim nazwa i adres, 2–3 tagi (`tagi`), wynik „Telefon · Komputer” widoczny bez rozwijania; <details> tylko na szczegóły.
// Zrzut w proporcji pliku (szerokość podana, wysokość z pliku). Pola `teza` i `tagi` czytane z surowego serwisy.json
// po adresie — schemat kolekcji ich nie zna (src/content.config.ts), a parser kolekcji pomija nieznane pola.
// Faza 3 (2026-11-06, słowa Piotra): to PRZYKŁADOWE realizacje, nigdy komplet — pokazujemy wpisy z `przyklad: true`
// (najwyżej 3; gdy żaden nie jest oznaczony, pierwsze trzy widoczne). Pozostałe zostają w serwisy.json i w pomiarach.
// Bez dat w tekście stałym: data pomiaru żyje wyłącznie w żywym wykresie (WykresPsi). Wpis bez pomiaru (nowa strona,
// przed pierwszym przebiegiem crona) pokazuje „pomiar w toku”, nie pustkę. Bez przycisku do usuniętej zakładki Efekty.
// Sekcja bez tła i szerokości: pas daje strona (.pas/.pas__tresc).
// Runda 7 (2026-10-30, decyzja Piotra): małe kafelki po 3 w rzędzie, a opis i wynik PageSpeed w dwóch
// rozwijanych wierszach <details> pod spodem. Kafelek zwinięty = zrzut + nazwa + adres + jedna linia o firmie
// + dwa paski. Wiersze rozwijają się niezależnie (to nie FAQ) i nie ruszają sąsiednich kafelków (align-items: start).
// Obrazki to zrzuty żywych stron 1440×900 (headless Chrome), więc zrzut ma proporcję 16:10 (bez przycinania).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { tekst } from '../lib/tekst';
import blog from '../data/blog.json';
// Wyniki PageSpeed Insights — plik generowany skryptem scripts/psi-realizacje.py (docs/POMIARY.md),
// nie jest w panelu CMS. Klucz = `adres` z serwisy.json, dosłownie.
import pomiary from '../data/pomiary.json';
import serwisyJson from '../data/serwisy.json';

interface Props {
  /** Etykieta nad H2 (napis menu „Realizacje”); puste = bez etykiety. */
  etykieta?: string | null;
  /** Nagłówek H2 sekcji; puste = wartość domyślna. */
  naglowek?: string | null;
  /** Zdanie pod nagłówkiem; puste = bez akapitu. */
  wstep?: string | null;
  /** Kotwica sekcji (menu „Realizacje”). */
  kotwica?: string;
  /** true tylko gdy sekcja stoi nad zgięciem i pierwszy zrzut jest kandydatem na LCP. */
  pierwszyEager?: boolean;
}

const { etykieta, naglowek, wstep, kotwica = 'realizacje', pierwszyEager = false } = Astro.props;

// Pola spoza schematu kolekcji, po adresie (dosłownie).
const surowe = new Map(
  ((serwisyJson as { serwisy?: { adres?: string; teza?: unknown; tagi?: unknown; przyklad?: unknown }[] }).serwisy ?? []).map((w) => [
    String(w.adres ?? ''),
    {
      przyklad: w.przyklad === true,
      teza: typeof w.teza === 'string' ? w.teza.trim() : '',
      tagi: (Array.isArray(w.tagi) ? w.tagi : []).map((t) => String(t ?? '').trim()).filter(Boolean).slice(0, 3),
    },
  ]),
);

const widoczne = await getCollection('serwisy', ({ data }) => !data.ukryty);
const oznaczone = widoczne.filter((w) => surowe.get(w.data.adres)?.przyklad);
const realizacje = (oznaczone.length > 0 ? oznaczone : widoczne).slice(0, 3);
const idNaglowka = `${kotwica}-naglowek`;
const wstepTekst = wstep?.trim() ?? '';
const nowaKarta = tekst(blog.udostepnijNowaKarta, '(otwiera się w nowej karcie)');

// ── „Co zrobiliśmy” ─────────────────────────────────────────────────────────────────────────────
// Pole `zakres` (serwisy.json): każda NIEPUSTA LINIA to jeden punkt listy (znak „- ” lub „• ” na początku
// jest pomijany). Jedna linia = jedno zdanie bez wypunktowania (stary zapis nadal działa).
const punktyZakresu = (dane: unknown): string[] =>
  String((dane as { zakres?: string }).zakres ?? '')
    .split(/\r?\n/)
    .map((w) => w.replace(/^\s*[-•*]\s+/, '').trim())
    .filter(Boolean);

// ── Wyniki PageSpeed Insights ───────────────────────────────────────────────────────────────────
// Kształt wpisu pisze scripts/psi-realizacje.py; strategia z błędem pomiaru bywa `null`.
interface Wyniki {
  wydajnosc?: number | null;
  dostepnosc?: number | null;
  sprawdzoneMetody?: number | null;
  seo?: number | null;
  przegladanieAgentowe?: number | null;
  agentoweZdane?: number;
  agentoweWszystkie?: number;
}
interface Pomiar {
  data?: string | null;
  mobile?: Wyniki | null;
  desktop?: Wyniki | null;
  teren?: string;
}
const pomiarAdresu = (adres: string): Pomiar | null =>
  ((pomiary.pomiary as Record<string, unknown>)[adres] ?? null) as Pomiar | null;

const KATEGORIE: { klucz: keyof Wyniki; nazwa: string }[] = [
  { klucz: 'wydajnosc', nazwa: 'Wydajność' },
  { klucz: 'dostepnosc', nazwa: 'Ułatwienia dostępu' },
  { klucz: 'sprawdzoneMetody', nazwa: 'Sprawdzone metody' },
  { klucz: 'seo', nazwa: 'SEO' },
  { klucz: 'przegladanieAgentowe', nazwa: 'Przeglądanie agentowe' },
];
// Próg jak w PageSpeed Insights: 90–100 = dobry (wypełniona akcentem), poniżej 90 = obrys bez wypełnienia.
// Liczba jest zawsze widoczna — kolor jej nie zastępuje.
const klasaWyniku = (w: number) => (w >= 90 ? 'pastylka--dobry' : 'pastylka--ponizej');
// Dane terenowe CrUX: `brak` albo FAST/AVERAGE/SLOW, z dopiskiem „(domena)”, gdy to wynik całej domeny.
const KATEGORIA_TERENU: Record<string, string> = { FAST: 'szybka', AVERAGE: 'do poprawy', SLOW: 'wolna' };
const zdanieTerenu = (terenSurowy?: string) => {
  const teren = (terenSurowy ?? 'brak').trim();
  const kategoria = KATEGORIA_TERENU[teren.split(' ')[0]] ?? '';
  return kategoria
    ? `Wrażenia użytkowników (Chrome, ostatnie 28 dni${teren.includes('domena') ? ', cała domena' : ''}): ${kategoria}.`
    : 'Wrażenia użytkowników: brak danych — strona nowa; Chrome zbiera je od prawdziwych odwiedzin przez 28 dni.';
};

// Dane kafelka liczone raz na realizację.
const karty = realizacje.map((wpis, i) => {
  const { nazwa, adres, opis, obrazek, alt } = wpis.data;
  let domena = '';
  try {
    domena = new URL(adres).hostname.replace(/^www\./i, '');
  } catch {
    domena = '';
  }
  const slowa = nazwa.trim().split(/\s+/);
  const inicjaly =
    slowa.length >= 2 && !nazwa.includes('.')
      ? (slowa[0][0] + slowa[1][0]).toUpperCase()
      : nazwa.split('.')[0].slice(0, 2).toUpperCase();
  const p = pomiarAdresu(adres);
  const dodatki = surowe.get(adres) ?? { teza: '', tagi: [] as string[] };
  const telefon = typeof p?.mobile?.wydajnosc === 'number' ? p.mobile.wydajnosc : null;
  const komputer = typeof p?.desktop?.wydajnosc === 'number' ? p.desktop.wydajnosc : null;
  // „Studio Agat: z WordPressa na Astro, PageSpeed na telefonie 99” — liczba zawsze z pomiaru, nie z tekstu.
  const zdanie = [nazwa, dodatki.teza ? `: ${dodatki.teza}` : '', telefon !== null ? `${dodatki.teza ? ',' : ':'} PageSpeed na telefonie ${telefon}` : ''].join('');
  return {
    zdanie,
    tagi: dodatki.tagi,
    telefon,
    komputer,
    nazwa,
    adres,
    opis,
    obrazek,
    alt,
    domena,
    inicjaly,
    punkty: punktyZakresu(wpis.data),
    p,
    jestPomiar: !!(p && (p.mobile || p.desktop)),
    adresPsi: `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(adres)}`,
    pierwszy: pierwszyEager && i === 0,
  };
});
---

{
  realizacje.length > 0 && (
    <section class="realizacje" id={kotwica} aria-labelledby={idNaglowka}>
      {etykieta?.trim() && <span class="etykieta realizacje__etykieta">{etykieta.trim()}</span>}
      <h2 id={idNaglowka} class="realizacje__naglowek" data-ujawnij>
        {tekst(naglowek, 'Przykładowe realizacje')}
      </h2>
      <ul class="realizacje__siatka">
        {karty.map((k) => (
          <li data-ujawnij>
            <article class="karta karta--link realizacja">
              <div class="karta__zrzut">
                {k.obrazek ? (
                  <Image
                    src={k.obrazek}
                    alt={k.alt ?? ''}
                    width={720}
                    format="webp"
                    densities={[1, 2]}
                    loading={k.pierwszy ? 'eager' : 'lazy'}
                    fetchpriority={k.pierwszy ? 'high' : 'auto'}
                    decoding="async"
                  />
                ) : (
                  <span class="karta__zastepnik">{k.inicjaly}</span>
                )}
              </div>

              <div class="karta__glowa">
                <h3 class="karta__nazwa">
                  <a class="karta__link" href={k.adres} target="_blank" rel="noopener">
                    {k.zdanie}
                    <span class="tylko-czytnik"> {nowaKarta}</span>
                  </a>
                </h3>
                <p class="karta__domena">
                  {k.nazwa}{k.domena && <> · <span class="karta__adres" translate="no">{k.domena}</span></>}
                  <svg class="karta__wyjscie" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
                </p>
                {k.tagi.length > 0 && (
                  <ul class="karta__tagi" aria-label="Zakres">
                    {k.tagi.map((t) => <li>{t}</li>)}
                  </ul>
                )}
                {k.telefon === null && k.komputer === null && <p class="karta__wynik karta__wynik--w-toku">PageSpeed: pomiar w toku</p>}
                {(k.telefon !== null || k.komputer !== null) && (
                  <p class="karta__wynik">
                    {k.telefon !== null && (
                      <span class="karta__wynik-pozycja">Telefon <span class="liczba karta__liczba">{k.telefon}</span></span>
                    )}
                    {k.telefon !== null && k.komputer !== null && <span class="karta__wynik-kropka" aria-hidden="true">·</span>}
                    {k.komputer !== null && (
                      <span class="karta__wynik-pozycja">Komputer <span class="liczba karta__liczba">{k.komputer}</span></span>
                    )}
                  </p>
                )}
              </div>

              {k.punkty.length > 0 && (
                <details class="karta__rozwin">
                  <summary>
                    <span class="karta__etykieta">Co zrobiliśmy</span>
                    <svg class="karta__strzalka" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </summary>
                  <div class="karta__tresc">
                    {k.punkty.length > 1 ? (
                      <ul class="karta__lista">
                        {k.punkty.map((pkt) => <li>{pkt}</li>)}
                      </ul>
                    ) : (
                      <p class="karta__zdanie">{k.punkty[0]}</p>
                    )}
                  </div>
                </details>
              )}

              <details class="karta__rozwin">
                <summary>
                  <span class="karta__etykieta">
                    Pełny pomiar PageSpeed<span class="karta__dopisek"> — pięć kategorii</span>
                  </span>
                  <svg class="karta__strzalka" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </summary>
                <div class="karta__tresc">
                  {k.jestPomiar ? (
                    <>
                      <table class="pomiar__tabela">
                        <caption class="pomiar__tytul">Oficjalny pomiar Google PageSpeed Insights, skala 0–100</caption>
                        <thead>
                          <tr>
                            <th scope="col" class="pomiar__rog"><span class="tylko-czytnik">Kategoria</span></th>
                            <th scope="col">Telefon</th>
                            <th scope="col">Komputer</th>
                          </tr>
                        </thead>
                        <tbody>
                          {KATEGORIE.map(({ klucz, nazwa: kategoria }) => (
                            <tr>
                              <th scope="row">{kategoria}</th>
                              {[k.p?.mobile, k.p?.desktop].map((w) => {
                                const wynik = w?.[klucz];
                                const agent = klucz === 'przegladanieAgentowe' && w?.agentoweWszystkie;
                                return (
                                  <td>
                                    {typeof wynik === 'number' ? (
                                      <span class={`pastylka ${klasaWyniku(wynik)}`}>{wynik}</span>
                                    ) : (
                                      <span class="pomiar__brak">w toku</span>
                                    )}
                                    {agent && typeof wynik === 'number' && (
                                      <span class="pomiar__ulamek">
                                        <span class="tylko-czytnik">testów zdanych: </span>
                                        {w?.agentoweZdane}/{w?.agentoweWszystkie}
                                      </span>
                                    )}
                                  </td>
                                );
                              })}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <p class="pomiar__nota">
                        {zdanieTerenu(k.p?.teren)}
                      </p>
                    </>
                  ) : (
                    <p class="pomiar__nota">Pomiar w toku.</p>
                  )}
                  <p class="pomiar__linki">
                    <a href={k.adresPsi} target="_blank" rel="noopener">
                      Sprawdź sam<span class="tylko-czytnik"> wyniki {k.domena || k.nazwa} w PageSpeed Insights {nowaKarta}</span>
                    </a>
                    <a href="/jak-sprawdzic-szybkosc-strony/">Przetestuj swoją stronę<span aria-hidden="true"> →</span></a>
                  </p>
                </div>
              </details>
            </article>
          </li>
        ))}
      </ul>
      {wstepTekst && <p class="realizacje__wstep">{wstepTekst}</p>}
    </section>
  )
}

<style>
  .realizacje {
    scroll-margin-top: var(--o-8);
  }

  /* Etykieta + H2-teza nad siatką, na środku (reguła Piotra). */
  .realizacje__etykieta {
    text-align: center;
  }

  .realizacje__naglowek {
    max-width: 24ch;
    margin: 0 auto var(--o-8);
    text-align: center;
  }

  /* Nota o metodzie pod siatką: drobny tekst, na środku. */
  .realizacje__wstep {
    max-width: 44rem;
    margin: var(--o-6) auto 0;
    text-align: center;
    font-size: var(--t-s);
    color: var(--tekst-cichy);
    line-height: 1.5;
  }

  /* Siatka: 1 kolumna → 2 (od 40rem) → 3 (od 56rem) jak .siatka-3. Ostatni niepełny rząd przy lewej krawędzi.
     align-items: start — rozwinięcie wydłuża tylko własną kartę. */
  .realizacje__siatka {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--o-6);
    align-items: stretch;
  }

  .realizacje__siatka > li {
    min-width: 0;
  }

  @media (min-width: 40rem) {
    .realizacje__siatka {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .realizacje__siatka {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ── Karta (.karta.karta--link z motyw.css: tło #fff, obrys, cień). Odnośnik H3 rozpięty na kartę (::after);
     zwijane wiersze i ich linki stoją nad nim (z-index), więc działają osobno. ── */
  .realizacja {
    position: relative;
    container: karta / inline-size;
    overflow: clip;
    /* Karty w rzędzie równej wysokości; wiersze „Co zrobiliśmy” i „Pełny pomiar” na jednej linii. */
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .realizacje__siatka > li {
    display: flex;
    flex-direction: column;
  }

  .realizacja .karta__glowa {
    flex: 1 0 auto;
  }

  .karta__zrzut {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    background: var(--powierzchnia-mocna);
    border-bottom: var(--obrys-karty);
  }

  /* Proporcja pliku: szerokość 100 %, wysokość z width/height obrazka (bez przycinania). */
  .karta__zrzut :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .karta__zastepnik {
    font-family: var(--font-display);
    font-size: var(--t-xxl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--tekst-cichy);
  }

  .karta__glowa {
    padding: var(--o-4) var(--o-4) var(--o-4);
    display: flex;
    flex-direction: column;
    gap: var(--o-2);
  }

  .karta__nazwa {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .karta__link {
    color: var(--tekst);
    text-decoration: none;
  }

  .karta__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--promien-karty);
  }

  .realizacja:hover .karta__link {
    color: var(--akcent);
  }

  .karta__link:focus-visible {
    outline: none;
  }

  .karta__link:focus-visible::after {
    outline: 2px solid var(--akcent);
    outline-offset: 3px;
  }

  /* Znak „otwiera się w nowej karcie” — sam kształt, słowo niesie czytnik. */
  .karta__wyjscie {
    display: inline-block;
    margin-left: 0.3em;
    vertical-align: -0.1em;
  }

  .karta__domena {
    margin: 0;
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  .karta__adres {
    white-space: nowrap;
  }

  .karta__tagi {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--o-1) var(--o-2);
  }

  .karta__tagi li {
    padding: 0.0625rem var(--o-2);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--tekst);
    background: var(--powierzchnia);
    border-radius: var(--promien-maly);
  }

  /* Wynik PSI widoczny bez rozwijania: „Telefon 99 · Komputer 100”, cyfra .liczba w mniejszym stopniu. */
  .karta__wynik {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--o-3);
    margin: var(--o-1) 0 0;
    font-size: var(--t-s);
    font-weight: 600;
  }

  .karta__liczba {
    display: inline;
    font-size: var(--t-xl);
  }

  .karta__wynik-kropka {
    color: var(--tekst-cichy);
  }

  .karta__wynik--w-toku {
    font-weight: 400;
    color: var(--tekst-cichy);
  }

  .karta__rozwin {
    position: relative;
    z-index: 1;
  }

  /* ── Rozwijane wiersze ──────────────────────────────────────────────────────────────────────
     Każdy <details> działa osobno. Pasek ma cel dotyku 44 px i pełną szerokość karty. */
  .karta__rozwin {
    border-top: 1px solid var(--linia);
    interpolate-size: allow-keywords;
  }

  .karta__rozwin > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--o-3);
    min-height: var(--cel-dotyku);
    padding: var(--o-2) var(--o-4);
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--tekst);
    cursor: pointer;
    list-style: none;
    transition: background-color 160ms ease;
  }

  .karta__rozwin > summary::-webkit-details-marker {
    display: none;
  }

  .karta__rozwin > summary:hover {
    background: var(--powierzchnia-mocna);
  }

  .karta__rozwin > summary:active {
    opacity: 0.85;
  }

  .karta__dopisek {
    font-weight: 400;
    color: var(--tekst-cichy);
  }

  .karta__strzalka {
    flex: 0 0 auto;
    color: var(--akcent);
  }

  .karta__rozwin[open] > summary .karta__strzalka {
    transform: rotate(180deg);
  }

  .karta__tresc {
    padding: var(--o-1) var(--o-4) var(--o-4);
    font-size: var(--t-s);
    line-height: 1.5;
  }

  .karta__lista {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: var(--o-1);
  }

  .karta__zdanie {
    margin: 0;
  }

  /* Animacja wysokości tylko w CSS: ::details-content przechodzi z 0 do auto (interpolate-size).
     Przeglądarka bez tych funkcji pokazuje treść od razu — nic się nie psuje. */
  @media (prefers-reduced-motion: no-preference) {
    .karta__rozwin::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 260ms var(--ruch-krzywa),
        content-visibility 260ms allow-discrete;
    }

