---
// Dane rejestrowe przepisane ze starej strony ZNAK W ZNAK; treść z firma.json,
// pola puste nie renderują się wcale.
// 🔴 Guziki „skopiuj": układ wersów zostaje, bez JS stopka wygląda jak przed
// zmianą (docs/DECYZJE-WIZUALNE.md D4, D6).
import firma from '../data/firma.json';
import napisyStopki from '../data/stopka.json';
import blog from '../data/blog.json';
import Tlumacz from './Tlumacz.astro';
import { tekst } from '../lib/tekst';

const mail = firma.email.toLowerCase();

// Etykiety i napisy z panelu; `tekst()` przywraca wartość domyślną po wyczyszczeniu pola.
// Skróty rejestrowe też są edytowalne — pięć sąsiednich etykiet było, te trzy nie były,
// i ta niekonsekwencja nie miała uzasadnienia (kontrola nadi 2026-09-07, K4).
const etykietaKrs = tekst(napisyStopki.etykietaKrs, 'KRS');
const etykietaNip = tekst(napisyStopki.etykietaNip, 'NIP');
const etykietaRegon = tekst(napisyStopki.etykietaRegon, 'REGON');
// Sąd rejestrowy i kapitał zakładowy (KSH art. 206 § 1, runda 9): dane z odpisu aktualnego KRS 0000881612 (kapitał) i z ustalenia Piotra (sąd; odpis go nie podaje).
const etykietaSad = tekst(napisyStopki.etykietaSad, 'Sąd rejestrowy:');
const etykietaKapital = tekst(napisyStopki.etykietaKapital, 'Kapitał zakładowy:');
const etykietaAdresWww = tekst(napisyStopki.etykietaAdresWww, 'Adres WWW:');
const etykietaEmail = tekst(napisyStopki.etykietaEmail, 'E-mail:');
const etykietaAdres = tekst(napisyStopki.etykietaAdres, 'Adres:');
const etykietaTelefon = tekst(napisyStopki.etykietaTelefon, 'Telefon:');
const guzikKopiujWszystko = tekst(napisyStopki.guzikKopiujWszystko, 'Skopiuj dane spółki');
// Odnośnik do /polityka-prywatnosci/ w menu stopki (runda 6, D20).
const linkPolityki = tekst(napisyStopki.linkPolityki, 'Polityka prywatności');
// Etykieta grupy nad czterema usługami (runda 7): nagłówek, nie odnośnik.
const etykietaUslug = tekst(napisyStopki.etykietaUslug, 'Usługi');
// Link otwierający okno zgody cookie ponownie (Zgoda.astro nasłuchuje na [data-ustawienia-cookie]).
const ustawieniaCookie = tekst(napisyStopki.ustawieniaCookie, 'Ustawienia cookie');
// Dwa odnośniki dodane w rundzie 7 (2026-10-30): strona darmowych narzędzi i regulamin serwisu.
const linkNarzedzi = tekst(napisyStopki.linkNarzedzi, 'Darmowe narzędzia');
const linkRegulaminu = tekst(napisyStopki.linkRegulaminu, 'Regulamin');

// Nazwa rzeczy kopiowanej guzikiem zbiorczym, do komunikatu dla czytnika ekranu
// („Skopiowano: dane spółki."). Liczona Z NAPISU Z PANELU, nie wpisana w skrypcie:
// inaczej po zmianie napisu guzika w panelu czytnik ekranu mówiłby dalej stare
// brzmienie i HTML rozjechałby się z JavaScriptem po cichu (kontrola nadi, K5).
// Stopka pokazuje skrót „EcoPower Polska Sp. z o.o.” (Piotr 2026-10-27); pełna nazwa zostaje w JSON-LD i llms.txt.
const nazwaStopki = tekst((firma as Record<string, unknown>).nazwaStopka as string | undefined, firma.nazwaPelna);
// Wiersz praw zastrzeżonych. Rok = rok BUDOWY strony (czas Warszawy, nie UTC: build 1 stycznia po północy też da nowy rok). Build odpala się
// przy każdej zmianie treści w repo, więc rok jest bieżący; po 1 stycznia odświeży go najbliższy build. Nazwa bez końcowej kropki,
// bo szablon z panelu („© {rok} {nazwa}. Wszelkie prawa zastrzeżone.”) dokłada własną — inaczej wyszłoby „o.o..”.
const rokBudowy = new Intl.DateTimeFormat('pl-PL', { year: 'numeric', timeZone: 'Europe/Warsaw' }).format(new Date());
const prawaZastrzezone = tekst(napisyStopki.prawa, '© {rok} {nazwa}. Wszelkie prawa zastrzeżone.')
  .replace('{rok}', rokBudowy)
  .replace('{nazwa}', nazwaStopki.replace(/\.$/, ''));
const nazwaZbiorcza = guzikKopiujWszystko.replace(/^skopiuj\s+/i, '');
const potwierdzenieKopiowania = tekst(napisyStopki.potwierdzenieKopiowania, 'Skopiowano');
const bladKopiowania = tekst(napisyStopki.bladKopiowania, 'Nie udało się skopiować.');

// Lista „Usługi” (runda 5, 2026-10-27): cztery strony usług — każda ma linki przychodzące z całej witryny.
const uslugiStopki = [
  { adres: '/strony-internetowe-warszawa/', nazwa: 'Tworzenie stron internetowych' },
  { adres: '/sklepy-internetowe-warszawa/', nazwa: 'Tworzenie sklepów internetowych' },
  { adres: '/strona-wizytowka/', nazwa: 'Strona wizytówka' },
  { adres: '/prowadzenie-strony-internetowej/', nazwa: 'Prowadzenie strony' },
];

// Blok kopiowany guzikiem zbiorczym — do wklejenia w umowę albo przelew.
const daneSpolki = [
  nazwaStopki,
  `${firma.rejestr}, ${etykietaKrs} ${firma.krs}`,
  firma.sad && `${etykietaSad} ${firma.sad}`,
  firma.kapital && `${etykietaKapital} ${firma.kapital}`,
  `${etykietaNip} ${firma.nip}`,
  `${etykietaRegon} ${firma.regon}`,
  `${etykietaAdresWww} ${firma.adresWww}`,
  `${etykietaEmail} ${firma.email}`,
  firma.adresSiedziby && `${etykietaAdres} ${firma.adresSiedziby}`,
  firma.telefon && `${etykietaTelefon} ${firma.telefon}`,
]
  .filter(Boolean)
  .join('\n');
---

{/* Trzy napisy dla skryptu klienckiego jadą atrybutami data-* — skrypt NIE WIDZI
    zmiennych z frontmatteru, a te napisy pochodzą z panelu (KONTRAKT-CMS §5). */}
<footer
  class="stopka"
  data-potwierdzenie={potwierdzenieKopiowania}
  data-blad={bladKopiowania}
  data-guzik={guzikKopiujWszystko}
>
  <div class="stopka__srodek">
    <nav class="stopka__menu" aria-label={tekst(blog.etykietaMenuStopki, 'Strony witryny')}>
      <ul>
        <li><a href="/">{tekst(blog.stronaGlowna, 'Strona główna')}</a></li>
        <li><a href="/#oferta">{tekst(blog.menuOferta, 'Oferta')}</a></li>
        <li><a href="/#realizacje">{tekst(blog.menuRealizacje, 'Realizacje')}</a></li>
        <li><a href="/efekty/">{tekst(blog.menuEfekty, 'Efekty')}</a></li>
        <li><a href="/cena/">{tekst(blog.menuCena, 'Cena')}</a></li>
        <li><a href="/jak-sprawdzic-szybkosc-strony/">{tekst(blog.menuSzybkosc, 'Szybkość')}</a></li>
        <li><a href="/faq/">{tekst(blog.menuFaq, 'FAQ')}</a></li>
        <li><a href="/blog/">{tekst(blog.menuBlog, 'Blog')}</a></li>
        <li><a href="/kontakt/">{tekst(blog.menuKontakt, 'Kontakt')}</a></li>
        <li><a href="/darmowe-narzedzia/">{linkNarzedzi}</a></li>
      </ul>
      {/* Drugi wiersz: dokumenty i ustawienia (13 pozycji w jednym wierszu zawijało się z osamotnionym ostatnim przyciskiem). */}
      <ul>
        <li><a href="/regulamin/">{linkRegulaminu}</a></li>
        <li><a href="/polityka-prywatnosci/">{linkPolityki}</a></li>
        <li><button type="button" class="stopka__przycisk-linku" data-ustawienia-cookie>{ustawieniaCookie}</button></li>
      </ul>
    </nav>

    <nav class="stopka__uslugi" aria-labelledby="stopka-uslugi">
      <p id="stopka-uslugi" class="stopka__etykieta">{etykietaUslug}</p>
      <ul>
        {uslugiStopki.map((u) => (
          <li><a href={u.adres}>{u.nazwa}</a></li>
        ))}
      </ul>
    </nav>

    {/* Przełącznik języków (GTranslate): etykieta, pojemnik widżetu i przycisk startowy w Tlumacz.astro. Miejsce zarezerwowane (44 px), bez skoku układu. */}
    <Tlumacz />

    <p class="stopka__nazwa">
      <span class="dana"
        >{nazwaStopki}<button
          class="kopiuj"
          type="button"
          hidden
          data-kopiuj={nazwaStopki}
          aria-label="Skopiuj nazwę spółki"><span class="kopiuj__znak" aria-hidden="true"></span></button
        ></span
      >
    </p>

    {/* Jeden wiersz, BEZ przecinków — granicę niesie odstęp (D6). */}
    <p class="stopka__rejestr">
      <span class="pozycja">{firma.rejestr}</span>
      <span class="pozycja"
        >{etykietaKrs} <span class="dana"
          >{firma.krs}<button
            class="kopiuj"
            type="button"
            hidden
            data-kopiuj={firma.krs}
            aria-label="Skopiuj numer KRS"><span class="kopiuj__znak" aria-hidden="true"></span></button
          ></span
        ></span
      >
      <span class="pozycja"
        >{etykietaNip} <span class="dana"
          >{firma.nip}<button
            class="kopiuj"
            type="button"
            hidden
            data-kopiuj={firma.nip}
            aria-label="Skopiuj numer NIP"><span class="kopiuj__znak" aria-hidden="true"></span></button
          ></span
        ></span
      >
      <span class="pozycja"
        >{etykietaRegon} <span class="dana"
          >{firma.regon}<button
            class="kopiuj"
            type="button"
            hidden
            data-kopiuj={firma.regon}
            aria-label="Skopiuj numer REGON"><span class="kopiuj__znak" aria-hidden="true"></span></button
          ></span
        ></span
      >
    </p>

    {(firma.sad || firma.kapital) && (
      <p class="stopka__rejestr">
        {firma.sad && <span class="pozycja">{etykietaSad} {firma.sad}</span>}
        {firma.kapital && <span class="pozycja">{etykietaKapital} {firma.kapital}</span>}
      </p>
    )}

    <dl class="stopka__dane">
      <dt>{etykietaAdresWww}</dt>
      <dd
        ><span class="dana"
          >{firma.adresWww}<button
            class="kopiuj"
            type="button"
            hidden
            data-kopiuj={firma.adresWww}
            aria-label="Skopiuj adres WWW"><span class="kopiuj__znak" aria-hidden="true"></span></button
          ></span
        ></dd
      >

      <dt>{etykietaEmail}</dt>
      <dd
        ><span class="dana"
          ><a href={`mailto:${mail}`}>{firma.email}</a><button
            class="kopiuj"
            type="button"
            hidden
            data-kopiuj={firma.email}
            aria-label="Skopiuj adres e-mail"><span class="kopiuj__znak" aria-hidden="true"></span></button
          ></span
        ></dd
      >

      {firma.adresSiedziby && (
        <>
          <dt>{etykietaAdres}</dt>
          <dd
            ><span class="dana"
              >{firma.adresSiedziby}<button
                class="kopiuj"
                type="button"
                hidden
                data-kopiuj={firma.adresSiedziby}
                aria-label="Skopiuj adres siedziby"><span class="kopiuj__znak" aria-hidden="true"></span></button
              ></span
            ></dd
          >
        </>
      )}

      {firma.telefon && (
        <>
          <dt>{etykietaTelefon}</dt>
          <dd
            ><span class="dana"
              >{firma.telefon}<button
                class="kopiuj"
                type="button"
                hidden
                data-kopiuj={firma.telefon}
                aria-label="Skopiuj numer telefonu"><span class="kopiuj__znak" aria-hidden="true"></span></button
              ></span
            ></dd
          >
        </>
      )}
    </dl>

    <p class="stopka__zbiorczy">
      <button
        class="kopiuj-wszystko"
        type="button"
        hidden
        data-kopiuj={daneSpolki}
        data-nazwa={nazwaZbiorcza}
      >
        {guzikKopiujWszystko}
      </button>
    </p>

    {/* Potwierdzenie dla czytnika ekranu — zmiana ikony jest dla niego niema. */}
    <p class="stopka__stan" role="status" aria-live="polite"></p>

    <p class="stopka__prawa">{prawaZastrzezone}</p>
  </div>
</footer>

<script>
  // Guziki startują jako `hidden` i pokazują się dopiero tutaj — bez Clipboard API
  // stopka zostaje taka, jaka była. Zero martwych guzików.
  const schowek = navigator.clipboard;
  if (schowek) {
    const guziki = document.querySelectorAll<HTMLButtonElement>('[data-kopiuj]');
    const stan = document.querySelector<HTMLParagraphElement>('.stopka__stan');

    // Napisy z panelu. Skrypt nie widzi frontmatteru, więc odczytuje je z atrybutów
    // data-* postawionych na <footer> wyżej — nic tu nie jest wpisane na sztywno.
    const napisy = document.querySelector<HTMLElement>('.stopka')?.dataset;

    for (const guzik of guziki) guzik.hidden = false;

    // `ReturnType<...>`, nie `number` — widoczne są typy Node'a (ts(2322)).
    let zegar: ReturnType<typeof setTimeout> | undefined;

    for (const guzik of guziki) {
      guzik.addEventListener('click', async () => {
        try {
          await schowek.writeText(guzik.dataset.kopiuj ?? '');
        } catch {
          if (stan) stan.textContent = napisy?.blad ?? '';
          return;
        }

        // Potwierdzenie trzema drogami: ptaszek, napis na guziku zbiorczym, komunikat.
        guzik.dataset.ok = '1';
        if (guzik.classList.contains('kopiuj-wszystko')) {
          guzik.textContent = napisy?.potwierdzenie ?? '';
        }
        if (stan) {
          // Guzik zbiorczy niesie nazwę w `data-nazwa` (liczoną z napisu z panelu),
          // guziki przy danych — w swoim aria-label. Wzorzec „Skopiuj " to mechanika
          // czytnika ekranu, nie treść: idzie w parze z aria-label, które zostają
          // w kodzie świadomie. Zapas na końcu nie powinien się nigdy odezwać.
          const co =
            guzik.dataset.nazwa ??
            guzik.getAttribute('aria-label')?.replace(/^Skopiuj /, '') ??
            '';
          stan.textContent = `${napisy?.potwierdzenie ?? ''}: ${co}.`;
        }

        clearTimeout(zegar);
        zegar = setTimeout(() => {
          for (const g of guziki) {
            delete g.dataset.ok;
            if (g.classList.contains('kopiuj-wszystko')) g.textContent = napisy?.guzik ?? '';
          }
          if (stan) stan.textContent = '';
        }, 2000);
      });
    }
  }
</script>

<style>
  /* Stopka na wypełnieniu, bez kreski — tak samo jak kafelki. Do dołu dociska ją
     wiersz `1fr` siatki na <body> (motyw.css), nie margines. */
  .stopka {
    background: var(--powierzchnia);
  }

  .stopka__srodek {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: var(--o-8) var(--o-6);
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--tekst-cichy);
  }

  .stopka__menu ul:has(+ ul) {
    margin-bottom: 0;
  }

  .stopka__menu ul {
    list-style: none;
    margin: 0 0 var(--o-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--o-6);
  }

  /* Usługi: etykieta grupy na środku, kreska pod nią na pełną szerokość, cztery usługi w jednym rzędzie.
     Etykieta to nagłówek, nie odnośnik: kapitaliki, kolor cichy, bez podkreślenia i bez koloru linku. */
  .stopka__uslugi {
    margin: 0 0 var(--o-4);
  }

  .stopka__etykieta {
    margin: 0;
    padding-bottom: var(--o-2);
    border-bottom: 1px solid var(--linia);
    text-align: center;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tekst-cichy);
    text-decoration: none;
  }

  .stopka__uslugi ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--o-6);
  }

  @media (min-width: 48rem) {
    .stopka__uslugi ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stopka__uslugi li {
    text-align: center;
  }

  .stopka__uslugi a {
    justify-content: center;
  }

  .stopka__menu a,
  .stopka__uslugi a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--akcent);
  }

  /* „Ustawienia cookie”: <button> wyglądający jak odnośnik menu (cofnięcie zgody tak łatwe jak jej udzielenie). */
  .stopka__przycisk-linku {
    appearance: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    font: inherit;
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--akcent);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .stopka__przycisk-linku:hover {
    color: var(--tekst);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .stopka__menu a:hover,
  .stopka__uslugi a:hover {
    color: var(--tekst);
  }

  .stopka__nazwa {
    margin: 0 0 var(--o-2);
    color: var(--tekst);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .stopka__rejestr {
    margin: 0 0 var(--o-4);
  }

  .stopka__dane {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--o-1) var(--o-3);
    margin: 0;
  }

  .stopka__dane dt {
    font-weight: 600;
    color: var(--tekst);
  }

  .stopka__dane dd {
    margin: 0;
  }

  .stopka__dane a {
    color: var(--akcent);
  }

  .stopka__dane a:hover {
    color: var(--tekst);
  }

  /* Wartość i jej guzik łamią się razem albo wcale. */
  .dana {
    white-space: nowrap;
  }

  /* Odstęp zamiast przecinka — jedyna granica między pozycjami (D6). */
  .pozycja {
    white-space: nowrap;
    margin-right: var(--o-4);
  }

  .pozycja:last-child {
    margin-right: 0;
  }

  /* Guzik przy danej — celowo cichy; kolory to pary policzone w motyw.css. */
  .kopiuj {
    /* spoczynek */
    appearance: none;
    /* Ujemny prawy margines: guzik jest szerszy od ikony (pole kliknięcia) i bez
       tego pusty pas odsuwał od wartości to, co stoi za nią. */
    /* 24×24 px = minimum WCAG 2.5.8 (D14). Ujemne marginesy pionowe: większy guzik
       nie podnosi wysokości wiersza. */
    margin: -0.25rem -0.35rem -0.25rem 0;
    padding: 0;
    width: 24px;
    height: 24px;
    vertical-align: middle;
    display: inline-grid;
    place-items: center;
    background: none;
    border: 0;
    border-radius: var(--promien-maly);
    color: var(--tekst-cichy);
    cursor: pointer;
  }

  /* najechanie */
  .kopiuj:hover {
    color: var(--akcent);
    background: var(--powierzchnia-mocna);
  }

  /* aktywny (wciśnięty) */
  .kopiuj:active {
    transform: translateY(1px);
  }

  /* Ikona z dwóch pudełek CSS, nie SVG — skaluje się z tekstem. */
  .kopiuj__znak {
    position: relative;
    width: 0.6rem;
    height: 0.7rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .kopiuj__znak::before {
    content: '';
    position: absolute;
    left: -3.5px;
    top: -3.5px;
    width: 0.6rem;
    height: 0.7rem;
    border: 1.5px solid currentColor;
    border-right: 0;
    border-bottom: 0;
    border-radius: 2px 0 0 0;
  }

  /* Ta sama ramka zamienia się w ptaszka — bez zmiany szerokości guzika. */
  .kopiuj[data-ok] {
    color: var(--akcent);
  }

  .kopiuj[data-ok] .kopiuj__znak {
    border: 0;
    border-radius: 0;
    width: 0.75rem;
    height: 0.4rem;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg) translate(1px, -2px);
  }

  .kopiuj[data-ok] .kopiuj__znak::before {
    content: none;
  }

  /* Guzik zbiorczy: ramka, nie wypełnienie — to narzędzie, nie CTA. */
  .stopka__zbiorczy {
    margin: var(--o-6) 0 0;
  }

  .kopiuj-wszystko {
    /* spoczynek */
    appearance: none;
    padding: var(--o-2) var(--o-4);
    background: none;
    border: 1px solid var(--linia);
    border-radius: var(--promien-maly);
    color: var(--tekst);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  /* najechanie */
  .kopiuj-wszystko:hover {
    border-color: var(--akcent);
    color: var(--akcent);
  }

  /* aktywny (wciśnięty) */
  .kopiuj-wszystko:active {
    transform: translateY(1px);
  }

