---
// SzkieletUslugi.astro — wspólny szablon 4 stron usług (faza 2, 2026-11-06; wcześniej 4 kopie: 2 × 787 i 2 × 414 w.).
// Strona usługi podaje tylko JSON z src/data/uslugi/ i trasę. 0 kB JS: <details>, linki, bez <script>.
// Kwoty: {od: <pozycja z cena.json>} → cena (+ jednostka) z cennika; nieznana pozycja → „wycena indywidualna” (bramka A5).
// Linki w tekście: [kotwica](/trasa/) (lib/odnosniki.ts). Bez FAQPage (bramka A10).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Bazowy from '../layouts/Bazowy.astro';
import PasekMarki from './PasekMarki.astro';
import Stopka from './Stopka.astro';
import cenaJson from '../data/cena.json';
import pomiaryJson from '../data/pomiary.json';
import narzedziaJson from '../data/narzedzia.json';
import blog from '../data/blog.json';
import { tekst } from '../lib/tekst';
import { kawalki } from '../lib/odnosniki';

interface Props {
  dane: Record<string, unknown>;
  trasa: string;
  /** Obszar w danych strukturalnych: tylko Warszawa albo Warszawa i Polska (strony A3/A4). */
  obszarKraj?: boolean;
}
const { dane: d, trasa: TRASA, obszarKraj = false } = Astro.props;

type Rek = Record<string, unknown>;
const naTekst = (v: unknown): string => (typeof v === 'string' ? v.trim() : v == null ? '' : String(v).trim());
const napis = (klucz: string, domyslny: string) => tekst(naTekst(d[klucz]), domyslny);
const lista = (v: unknown): Rek[] => (Array.isArray(v) ? (v as Rek[]).filter((x) => x && typeof x === 'object') : []);
const napisy = (v: unknown): string[] => (Array.isArray(v) ? v : v == null ? [] : [v]).map(naTekst).filter(Boolean);
const obiekt = (v: unknown): Rek => (v && typeof v === 'object' && !Array.isArray(v) ? (v as Rek) : {});

// Cennik: pozycja → { cena, jednostka } ze wszystkich tabel cena.json.
const cennik = new Map<string, { cena: string; jednostka: string }>();
for (const wartosc of Object.values(cenaJson as Rek)) {
  for (const w of lista(wartosc)) {
    const pozycja = naTekst(w.pozycja);
    if (pozycja) cennik.set(pozycja, { cena: naTekst(w.cena), jednostka: naTekst(w.jednostka) });
  }
}
const brakCeny = tekst(naTekst((cenaJson as Rek).brakCeny), 'wycena indywidualna');
const kwota = (nazwa: string): string => {
  const w = cennik.get(nazwa.trim());
  if (!w || !w.cena) return brakCeny;
  return (w.jednostka ? `${w.cena} ${w.jednostka}` : w.cena).replace(/ /g, ' ');
};
const zKwotami = (t: string): string => t.replace(/\{od:\s*([^}]+)\}/g, (_, nazwa: string) => kwota(nazwa));
const czesci = (t: string) => kawalki(zKwotami(t));

const tytul = napis('tytulKarty', 'Strona usługi — EcoPower Polska');
const opis = napis('opisWyszukiwarki', '');
const naglowek = napis('naglowek', 'Usługa');
const lead = napis('lead', '');

// Wiersz 3 faktów pod wstępem: cena z cennika, PageSpeed z pomiary.json (najniższy–najwyższy wynik na telefonie, data
// najnowszego pomiaru), trzeci fakt z JSON. Brak danych = fakt się nie pokazuje.
const pomiary = ((pomiaryJson as Rek).pomiary ?? {}) as Record<string, Rek>;
const FORMAT_DATY = new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Warsaw' });
const dataPolska = (iso: string) => (/^\d{4}-\d{2}-\d{2}/.test(iso) ? FORMAT_DATY.format(new Date(iso.slice(0, 10))) : iso);
const wynikiTelefon = Object.values(pomiary)
  .map((p) => (p?.mobile as Rek | undefined)?.wydajnosc)
  .filter((x): x is number => typeof x === 'number');
const najnowszyPomiar = Object.values(pomiary).map((p) => naTekst(p?.data)).filter(Boolean).sort().pop() ?? '';
const cenaOdNazwa = naTekst(d.cenaOdPozycja);
const fakty = [
  cennik.get(cenaOdNazwa)?.cena
    ? { liczba: `od ${kwota(cenaOdNazwa)}`, podpis: napis('faktCenaPodpis', 'netto') }
    : null,
  wynikiTelefon.length > 0
    ? {
        liczba: `${Math.min(...wynikiTelefon)}–${Math.max(...wynikiTelefon)}`,
        podpis: `pkt PageSpeed na telefonie${najnowszyPomiar ? ` (pomiar ${dataPolska(najnowszyPomiar)})` : ''}`,
      }
    : null,
  naTekst(obiekt(d.faktTrzeci).liczba)
    ? { liczba: zKwotami(naTekst(obiekt(d.faktTrzeci).liczba)), podpis: zKwotami(naTekst(obiekt(d.faktTrzeci).podpis)) }
    : null,
].filter((f): f is { liczba: string; podpis: string } => f !== null);

const przyciskKontakt = napis('przyciskKontakt', 'Zapytaj o wycenę');
const przyciskKalkulator = napis('przyciskKalkulator', 'Policz cenę w kalkulatorze');

const coDostajesz = napisy(d.coDostajesz);
const sekcje = lista(d.sekcje)
  .map((s, i) => {
    const t = obiekt(s.tabela);
    const kolumnyTabeli = napisy(t.kolumny);
    return {
      id: naTekst(s.id) || `sekcja-${i + 1}`,
      naglowek: naTekst(s.naglowek),
      akapity: napisy(s.akapity),
      punkty: napisy(s.lista),
      akapityPo: napisy(s.akapityPo),
      tabela:
        kolumnyTabeli.length > 0 && Array.isArray(t.wiersze)
          ? { podpis: naTekst(t.podpis), kolumny: kolumnyTabeli, wiersze: (t.wiersze as unknown[]).filter(Array.isArray).map((w) => (w as unknown[]).map(naTekst)) }
          : null,
      kolumny: lista(s.kolumny)
        .map((k) => ({
          naglowek: naTekst(k.naglowek),
          pozycje: lista(k.pozycje).map((p) => ({ nazwa: naTekst(p.nazwa), opis: naTekst(p.opis) })).filter((p) => p.nazwa),
        }))
        .filter((k) => k.naglowek && k.pozycje.length > 0),
    };
  })
  .filter((s) => s.naglowek);

// Gotowość na asystentów AI: pytanie + opis + narzędzie z narzedzia.json (po id kafla).
const kafleNarzedzi = lista((narzedziaJson as Rek).kafelki);
const ai = obiekt(d.gotowoscAi);
const aiPytania = lista(ai.pytania)
  .map((p) => {
    const kafel = kafleNarzedzi.find((k) => naTekst(k.id) === naTekst(p.narzedzie));
    return {
      pytanie: naTekst(p.pytanie),
      opis: naTekst(p.opis),
      narzedzie: kafel ? { adres: naTekst(kafel.adres), nazwa: naTekst(kafel.nazwa) } : null,
    };
  })
  .filter((p) => p.pytanie && p.opis);

const nieObiecujemy = obiekt(d.nieObiecujemy);
const nieObiecujemyAkapity = napisy(nieObiecujemy.akapity);

// Przykłady: nazwa, zrzut i alt z kolekcji „serwisy”, wynik z pomiary.json — po adresie, dosłownie.
const serwisy = await getCollection('serwisy');
const przyklady = lista(d.przyklady)
  .map((p) => {
    const adres = naTekst(p.adres);
    const wpis = serwisy.find((s) => s.data.adres === adres)?.data;
    const pm = pomiary[adres];
    const tel = (pm?.mobile as Rek | undefined)?.wydajnosc;
    const komp = (pm?.desktop as Rek | undefined)?.wydajnosc;
    let domena = adres;
    try {
      domena = new URL(adres).hostname.replace(/^www\./, '');
    } catch {
      /* zostaje adres */
    }
    return {
      adres,
      domena,
      nazwa: naTekst(p.nazwa) || wpis?.nazwa || domena,
      zdanie: zKwotami(naTekst(p.zdanie)),
      obrazek: wpis?.obrazek,
      alt: wpis?.alt ?? '',
      wynik: typeof tel === 'number' && typeof komp === 'number' ? { tel, komp, data: dataPolska(naTekst(pm?.data)) } : null,
    };
  })
  .filter((p) => p.adres);

// Kroki: co robimy my (opis) i co robisz Ty (ty).
const proces = lista(d.proces)
  .map((k) => ({ nazwa: naTekst(k.nazwa), my: naTekst(k.opis), ty: naTekst(k.ty) }))
  .filter((k) => k.nazwa);
const wideo = naTekst(d.wideo);
const pytania = lista(d.pytania)
  .map((p) => ({ pytanie: naTekst(p.pytanie), odpowiedz: naTekst(p.odpowiedz) }))
  .filter((p) => p.pytanie && p.odpowiedz);
const cenaTekst = napisy(d.cenaTekst);
const zobaczTez = lista(d.zobaczTez)
  .map((z) => ({ adres: naTekst(z.adres), tekst: naTekst(z.tekst) }))
  .filter((z) => z.adres.startsWith('/') && z.tekst);

// Spis „W tym artykule”: wszystkie H2 w kolejności na stronie.
const spis = [
  coDostajesz.length > 0 && { id: 'co-dostajesz', tekst: napis('coDostajeszNaglowek', 'Co dostajesz') },
  ...sekcje.map((s) => ({ id: s.id, tekst: s.naglowek })),
  aiPytania.length > 0 && { id: 'gotowosc-ai', tekst: napis2(ai.naglowek, 'Czy Twoja strona jest gotowa na asystentów AI') },
  przyklady.length > 0 && { id: 'przyklady', tekst: napis('przykladyNaglowek', 'Przykłady') },
  proces.length > 0 && { id: 'krok-po-kroku', tekst: napis('procesNaglowek', 'Jak pracujemy') },
  nieObiecujemyAkapity.length > 0 && { id: 'czego-nie-obiecujemy', tekst: napis2(nieObiecujemy.naglowek, 'Czego nie obiecujemy') },
  pytania.length > 0 && { id: 'pytania', tekst: napis('pytaniaNaglowek', 'Pytania') },
  { id: 'cena', tekst: napis('cenaNaglowek', 'Ile to kosztuje') },
].filter((x): x is { id: string; tekst: string } => Boolean(x));
function napis2(v: unknown, domyslny: string) {
  return tekst(naTekst(v), domyslny);
}

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adres = new URL(TRASA, import.meta.env.SITE).href;
const okruszki = [
  { nazwa: tekst(blog.stronaGlowna, 'Strona główna'), adres: '/' },
  { nazwa: napis('okruszek', naglowek), adres: TRASA },
];
const minCena = Number((cennik.get(cenaOdNazwa)?.cena ?? '').replace(/[^\d]/g, ''));
// Cena okresowa (np. opieka miesięczna): kod jednostki UN/CEFACT z JSON (MON = miesiąc, ANN = rok); puste = jednorazowa.
const jednostkaKod = naTekst(d.cenaJednostkaKod);

const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${adres}#usluga`,
      name: napis('uslugaNazwa', naglowek),
      serviceType: napis('uslugaTyp', naglowek),
      description: napis('uslugaOpis', opis),
      url: adres,
      provider: { '@id': `${baza}/#organizacja` },
      areaServed: obszarKraj
        ? [
            { '@type': 'City', name: 'Warszawa' },
            { '@type': 'Country', name: 'Polska' },
          ]
        : { '@type': 'City', name: 'Warszawa' },
      ...(minCena > 0
        ? {
            offers: {
              '@type': 'Offer',
              url: new URL('/cena/', import.meta.env.SITE).href,
              priceCurrency: 'PLN',
              priceSpecification: {
                '@type': jednostkaKod ? 'UnitPriceSpecification' : 'PriceSpecification',
                ...(jednostkaKod ? { unitCode: jednostkaKod } : {}),
                minPrice: minCena,
                priceCurrency: 'PLN',
                valueAddedTaxIncluded: false,
              },
            },
          }
        : {}),
    },
    {
      '@type': 'WebPage',
      '@id': `${adres}#strona`,
      url: adres,
      name: naglowek,
      description: opis,
      inLanguage: 'pl-PL',
      isPartOf: { '@id': `${baza}/#witryna` },
      about: { '@id': `${adres}#usluga` },
      mainEntity: { '@id': `${adres}#usluga` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: o.nazwa,
        item: new URL(o.adres, import.meta.env.SITE).href,
      })),
    },
  ],
};
---

<Bazowy tytul={tytul} opis={opis}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="usluga">
    <div class="usluga__glowa">
      <nav class="okruszki" aria-label={tekst(blog.okruszkiEtykieta, 'Ścieżka')}>
        <ol>
          {okruszki.map((o, i) => (
            <li>
              {i < okruszki.length - 1 ? <a href={o.adres}>{o.nazwa}</a> : <span aria-current="page">{o.nazwa}</span>}
            </li>
          ))}
        </ol>
      </nav>

      <h1 class="usluga__tytul">{naglowek}</h1>
      {lead && <p class="usluga__lead">{czesci(lead).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>}
      {fakty.length > 0 && (
        <ul class="usluga__fakty">
          {fakty.map((f) => (
            <li><strong>{f.liczba}</strong> <span>{f.podpis}</span></li>
          ))}
        </ul>
      )}
      <div class="usluga__przyciski">
        <a class="guzik" href="/kontakt/">{przyciskKontakt}</a>
        <a class="guzik guzik--drugi" href="/cena/#kalkulator">{przyciskKalkulator}</a>
      </div>
    </div>

    <div class="usluga__uklad">
      <div class="usluga__tresc">
        {coDostajesz.length > 0 && (
          <section class="usluga__sekcja" id="co-dostajesz" aria-labelledby="co-dostajesz-h">
            {napis('coDostajeszEtykieta', '') && <p class="etykieta">{napis('coDostajeszEtykieta', '')}</p>}
            <h2 id="co-dostajesz-h">{napis('coDostajeszNaglowek', 'Co dostajesz')}</h2>
            <ul class="usluga__lista">
              {coDostajesz.map((p) => (
                <li>
                  <svg class="usluga__haczyk" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <span>{czesci(p).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {sekcje.map((s) => (
          <section class="usluga__sekcja" id={s.id} aria-labelledby={`${s.id}-h`}>
            <h2 id={`${s.id}-h`}>{s.naglowek}</h2>
            {s.akapity.map((a) => <p>{czesci(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
            {s.punkty.length > 0 && (
              <ul class="usluga__punkty">
                {s.punkty.map((p) => <li>{czesci(p).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</li>)}
              </ul>
            )}
            {s.kolumny.length > 0 && (
              <div class="usluga__kolumny">
                {s.kolumny.map((k) => (
                  <div>
                    <h3>{k.naglowek}</h3>
                    <dl>
                      {k.pozycje.map((p) => (
                        <>
                          <dt>{p.nazwa}</dt>
                          <dd>{czesci(p.opis).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</dd>
                        </>
                      ))}
                    </dl>
                  </div>
                ))}
              </div>
            )}
            {s.tabela && (
              <div class="usluga__tabela" role="region" aria-labelledby={`${s.id}-h`} tabindex="0">
                <table class="tabela-karty">
                  {s.tabela.podpis && <caption>{s.tabela.podpis}</caption>}
                  <thead>
                    <tr>{s.tabela.kolumny.map((k) => <th scope="col">{k}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.tabela.wiersze.map((w) => (
                      <tr>
                        {w.map((komorka, j) =>
                          j === 0 ? <th scope="row">{komorka}</th> : <td data-label={s.tabela!.kolumny[j]}>{zKwotami(komorka)}</td>,
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.akapityPo.map((a) => <p>{czesci(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
          </section>
        ))}

        {aiPytania.length > 0 && (
          <section class="usluga__sekcja" id="gotowosc-ai" aria-labelledby="gotowosc-ai-h">
            <h2 id="gotowosc-ai-h">{napis2(ai.naglowek, 'Czy Twoja strona jest gotowa na asystentów AI')}</h2>
            {napisy(ai.akapity).map((a) => <p>{czesci(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
            <ol class="usluga__ai">
              {aiPytania.map((p) => (
                <li>
                  <h3>{p.pytanie}</h3>
                  <p>{czesci(p.opis).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>
                  {p.narzedzie && <p class="usluga__narzedzie">Sprawdź: <a href={p.narzedzie.adres}>{p.narzedzie.nazwa}</a></p>}
                </li>
              ))}
            </ol>
            {napisy(ai.akapityPo).map((a) => <p>{czesci(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
          </section>
        )}

        {przyklady.length > 0 && (
          <section class="usluga__sekcja usluga__przyklady" id="przyklady" aria-labelledby="przyklady-h">
            <h2 id="przyklady-h">{napis('przykladyNaglowek', 'Przykłady')}</h2>
            {napis('przykladyLead', '') && <p>{czesci(napis('przykladyLead', '')).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>}
            <ul class="usluga__siatka">
              {przyklady.map((p) => (
                <li class="usluga__karta karta">
                  {p.obrazek && (
                    <Image
                      src={p.obrazek}
                      alt={p.alt}
                      widths={[400, 640, 960]}
                      sizes="(min-width: 64rem) 17rem, (min-width: 40rem) 45vw, 92vw"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="usluga__karta-tresc">
                    <h3>{p.nazwa}</h3>
                    {p.zdanie && <p>{p.zdanie}</p>}
                    {p.wynik && (
                      <p class="usluga__wynik">
                        PageSpeed, wydajność: telefon <strong>{p.wynik.tel}</strong>, komputer <strong>{p.wynik.komp}</strong>
                        {p.wynik.data && <> (pomiar {p.wynik.data})</>}
                      </p>
                    )}
                    <a class="usluga__domena" href={p.adres} target="_blank" rel="noopener">{p.domena}<span class="sr-only"> (otwiera się w nowej karcie)</span></a>
                  </div>
                </li>
              ))}
            </ul>
            <div class="usluga__przyciski">
              <a class="guzik" href="/kontakt/">{przyciskKontakt}</a>
              <a class="guzik guzik--drugi" href="/cena/#kalkulator">{przyciskKalkulator}</a>
            </div>
          </section>
        )}

        {proces.length > 0 && (
          <section class="usluga__sekcja" id="krok-po-kroku" aria-labelledby="krok-po-kroku-h">
            {napis('procesEtykieta', '') && <p class="etykieta">{napis('procesEtykieta', '')}</p>}
            <h2 id="krok-po-kroku-h">{napis('procesNaglowek', 'Jak pracujemy')}</h2>
            {napis('procesLead', '') && <p>{czesci(napis('procesLead', '')).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>}
            <ol class="usluga__kroki">
              {proces.map((k, i) => (
                <li>
                  <span class="numer-kroku" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{k.nazwa}</h3>
                    {k.my && <p><strong>My:</strong> {czesci(k.my).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>}
                    {k.ty && <p><strong>Ty:</strong> {czesci(k.ty).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {wideo && (
          <section class="usluga__sekcja" id="wideo" aria-labelledby="wideo-h">
            <h2 id="wideo-h">{napis('wideoNaglowek', 'Film')}</h2>
            <p><a href={wideo} target="_blank" rel="noopener">Obejrzyj film w serwisie YouTube<span class="sr-only"> (otwiera się w nowej karcie)</span></a></p>
          </section>
        )}

        {nieObiecujemyAkapity.length > 0 && (
          <section class="usluga__sekcja" id="czego-nie-obiecujemy" aria-labelledby="czego-nie-obiecujemy-h">
            {naTekst(nieObiecujemy.etykieta) && <p class="etykieta">{naTekst(nieObiecujemy.etykieta)}</p>}
            <h2 id="czego-nie-obiecujemy-h">{napis2(nieObiecujemy.naglowek, 'Czego nie obiecujemy')}</h2>
            <div class="ramka-w-skrocie">
              {nieObiecujemyAkapity.map((a) => <p>{czesci(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
            </div>
          </section>
        )}

        {pytania.length > 0 && (
          <section class="usluga__sekcja" id="pytania" aria-labelledby="pytania-h">
            <h2 id="pytania-h">{napis('pytaniaNaglowek', 'Pytania')}</h2>
            {pytania.map((p) => (
              <details class="usluga__pytanie" name="usluga">
                <summary><h3>{p.pytanie}</h3></summary>
                <div class="usluga__odpowiedz">
                  {p.odpowiedz
                    .split(/\n\s*\n/)
                    .map((a) => a.trim())
                    .filter(Boolean)
                    .map((a) => <p>{czesci(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
                </div>
              </details>
            ))}
          </section>
        )}

        {zobaczTez.length > 0 && (
          <nav class="usluga__sekcja usluga__zobacz" aria-labelledby="zobacz-tez">
            <h2 id="zobacz-tez">{napis('zobaczTezNaglowek', 'Zobacz też')}</h2>
