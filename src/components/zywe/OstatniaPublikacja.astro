---
// Ż3 OstatniaPublikacja — "Ostatnia publikacja: N minut temu". W HTML zawsze data builda (strona powstaje
// przy każdej publikacji, więc to prawie ta sama chwila); /zywe/publikacja.js podmienia ją na czas
// ostatniego commita z publicznego API GitHuba. Błąd albo limit API = zostaje data z builda.
interface Props {
  /** Czas builda (ISO). Domyślnie chwila renderowania strony. */
  zbudowano?: string;
}
const { zbudowano = new Date().toISOString() } = Astro.props;
const dataBuilda = new Intl.DateTimeFormat('pl-PL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Warsaw',
}).format(new Date(zbudowano));
---

<p class="publikacja" data-publikacja>
  <span class="publikacja__kropka" aria-hidden="true"></span>
  Ostatnia publikacja: <time datetime={zbudowano}>{dataBuilda}</time>
</p>
<script is:inline src="/zywe/publikacja.js" defer></script>
<!-- is:inline: plik z public/ (stały adres), defer; bez JS zostaje data builda. -->

<style>
  .publikacja {
    display: inline-flex;
    align-items: center;
    gap: var(--o-2);
    min-height: 1.5rem;
    margin: 0;
    font-size: var(--t-xs);
    color: inherit;
    font-variant-numeric: tabular-nums;
  }

  /* Kropka "na żywo": stała, bez pulsowania. Kolor dekoracyjny, treść niesie tekst. */
  .publikacja__kropka {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--akcent-jasny, #1f8a6c);
  }
</style>
