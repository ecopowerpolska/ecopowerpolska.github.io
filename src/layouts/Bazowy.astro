---
// Bazowy.astro — jedyny layout strony.
// Świadomie BEZ <ClientRouter />: to komponent kliencki, a guard.config.json deklaruje
// całą witrynę jako zero-JS. Przy jednej trasie nie ma między czym przechodzić.
import '../styles/motyw.css';
import { Font } from 'astro:assets';
import strona from '../data/strona.json';
import { tekst } from '../lib/tekst';

interface Props {
  tytul: string;
  opis: string;
}

const { tytul, opis } = Astro.props;

// Napisy z panelu. `tekst()` oddaje wartość domyślną, gdy pole zostanie wyczyszczone —
// strona bez linku pomijania albo bez og:site_name to strata, nie decyzja redakcyjna.
const nazwaWitryny = tekst(strona.nazwaWitryny, 'EcoPower Polska');
const linkPomijania = tekst(strona.linkPomijania, 'Przejdź do treści');

// Kanoniczny adres budujemy z import.meta.env.SITE — dawne globalne pole `site`
// na obiekcie Astro zostało usunięte w Astro 6 (reguła AG022 walidatora).
const kanoniczny = new URL(Astro.url.pathname, import.meta.env.SITE);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <link rel="canonical" href={kanoniczny} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nazwaWitryny} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={kanoniczny} />

    {/* Jeden kolor, bez wariantu ciemnego (D1). Wartość = --tlo z motyw.css. */}
    <meta name="theme-color" content="#f4f5f1" />

    {/* Fonts API (Astro 6+, wbudowane) — NIGDY @fontsource, NIGDY <link> do Google
        Fonts (AG013/AG028). Rodziny zadeklarowane w astro.config.mjs (`fonts: [...]`);
        `preload` na obu, bo obie są używane nad foldem (nagłówek serifem, reszta
        paska i hero groteskiem) — żadna nie jest opcjonalna dla pierwszego malowania. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />

    {/* Ikona zakładki: sam kwadrat EP z logo firmowego, wycięty z pliku Piotra
        (wybór Piotra 2026-09-07). Na jasnym kaflu w kolorze tła strony, nie na
        przezroczystości — grafitowy znak na przezroczystym tle znika w ciemnym
        motywie przeglądarki. Dwa rozmiary: 32 px odrysowany osobno, żeby cienkie
        kreski ramki nie rozmyły się przy zmniejszaniu z 512.
        Bez tego wpisu przeglądarka pyta o /favicon.ico i dostaje 404. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    {/* Nazwa pliku to sitemap.xml, nie sitemap-index.xml — hak astro:build:done
        w astro.config.mjs zmienia nazwę po buildzie. */}
    <link rel="sitemap" href="/sitemap.xml" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#tresc">{linkPomijania}</a>
    <slot />
  </body>
</html>
