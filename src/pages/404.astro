---
// 404.astro → buduje się do 404.html; GitHub Pages podaje ten plik przy nietrafionym adresie.
// Własnej strony 500 na witrynie statycznej NIE MA i nie obiecujemy jej (potwor-astro §D).
//
// Pasek marki (PasekMarki) wspólny z index.astro — tożsamość ma być widoczna także
// tu, nie tylko na trasie ze spisem serwisów. Bez licznika serwisów: to informacja
// właściwa dla strony ze spisem, nie dla strony błędu.
import Bazowy from '../layouts/Bazowy.astro';
import PasekMarki from '../components/PasekMarki.astro';
import Stopka from '../components/Stopka.astro';
import teksty from '../data/strona-404.json';
import { tekst } from '../lib/tekst';

// Komplet napisów strony błędu z panelu. Wartości domyślne = dzisiejszy stan strony:
// wyczyszczenie pola w panelu nie może zostawić 404 bez nagłówka ani bez drogi powrotu.
const tytulKarty = tekst(teksty.tytulKarty, 'Nie ma takiej strony — EcoPower Polska');
const opisWyszukiwarki = tekst(
  teksty.opisWyszukiwarki,
  'Pod tym adresem nic nie ma. Wróć na stronę główną z listą serwisów EcoPower Polska.'
);
const naglowek = tekst(teksty.naglowek, 'Nie ma takiej strony');
const trescStrony = tekst(teksty.tekst, 'Pod tym adresem nic nie ma.');
const linkPowrotu = tekst(teksty.linkPowrotu, 'Wróć na stronę główną z listą serwisów');
---

<Bazowy tytul={tytulKarty} opis={opisWyszukiwarki}>
  <PasekMarki />

  <main id="tresc" class="tresc">
    <h1>{naglowek}</h1>
    <p>{trescStrony}</p>
    <p><a href="/">{linkPowrotu}</a></p>
  </main>

  <Stopka />
</Bazowy>

<style>
  .tresc {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: var(--o-16) var(--o-6);
  }

  h1 {
    margin: 0 0 var(--o-4);
    font-size: var(--t-xl);
  }

  p {
    margin: 0 0 var(--o-3);
    max-width: var(--miara);
    color: var(--tekst-cichy);
  }

  a {
    color: var(--akcent);
  }

  a:hover {
    color: var(--tekst);
  }
</style>
