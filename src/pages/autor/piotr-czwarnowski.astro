---
// /autor/piotr-czwarnowski/ — strona autora: zdjęcie | tekst, jak pracuję, przykładowe strony z wynikami PSI,
// dowody do sprawdzenia, wpisy autora. Treść: src/data/autor.json; strony: serwisy.json + pomiary.json (tylko odczyt).
// JSON-LD: ProfilePage + Person z trwałym @id (ten sam w BlogPosting.author). Zero JS.
import { Image } from 'astro:assets';
import Bazowy from '../../layouts/Bazowy.astro';
import PasekMarki from '../../components/PasekMarki.astro';
import Stopka from '../../components/Stopka.astro';
import autor from '../../data/autor.json';
import firma from '../../data/firma.json';
import serwisy from '../../data/serwisy.json';
import pomiary from '../../data/pomiary.json';
import zdjecie from '../../assets/blog/autor-piotr-czwarnowski.jpg';
import { tekst } from '../../lib/tekst';
import { opublikowane, adresWpisu, dataPoPolsku } from '../../lib/wpisy';

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adresStrony = `${baza}${autor.adres}`;
const idOsoby = `${adresStrony}#osoba`;

// Pomiar jednej strony; format pliku może dostać historię (Ż), więc czytamy ostrożnie.
type Wariant = { wydajnosc?: number; data?: string };
type Pomiar = { data?: string; mobile?: Wariant; desktop?: Wariant };
const pomiarDla = (adres: string): Pomiar | null =>
  ((pomiary as { pomiary?: Record<string, Pomiar> }).pomiary?.[adres] ?? null);

const strony = serwisy.serwisy
  .filter((s) => !s.ukryty && s.adres && (s as { przyklad?: boolean }).przyklad === true)
  .map((s) => {
    const p = pomiarDla(s.adres);
    return {
      nazwa: s.nazwa,
      adres: s.adres,
      domena: s.adres.replace(/^https?:\/\//, '').replace(/\/$/, ''),
      branza: s.opis ?? '',
      telefon: p?.mobile?.wydajnosc,
      komputer: p?.desktop?.wydajnosc,
      psi: `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(s.adres)}`,
    };
  })
  ;

const wpisy = (await opublikowane())
  .filter((w) => w.data.autor === autor.imie)
  .map((w) => ({
    tytul: w.data.tytul,
    adres: adresWpisu(w.id),
    iso: w.data.dataPublikacji!.toISOString(),
    data: dataPoPolsku(w.data.dataPublikacji!),
  }));

// {krs} i {nip} w tekście dowodu podstawiamy z firma.json — jedno źródło danych spółki.
const podstaw = (t: string) => t.replace('{krs}', firma.krs).replace('{nip}', firma.nip);

const obrazAdres = new URL(zdjecie.src, import.meta.env.SITE).href;
const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${adresStrony}#strona`,
      url: adresStrony,
      name: tekst(autor.tytulKarty, autor.imie),
      inLanguage: 'pl-PL',
      mainEntity: { '@id': idOsoby },
      isPartOf: { '@type': 'WebSite', url: `${baza}/` },
    },
    {
      '@type': 'Person',
      '@id': idOsoby,
      name: autor.imie,
      url: adresStrony,
      image: obrazAdres,
      worksFor: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
      knowsAbout: autor.knowsAbout,
      // Profile zewnętrzne wpisuje Piotr; puste pole nie trafia do danych.
      ...(autor.sameAs.length > 0 ? { sameAs: autor.sameAs } : {}),
    },
  ],
};
---

<Bazowy tytul={tekst(autor.tytulKarty, autor.imie)} opis={tekst(autor.opisWyszukiwarki, '')} obrazOg={obrazAdres}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="autor">
    <section class="autor__glowa">
      <div class="autor__zdjecie-ramka">
        <Image
          class="autor__zdjecie"
          src={zdjecie}
          alt={autor.zdjecieAlt}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 56rem) 24rem, 14rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="autor__tekst">
        <p class="etykieta">{tekst(autor.podtytul, '')}</p>
        <h1 class="autor__imie">{tekst(autor.naglowek, autor.imie)}</h1>
        <p class="autor__wstep">{autor.wstep.join(' ')}</p>
        <a class="guzik" href="/kontakt/">{tekst(autor.guzik, 'Napisz do nas')}</a>
      </div>
    </section>

    <section class="autor__sekcja" aria-labelledby="jak-pracuje">
      <h2 id="jak-pracuje" class="autor__h2 autor__h2--srodek">{tekst(autor.jakPracujeNaglowek, 'Jak pracujemy')}</h2>
      <ul class="siatka-3 autor__zasady">
        {
          autor.jakPracuje.map((z) => (
            <li class="karta autor__zasada">
              <h3>{z.tytul}</h3>
              <p>{z.tekst}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      strony.length > 0 && (
        <section class="autor__sekcja" aria-labelledby="zbudowane">
          <h2 id="zbudowane" class="autor__h2">{tekst(autor.realizacjeNaglowek, 'Przykładowe strony')}</h2>
          <p class="autor__metoda">
            {autor.realizacjeMetoda} <a href={autor.realizacjeMetodaAdres}>{autor.realizacjeMetodaLink}</a>.
          </p>
          <table class="tabela-karty autor__tabela">
            <thead>
              <tr>
                <th scope="col">Strona</th>
                <th scope="col">Branża</th>
                <th scope="col">PageSpeed, telefon</th>
                <th scope="col">PageSpeed, komputer</th>
                <th scope="col">Sprawdź sam</th>
              </tr>
            </thead>
            <tbody>
              {strony.map((s) => (
                <tr>
                  <th scope="row" data-label="Strona">
                    <a href={s.adres}>{s.domena}</a>
                  </th>
                  <td data-label="Branża">{s.branza}</td>
                  {typeof s.telefon === 'number' ? (
                    <>
                      <td data-label="PageSpeed, telefon"><span class="autor__liczba">{s.telefon}</span></td>
                      <td data-label="PageSpeed, komputer"><span class="autor__liczba">{s.komputer ?? '—'}</span></td>
                    </>
                  ) : (
                    <td data-label="PageSpeed" colspan="2">pomiar w toku</td>
                  )}
                  <td data-label="Sprawdź sam">
                    <a href={s.psi} rel="noopener">zmierz<span class="sr-only"> {s.domena} w PageSpeed Insights</span></a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    <section class="autor__sekcja" aria-labelledby="sprawdz">
      <h2 id="sprawdz" class="autor__h2">{tekst(autor.sprawdzNaglowek, 'Sprawdź, zanim zapytasz')}</h2>
      <dl class="autor__dowody">
        {
          autor.sprawdz.map((d) => (
            <div class="autor__dowod">
              <dt>{d.twierdzenie}</dt>
              <dd>
                {podstaw(d.dowod)}
                {d.adres && (
                  <>
                    {' '}
                    <a href={d.adres}>{d.link}</a>
                  </>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      wpisy.length > 0 && (
        <section class="autor__sekcja" aria-labelledby="wpisy">
          <h2 id="wpisy" class="autor__h2">{tekst(autor.wpisyNaglowek, 'Nasze wpisy')}</h2>
          <ul class="autor__wpisy">
            {wpisy.map((w) => (
              <li>
                <a href={w.adres}>{w.tytul}</a> <time datetime={w.iso}>{w.data}</time>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="autor__koniec"><a class="guzik" href="/kontakt/">{tekst(autor.guzik, 'Napisz do nas')}</a></p>
  </main>

  <Stopka />
</Bazowy>

<style>
  .autor {
    max-width: var(--szerokosc-tresci);
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    padding: var(--o-12) var(--o-4) var(--o-16);
  }

  @media (min-width: 48rem) {
    .autor {
      padding-inline: var(--o-6);
    }
  }

  /* Zdjęcie 1/3 | tekst 2/3 od 56rem; na telefonie zdjęcie nad tekstem. */
  .autor__glowa {
    display: grid;
    gap: var(--o-8);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .autor__glowa {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--o-12);
    }
  }

  /* Na telefonie zdjęcie mniejsze, żeby imię i tekst weszły w pierwszy ekran. */
  .autor__zdjecie-ramka {
    max-width: 14rem;
  }

  @media (min-width: 56rem) {
    .autor__zdjecie-ramka {
      max-width: 24rem;
    }
  }

  /* Proporcja pliku (1:1), ramka 1 px + cień. */
  .autor__zdjecie {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--linia);
    border-radius: var(--promien-karty, var(--promien));
    box-shadow: var(--cien-karty, none);
  }

  .autor__imie {
    margin: var(--o-2) 0 var(--o-6);
    font-size: var(--t-display, clamp(2.75rem, 1.6rem + 4.6vw, 6rem));
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .autor__wstep {
    margin: 0 0 var(--o-8);
    max-width: 44rem;
    font-size: var(--t-l);
    line-height: 1.55;
  }

  .autor__sekcja {
    margin-top: var(--o-16);
  }

  .autor__h2 {
    margin: 0 0 var(--o-6);
    font-size: var(--t-h2, clamp(1.75rem, 1rem + 2vw, 2.5rem));
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .autor__h2--srodek {
    text-align: center;
  }

  .autor__zasady {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .autor__zasada {
    padding: var(--o-6);
  }

  .autor__zasada h3 {
    margin: 0 0 var(--o-2);
    font-size: var(--t-l);
  }

  .autor__zasada p {
    margin: 0;
    line-height: 1.55;
  }

  .autor__metoda {
    margin: 0 0 var(--o-6);
    max-width: 44rem;
  }

  .autor a:not(.guzik) {
    color: var(--akcent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .autor a:not(.guzik):hover {
    color: var(--tekst);
  }

  .autor__tabela {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    font-size: var(--t-s);
  }

  .autor__tabela :is(th, td) {
    padding: var(--o-3);
    border-bottom: 1px solid var(--linia);
    text-align: left;
    vertical-align: top;
  }

  .autor__tabela thead th {
    background: var(--powierzchnia);
  }

  .autor__liczba {
    font-size: var(--t-l);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--akcent);
  }

  .autor__dowody {
    margin: 0;
    display: grid;
    gap: var(--o-4);
  }

  .autor__dowod {
    padding: var(--o-4) var(--o-6);
    border-left: 3px solid var(--akcent);
    background: var(--powierzchnia);
    border-radius: var(--promien);
  }

  .autor__dowod dt {
    font-weight: 700;
  }

  .autor__dowod dd {
    margin: var(--o-1) 0 0;
    line-height: 1.55;
  }

  .autor__wpisy {
    margin: 0;
    padding-left: var(--o-6);
  }

  .autor__wpisy li + li {
    margin-top: var(--o-3);
  }

  .autor__wpisy time {
    color: var(--tekst-cichy);
    font-size: var(--t-s);
  }

  .autor__koniec {
    margin: var(--o-16) 0 0;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
