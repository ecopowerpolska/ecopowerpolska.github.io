---
// Jeden wpis bloga: /blog/<id>/ → dist/blog/<id>/index.html. Adres dostają wyłącznie wpisy z opublikowane() (src/lib/wpisy.ts).
// Treść Markdown renderuje Astro 7 domyślnym procesorem, bez wtyczek. Wzorzec: pan-stolarz.pl src/pages/blog/[slug].astro,
// uproszczony do jednej trasy statycznej na GitHub Pages. Okruszki widoczne = BreadcrumbList w JSON-LD, wpis = BlogPosting.
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Bazowy from '../../layouts/Bazowy.astro';
import PasekMarki from '../../components/PasekMarki.astro';
import Stopka from '../../components/Stopka.astro';
import teksty from '../../data/blog.json';
import firma from '../../data/firma.json';
import { tekst } from '../../lib/tekst';
import { opublikowane, adresWpisu, dataPoPolsku, plikObrazu } from '../../lib/wpisy';

export async function getStaticPaths() {
  const wpisy = await opublikowane();
  // „Czytaj także”: dwa inne wpisy, od najnowszego (lista już posortowana w opublikowane()).
  return wpisy.map((wpis) => ({
    params: { slug: wpis.id },
    props: {
      wpis,
      inne: wpisy
        .filter((w) => w.id !== wpis.id)
        .slice(0, 2)
        .map((w) => ({ tytul: w.data.tytul, adres: adresWpisu(w.id), iso: w.data.dataPublikacji!.toISOString(), data: dataPoPolsku(w.data.dataPublikacji!) })),
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { wpis, inne } = Astro.props as Props;
const dane = wpis.data;
const { Content } = await render(wpis);

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adres = `${baza}${adresWpisu(wpis.id)}`;
const opublikowano = dane.dataPublikacji!.toISOString();
// Czas czytania: słowa treści bez składni Markdown, 200 słów na minutę, co najmniej 1 minuta.
const slowa = (wpis.body ?? '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\]\([^)]*\)/g, ' ')
  .split(/\s+/)
  .filter((w) => /[\p{L}\d]/u.test(w)).length;
const minuty = Math.max(1, Math.round(slowa / 200));

// Brak pliku zdjęcia nie zatrzymuje builda, ale jest widoczny w dzienniku.
const obraz = plikObrazu(dane.zdjecie);
if (dane.zdjecie && !obraz) console.warn(`[wpis ${wpis.id}] zdjęcie ${dane.zdjecie} nie ma pliku w src/assets — wpis bez zdjęcia`);
// Udostępnienie na Facebooku: zwykły odnośnik do sharera z kanonicznym adresem wpisu, bez skryptów Meta i bez śledzenia.
const udostepnijAdres = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(adres)}`;
const obrazAdres = obraz ? new URL(obraz.src, import.meta.env.SITE).href : undefined;

const nazwaBlogu = tekst(teksty.naglowek, 'Blog');
const okruszki = [
  { nazwa: tekst(teksty.stronaGlowna, 'Strona główna'), adres: '/' },
  { nazwa: nazwaBlogu, adres: '/blog/' },
  { nazwa: dane.tytul, adres: adresWpisu(wpis.id) },
];

const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${adres}#wpis`,
      headline: dane.tytul,
      description: dane.opisSeo || undefined,
      datePublished: opublikowano,
      dateModified: opublikowano,
      inLanguage: 'pl-PL',
      mainEntityOfPage: adres,
      image: obrazAdres,
      author: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
      publisher: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
      isPartOf: { '@type': 'Blog', '@id': `${baza}/blog/#blog` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: o.nazwa,
        item: `${baza}${o.adres}`,
      })),
    },
  ],
};
---

<Bazowy tytul={dane.tytulSeo} opis={dane.opisSeo || dane.tytul} typOg="article" obrazOg={obrazAdres}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="wpis">
    <nav class="okruszki" aria-label={tekst(teksty.okruszkiEtykieta, 'Ścieżka')}>
      <ol>
        {/* Widoczne dwa pierwsze ogniwa; tytuł wpisu stoi tuż niżej jako H1 (pełna ścieżka w BreadcrumbList). */}
        {okruszki.slice(0, -1).map((o) => (
          <li>
            <a href={o.adres}>{o.nazwa}</a>
          </li>
        ))}
      </ol>
    </nav>

    <article>
      <h1 class="wpis__tytul">{dane.tytul}</h1>
      <p class="wpis__data">
        <time datetime={opublikowano}>{dataPoPolsku(dane.dataPublikacji!)}</time>{' · '}{minuty} min czytania{' · '}{firma.nazwaKrotka}
      </p>

      {/* Jedyny obraz z priorytetem (kandydat na LCP); kadr 3:2 z CSS rezerwuje miejsce. */}
      {obraz && (
        <Image
          class="wpis__zdjecie"
          src={obraz}
          alt={dane.zdjecieAlt}
          widths={[480, 720, 1080, 1440]}
          width={1440}
          height={900}
          fit="cover"
          sizes="(min-width: 56rem) 52rem, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
        />
      )}

      <div class="wpis__tresc">
        <Content />
      </div>

      <p class="wpis__udostepnij">
        <a class="wpis__facebook" href={udostepnijAdres} target="_blank" rel="noopener noreferrer">
          {tekst(teksty.udostepnij, 'Udostępnij na Facebooku')}
          <span class="sr-only"> {tekst(teksty.udostepnijNowaKarta, '(otwiera się w nowej karcie)')}</span>
        </a>
      </p>
    </article>

    <nav class="wpis__dalej" aria-labelledby="czytaj-takze">
      {inne.length > 0 && (
        <>
          <h2 id="czytaj-takze" class="wpis__dalej-tytul">Czytaj także</h2>
          <ul class="wpis__dalej-lista">
            {inne.map((w) => (
              <li>
                <a class="wpis__dalej-karta" href={w.adres}>
                  <span class="wpis__dalej-nazwa">{w.tytul}</span>
                  <time class="wpis__dalej-data" datetime={w.iso}>{w.data}</time>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
      <p class="wpis__powrot"><a href="/blog/">{tekst(teksty.wszystkie, 'Wszystkie wpisy')}</a></p>
    </nav>
  </main>

  <Stopka />
</Bazowy>

<style>
  /* Wpis = wyśrodkowana kolumna czytania 42 rem (ok. 70 znaków) w kontenerze strony; zdjęcia szersze, do 52 rem.
     Gutter 16 px na telefonie, 24 px od 48 rem. */
  .wpis {
    max-width: var(--szerokosc-tresci);
    width: 100%;
    margin: 0 auto;
    padding: var(--o-8) var(--o-4) var(--o-16);
  }

  @media (min-width: 48rem) {
    .wpis {
      padding-inline: var(--o-6);
    }
  }

  .okruszki,
  .wpis__tytul,
  .wpis__data,
  .wpis__tresc > :global(*),
  .wpis__udostepnij,
  .wpis__dalej {
    max-width: 42rem;
    margin-inline: auto;
  }

  .okruszki ol {
    list-style: none;
    margin: 0 0 var(--o-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--o-2);
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  .okruszki li {
    display: inline-flex;
    align-items: center;
  }

  .okruszki li + li::before {
    content: '›';
    margin-right: var(--o-2);
  }

  .okruszki a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .okruszki a {
    color: var(--akcent);
  }

  .okruszki a:hover {
    color: var(--tekst);
  }

  .wpis__tytul {
    font-size: clamp(var(--t-xl), 3vw + 1rem, var(--t-xxl));
    text-wrap: balance;
  }

  .wpis__data {
    margin-top: var(--o-4);
    margin-bottom: var(--o-8);
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Zdjęcie otwierające szersze niż tekst; kadr 16:10 = proporcja zrzutów stron, bez obcinania. */
  .wpis__zdjecie {
    display: block;
    width: 100%;
    max-width: 52rem;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: 0 auto var(--o-12);
    border: 1px solid var(--linia);
    border-radius: var(--promien);
  }

  /* Proza z Markdownu: znaczniki bez klas, stąd :global wewnątrz kontenera. */
  .wpis__tresc {
    overflow-wrap: break-word;
    line-height: 1.7;
  }

  /* Pierwszy akapit = lead, stopień większy. */
  .wpis__tresc > :global(p:first-child) {
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--tekst);
  }

  .wpis__tresc :global(h2) {
    margin-top: var(--o-12);
    margin-bottom: var(--o-4);
    font-size: var(--t-xl);
    line-height: 1.2;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .wpis__tresc :global(h2) {
      margin-top: var(--o-16);
    }
  }

  .wpis__tresc :global(p) {
    margin-top: 0;
    margin-bottom: var(--o-6);
  }

  .wpis__tresc :global(:is(ul, ol)) {
    margin-top: 0;
    margin-bottom: var(--o-6);
    padding-left: var(--o-6);
  }

  .wpis__tresc :global(li + li) {
    margin-top: var(--o-3);
  }

  .wpis__tresc :global(strong) {
    font-weight: 600;
  }

  /* Zdjęcie w treści z podpisem (wtyczka zdjeciaZPodpisem w astro.config.mjs): szersze niż tekst, wyśrodkowane. */
  .wpis__tresc > :global(figure) {
    max-width: 52rem;
    margin-top: var(--o-8);
    margin-bottom: var(--o-12);
  }

  .wpis__tresc :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--linia);
    border-radius: var(--promien);
  }

  .wpis__tresc :global(figcaption) {
    max-width: 42rem;
    margin: var(--o-3) auto 0;
    font-size: var(--t-s);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  .wpis__tresc :global(a) {
    color: var(--akcent);
    /* Link w zdaniu musi się różnić nie tylko kolorem (akcent do tekstu 2,44:1 < 3:1, PSI link-in-text-block). */
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wpis__tresc :global(a:hover) {
    color: var(--tekst);
  }

  /* Odnośnik z obrysem jak „Zapytaj o stronę” na stronie głównej: akcent na tle, cel dotyku 48 px. */
  .wpis__udostepnij {
    margin-top: var(--o-8);
    margin-bottom: 0;
  }

  .wpis__facebook {
    /* spoczynek */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--o-6);
    border: 2px solid var(--akcent);
    border-radius: var(--promien);
    font-weight: 600;
    color: var(--akcent);
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  /* najechanie */
  .wpis__facebook:hover {
    background: var(--powierzchnia);
  }

  /* aktywny (wciśnięty) */
  .wpis__facebook:active {
    transform: translateY(1px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .wpis__facebook {
      transition: none;
    }
  }

  /* „Czytaj także” i powrót: w kolumnie wpisu, karty jak na liście bloga (wypełnienie, promień z motywu). */
  .wpis__dalej {
    margin-top: var(--o-12);
    padding-top: var(--o-8);
    border-top: 1px solid var(--linia);
  }

  .wpis__dalej-tytul {
    margin-bottom: var(--o-4);
    font-size: var(--t-l);
  }

  .wpis__dalej-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--o-4);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .wpis__dalej-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .wpis__dalej-karta {
    /* spoczynek */
    display: flex;
    flex-direction: column;
    gap: var(--o-2);
    height: 100%;
    min-height: 44px;
    padding: var(--o-4) var(--o-6);
    background: var(--powierzchnia);
    border-radius: var(--promien);
    color: var(--tekst);
    text-decoration: none;
  }

  /* najechanie */
  .wpis__dalej-karta:hover {
    text-decoration: none;
  }

  .wpis__dalej-karta:hover .wpis__dalej-nazwa {
    color: var(--akcent);
  }

  /* aktywny (wciśnięty) */
  .wpis__dalej-karta:active {
    transform: translateY(1px);
  }

  .wpis__dalej-nazwa {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-m);
    line-height: 1.3;
  }

  .wpis__dalej-data {
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  .wpis__powrot {
    margin: var(--o-6) 0 0;
  }

  .wpis__powrot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--akcent);
  }

  .wpis__powrot a:hover {
    color: var(--tekst);
  }
</style>
