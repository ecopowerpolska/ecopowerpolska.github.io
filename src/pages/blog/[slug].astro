---
// Jeden wpis bloga: /blog/<id>/ → dist/blog/<id>/index.html. Adres dostają wyłącznie wpisy z opublikowane() (src/lib/wpisy.ts).
// Treść Markdown renderuje Astro 7 domyślnym procesorem, bez wtyczek. Wzorzec: pan-stolarz.pl src/pages/blog/[slug].astro,
// uproszczony do jednej trasy statycznej na GitHub Pages. Okruszki widoczne = BreadcrumbList w JSON-LD, wpis = BlogPosting.
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Bazowy from '../../layouts/Bazowy.astro';
import PasekMarki from '../../components/PasekMarki.astro';
import Stopka from '../../components/Stopka.astro';
import teksty from '../../data/blog.json';
import firma from '../../data/firma.json';
import { tekst } from '../../lib/tekst';
import { opublikowane, adresWpisu, dataPoPolsku, plikObrazu } from '../../lib/wpisy';

export async function getStaticPaths() {
  const wpisy = await opublikowane();
  // „Czytaj także”: trzy inne wpisy, od najnowszego (lista już posortowana w opublikowane()); 3 karty w rzędzie na pełną szerokość.
  return wpisy.map((wpis) => ({
    params: { slug: wpis.id },
    props: {
      wpis,
      inne: wpisy
        .filter((w) => w.id !== wpis.id)
        .slice(0, 3)
        .map((w) => ({
          tytul: w.data.tytul,
          adres: adresWpisu(w.id),
          zajawka: w.data.opisSeo,
          iso: w.data.dataPublikacji!.toISOString(),
          data: dataPoPolsku(w.data.dataPublikacji!),
          obraz: plikObrazu(w.data.zdjecie),
        })),
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { wpis, inne } = Astro.props as Props;
const dane = wpis.data;
const { Content, headings } = await render(wpis);
// Spis sekcji w pasku bocznym: nagłówki H2 (id nadaje procesor Markdown, to samo `slug`).
const sekcje = headings.filter((h) => h.depth === 2);

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adres = `${baza}${adresWpisu(wpis.id)}`;
const opublikowano = dane.dataPublikacji!.toISOString();
// Czas czytania: słowa treści bez składni Markdown, 200 słów na minutę, co najmniej 1 minuta.
const slowa = (wpis.body ?? '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\]\([^)]*\)/g, ' ')
  .split(/\s+/)
  .filter((w) => /[\p{L}\d]/u.test(w)).length;
const minuty = Math.max(1, Math.round(slowa / 200));

// Brak pliku zdjęcia nie zatrzymuje builda, ale jest widoczny w dzienniku.
const obraz = plikObrazu(dane.zdjecie);
if (dane.zdjecie && !obraz) console.warn(`[wpis ${wpis.id}] zdjęcie ${dane.zdjecie} nie ma pliku w src/assets — wpis bez zdjęcia`);
// Udostępnienie na Facebooku: zwykły odnośnik do sharera z kanonicznym adresem wpisu, bez skryptów Meta i bez śledzenia.
const udostepnijAdres = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(adres)}`;
const obrazAdres = obraz ? new URL(obraz.src, import.meta.env.SITE).href : undefined;

// Wpis bez sufiksu marki w <title> (decyzja sesji 2026-10-27, plan SEO §3 B): marka jest w og:site_name,
// okruszkach i JSON-LD `publisher`. Sufiks wpisany w panelu („ — EcoPower Polska”, „, EcoPower Polska”) zdejmujemy.
const marka = tekst(firma.nazwaKrotka, 'EcoPower Polska').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const tytulKarty = dane.tytulSeo.replace(new RegExp(`\\s*[—–|,-]\\s*${marka}\\s*$`), '').trim() || dane.tytul;

const nazwaBlogu = tekst(teksty.naglowek, 'Blog');
const okruszki = [
  { nazwa: tekst(teksty.stronaGlowna, 'Strona główna'), adres: '/' },
  { nazwa: nazwaBlogu, adres: '/blog/' },
  { nazwa: dane.tytul, adres: adresWpisu(wpis.id) },
];

const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${adres}#wpis`,
      headline: dane.tytul,
      description: dane.opisSeo || undefined,
      datePublished: opublikowano,
      dateModified: opublikowano,
      inLanguage: 'pl-PL',
      mainEntityOfPage: adres,
      image: obrazAdres,
      author: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
      publisher: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
      isPartOf: { '@type': 'Blog', '@id': `${baza}/blog/#blog` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: o.nazwa,
        item: `${baza}${o.adres}`,
      })),
    },
  ],
};
---

<Bazowy tytul={tytulKarty} opis={dane.opisSeo || dane.tytul} typOg="article" obrazOg={obrazAdres}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="wpis">
    <nav class="okruszki" aria-label={tekst(teksty.okruszkiEtykieta, 'Ścieżka')}>
      <ol>
        {/* Widoczne dwa pierwsze ogniwa; tytuł wpisu stoi tuż niżej jako H1 (pełna ścieżka w BreadcrumbList). */}
        {okruszki.slice(0, -1).map((o) => (
          <li>
            <a href={o.adres}>{o.nazwa}</a>
          </li>
        ))}
      </ol>
    </nav>

    <article>
      <h1 class="wpis__tytul">{dane.tytul}</h1>
      <p class="wpis__data">
        <time datetime={opublikowano}>{dataPoPolsku(dane.dataPublikacji!)}</time>{' · '}{minuty} min czytania{' · '}{firma.nazwaKrotka}
      </p>

      {/* Jedyny obraz z priorytetem (kandydat na LCP); kadr 3:2 z CSS rezerwuje miejsce. */}
      {obraz && (
        <Image
          class="wpis__zdjecie"
          src={obraz}
          alt={dane.zdjecieAlt}
          widths={[480, 720, 1080, 1440]}
          width={1440}
          height={900}
          fit="cover"
          sizes="(min-width: 76rem) 70rem, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
        />
      )}

      {/* Od 64rem: treść w lewym torze siatki, pasek boczny (spis sekcji + wezwanie) w prawym; lead (pierwszy akapit) na całą szerokość. */}
      <div class="wpis__uklad">
        <div class="wpis__tresc">
          <Content />
        </div>

        <p class="wpis__udostepnij">
          <a class="wpis__facebook" href={udostepnijAdres} target="_blank" rel="noopener noreferrer">
            {tekst(teksty.udostepnij, 'Udostępnij na Facebooku')}
            <span class="sr-only"> {tekst(teksty.udostepnijNowaKarta, '(otwiera się w nowej karcie)')}</span>
          </a>
        </p>

        <aside class="wpis__bok" aria-label={tekst(teksty.pasekBoczny, 'Do wpisu')}>
          {sekcje.length > 1 && (
            <nav class="wpis__spis" aria-labelledby="wpis-spis">
              <p id="wpis-spis" class="wpis__bok-tytul">{tekst(teksty.spisTytul, 'W tym wpisie')}</p>
              <ol>
                {sekcje.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
          <div class="wpis__wezwanie">
            <p class="wpis__bok-tytul">{tekst(teksty.wezwanieTytul, 'Planujesz stronę albo sklep?')}</p>
            <p>{tekst(teksty.wezwanieTekst, 'Opisz w kilku zdaniach, co ma powstać. Orientacyjną cenę policzysz sam w kalkulatorze.')}</p>
            <a class="wpis__guzik" href="/kontakt/">{tekst(teksty.wezwanieGuzik, 'Zapytaj o stronę')}</a>
            <a class="wpis__guzik wpis__guzik--cichy" href="/cena/">{tekst(teksty.wezwanieCena, 'Policz cenę')}</a>
          </div>
        </aside>
      </div>
    </article>

    <nav class="wpis__dalej" aria-labelledby="czytaj-takze">
      {inne.length > 0 && (
        <>
          <h2 id="czytaj-takze" class="wpis__dalej-tytul">{tekst(teksty.czytajTakze, 'Czytaj także')}</h2>
          <ul class="wpis__dalej-lista">
            {inne.map((w) => (
              <li>
                <a class="karta" href={w.adres}>
                  {w.obraz && (
                    <Image
                      class="karta__zdjecie"
                      src={w.obraz}
                      alt=""
                      widths={[360, 540, 720]}
                      width={720}
                      height={480}
                      fit="cover"
                      sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 36rem, calc(100vw - 2rem)"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="karta__tresc">
                    <h3 class="karta__tytul">{w.tytul}</h3>
                    <time class="karta__data" datetime={w.iso}>{w.data}</time>
                    {w.zajawka && <p class="karta__zajawka">{w.zajawka}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
      <p class="wpis__powrot"><a href="/blog/">{tekst(teksty.wszystkie, 'Wszystkie wpisy')}</a></p>
    </nav>
  </main>

  <Stopka />
</Bazowy>

<style>
  /* Wpis = pełna szerokość kontenera (76rem). H1, data i lead na środku; treść od 64rem w dwóch torach siatki:
     tekst (1fr) + pasek boczny 24rem (spis sekcji, wezwanie). Dlaczego nie kolumny gazetowe: patrz meldunek A (runda 7). */
  .wpis {
    max-width: var(--szerokosc-tresci);
    width: 100%;
    margin: 0 auto;
    padding: var(--o-8) var(--o-4) var(--o-16);
  }

  @media (min-width: 48rem) {
    .wpis {
      padding-inline: var(--o-6);
    }
  }

  .okruszki ol {
    list-style: none;
    margin: 0 0 var(--o-6);
    padding: 0;
    display: flex;
    gap: 0 var(--o-2);
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Jedna linia na każdej szerokości (D14): bieżąca strona skraca się wielokropkiem,
     pełny tytuł stoi tuż niżej w H1. */
  .okruszki li {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* contain: inline-size — długi tytuł nie poszerza strony (min-content = 0), dostaje resztę wiersza. */
  .okruszki li:last-child {
    flex: 1 1 0;
    min-width: 0;
    contain: inline-size;
  }

  .okruszki li:last-child > a {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 44px;
  }

  .okruszki [aria-current] {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 44px;
  }

  .okruszki li + li::before {
    content: '›';
    margin-right: var(--o-2);
  }

  .okruszki a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .okruszki a {
    color: var(--akcent);
  }

  .okruszki a:hover {
    color: var(--tekst);
  }

  .wpis__tytul {
    font-size: clamp(var(--t-xl), 3vw + 1rem, var(--t-xxl));
    text-wrap: balance;
    text-align: center;
  }

  .wpis__data {
    text-align: center;
    margin-top: var(--o-4);
    margin-bottom: var(--o-8);
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Zdjęcie otwierające na pełną szerokość kontenera; kadr 21:9 od góry (nagłówek zrzutu zostaje widoczny), 16:10 na telefonie. */
  .wpis__zdjecie {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    margin: 0 0 var(--o-8);
    border: 1px solid var(--linia);
    border-radius: var(--promien);
  }

  @media (min-width: 64rem) {
    .wpis__zdjecie {
      aspect-ratio: 21 / 9;
    }
  }

  /* Układ: telefon i tablet = jedna kolumna czytania (do 44rem, pasek boczny pod tekstem); komputer = siatka dwóch torów. */
  .wpis__uklad {
    display: block;
  }

  .wpis__tresc,
  .wpis__udostepnij {
    max-width: 44rem;
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    .wpis__uklad {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 24rem;
      column-gap: var(--o-12);
      align-items: start;
    }

    /* Elementy Markdownu stają się wprost komórkami siatki: lead może zająć obie kolumny, reszta lewą. */
    .wpis__tresc {
      display: contents;
      max-width: none;
    }

    .wpis__tresc > :global(*) {
      grid-column: 1;
      min-width: 0;
    }

    .wpis__udostepnij {
      grid-column: 1;
      max-width: none;
      margin-inline: 0;
      text-align: left;
    }

    /* Pasek od drugiego wiersza (pod leadem) przez wszystkie wiersze treści; wiersze puste mają wysokość 0 (row-gap 0). */
    .wpis__bok {
      grid-column: 2;
      grid-row: 2 / span 300;
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }

  /* Proza z Markdownu: znaczniki bez klas, stąd :global wewnątrz kontenera. */
  .wpis__tresc {
    overflow-wrap: break-word;
    line-height: 1.7;
  }

  /* Pierwszy akapit = lead, stopień większy, na środku (od 64rem na całą szerokość kontenera). */
  .wpis__tresc > :global(p:first-child) {
    text-align: center;
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--tekst);
  }

  @media (min-width: 64rem) {
    .wpis__tresc > :global(p:first-child) {
      grid-column: 1 / -1;
      max-width: 56rem;
      margin-inline: auto;
      margin-bottom: var(--o-12);
    }
  }

  .wpis__tresc :global(h2) {
    margin-top: var(--o-12);
    margin-bottom: var(--o-4);
    font-size: var(--t-xl);
    line-height: 1.2;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .wpis__tresc :global(h2) {
      margin-top: var(--o-16);
    }
  }

  .wpis__tresc :global(p) {
    margin-top: 0;
    margin-bottom: var(--o-6);
  }

  .wpis__tresc :global(:is(ul, ol)) {
    margin-top: 0;
    margin-bottom: var(--o-6);
    padding-left: var(--o-6);
  }

  .wpis__tresc :global(li + li) {
    margin-top: var(--o-3);
  }

  .wpis__tresc :global(strong) {
    font-weight: 600;
  }

  /* Zdjęcie w treści z podpisem (wtyczka zdjeciaZPodpisem w astro.config.mjs): na pełną szerokość kolumny tekstu. */
  .wpis__tresc > :global(figure) {
    margin: var(--o-8) 0 var(--o-12);
  }

  .wpis__tresc :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--linia);
    border-radius: var(--promien);
  }

  .wpis__tresc :global(figcaption) {
    margin: var(--o-3) 0 0;
    font-size: var(--t-s);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  /* Tabele z Markdownu (wpisy z porównaniami): przewijane w poziomie WEWNĄTRZ tabeli, nie strony; na komputerze w torze tekstu obok paska bocznego. */
  .wpis__tresc :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: var(--o-6) 0 var(--o-8);
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--t-s);
    line-height: 1.45;
  }

  .wpis__tresc :global(th),
  .wpis__tresc :global(td) {
    min-width: 9rem;
    padding: var(--o-2) var(--o-3);
    border-bottom: 1px solid var(--linia);
    text-align: left;
    vertical-align: top;
  }

  .wpis__tresc :global(th) {
    background: var(--powierzchnia);
    font-weight: 700;
  }

  .wpis__tresc :global(a) {
    color: var(--akcent);
    /* Link w zdaniu musi się różnić nie tylko kolorem (akcent do tekstu 2,44:1 < 3:1, PSI link-in-text-block). */
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wpis__tresc :global(a:hover) {
    color: var(--tekst);
  }

  /* Odnośnik z obrysem jak „Zapytaj o stronę” na stronie głównej: akcent na tle, cel dotyku 48 px. */
  .wpis__udostepnij {
    margin-top: var(--o-8);
    margin-bottom: 0;
    text-align: center;
  }

  .wpis__facebook {
    /* spoczynek */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--o-6);
    border: 2px solid var(--akcent);
    border-radius: var(--promien);
    font-weight: 600;
    color: var(--akcent);
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  /* najechanie */
  .wpis__facebook:hover {
    background: var(--powierzchnia);
  }

  /* aktywny (wciśnięty) */
  .wpis__facebook:active {
    transform: translateY(1px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Pasek boczny: spis sekcji + wezwanie, wypełnienie zamiast kreski, promień z motywu. Na telefonie tylko wezwanie, pod tekstem. */
  .wpis__bok {
    display: flex;
    flex-direction: column;
    gap: var(--o-6);
    max-width: 44rem;
    margin: var(--o-12) auto 0;
  }

  @media (min-width: 64rem) {
    .wpis__bok {
      max-width: none;
      margin: 0;
    }
  }

  .wpis__spis {
    display: none;
  }

  @media (min-width: 64rem) {
    .wpis__spis {
      display: block;
    }
  }

  .wpis__spis,
  .wpis__wezwanie {
    padding: var(--o-6);
    background: var(--powierzchnia);
    border-radius: var(--promien);
  }

  .wpis__bok-tytul {
    margin: 0 0 var(--o-3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-l);
    line-height: 1.2;
  }

  .wpis__spis ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wpis__spis a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: var(--o-1);
    font-size: var(--t-s);
    line-height: 1.35;
    color: var(--tekst);
    text-decoration: none;
  }

  /* najechanie i fokus: kolor akcentu z podkreśleniem */
  .wpis__spis a:hover {
    color: var(--akcent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wpis__wezwanie p:not(.wpis__bok-tytul) {
    margin: 0 0 var(--o-4);
    font-size: var(--t-s);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  .wpis__guzik {
    /* spoczynek */
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--o-6);
    border: 2px solid var(--akcent);
    border-radius: var(--promien);
    background: var(--akcent);
    font-weight: 600;
    color: var(--tlo);
    text-decoration: none;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .wpis__guzik + .wpis__guzik {
    margin-top: var(--o-3);
  }

  /* najechanie */
  .wpis__guzik:hover {
    background: var(--tlo);
    color: var(--akcent);
  }

  /* aktywny (wciśnięty) */
  .wpis__guzik:active {
    transform: translateY(1px);
  }

  .wpis__guzik--cichy {
    background: transparent;
    color: var(--akcent);
  }

  .wpis__guzik--cichy:hover {
    background: var(--tlo);
  }

  /* „Czytaj także”: 3 karty w rzędzie na pełną szerokość kontenera (2 od 48rem, 1 na telefonie), karty jak na liście /blog/. */
  .wpis__dalej {
    margin-top: var(--o-16);
    padding-top: var(--o-8);
    border-top: 1px solid var(--linia);
  }

  .wpis__dalej-tytul {
    margin-bottom: var(--o-6);
    text-align: center;
    font-size: var(--t-xl);
  }

  .wpis__dalej-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--o-6);
