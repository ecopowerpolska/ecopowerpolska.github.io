---
// /blog/ — lista wpisów od najnowszego (dist/blog/index.html). Co jest opublikowane, rozstrzyga wyłącznie opublikowane()
// z src/lib/wpisy.ts. Napisy: src/data/blog.json (panel: Teksty strony → Blog). Zero JavaScriptu: karta to jeden odnośnik.
import { Image } from 'astro:assets';
import Bazowy from '../../layouts/Bazowy.astro';
import PasekMarki from '../../components/PasekMarki.astro';
import Stopka from '../../components/Stopka.astro';
import teksty from '../../data/blog.json';
import firma from '../../data/firma.json';
import { tekst } from '../../lib/tekst';
import { opublikowane, adresWpisu, dataPoPolsku, plikObrazu } from '../../lib/wpisy';

const wpisy = (await opublikowane()).map((w) => ({
  id: w.id,
  tytul: w.data.tytul,
  adres: adresWpisu(w.id),
  zajawka: w.data.opisSeo,
  iso: w.data.dataPublikacji!.toISOString(),
  data: dataPoPolsku(w.data.dataPublikacji!),
  obraz: plikObrazu(w.data.zdjecie),
}));

const naglowek = tekst(teksty.naglowek, 'Blog');

// „Od czego zacząć”: dwie ścieżki czytania. Treść z blog.json → odCzegoZaczac (panel); bez pola — wartości niżej.
type Sciezka = { tytul: string; wpisy: string[] };
type OdCzego = { naglowek?: string; sciezki?: Sciezka[] };
const domyslneSciezki: Sciezka[] = [
  {
    tytul: 'Planujesz pierwszą stronę',
    wpisy: ['strona-czy-sklep-internetowy-od-czego-zaczac', 'ile-kosztuje-strona-i-sklep-internetowy', 'ile-trwa-budowa-strony-i-co-dostajesz'],
  },
  { tytul: 'Masz już stronę', wpisy: ['core-web-vitals-po-polsku', 'prawne-aspekty-strony-internetowej-zgody-regulaminy'] },
];
const odCzego = ((teksty as Record<string, unknown>).odCzegoZaczac ?? {}) as OdCzego;
const poId = new Map(wpisy.map((w) => [w.id, w]));
// Wpis spoza listy opublikowanych (szkic, literówka w panelu) po prostu znika ze ścieżki.
const sciezki = (odCzego.sciezki?.length ? odCzego.sciezki : domyslneSciezki)
  .map((s) => ({ tytul: s.tytul, wpisy: (s.wpisy ?? []).map((id) => poId.get(id)).filter((w) => w !== undefined) }))
  .filter((s) => s.wpisy.length > 0);
const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');

// JSON-LD: Blog z listą wpisów, wydawca = organizacja ze strony głównej (to samo @id).
const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${baza}/blog/#blog`,
  url: `${baza}/blog/`,
  name: tekst(teksty.tytulKarty, 'Blog — EcoPower Polska'),
  inLanguage: 'pl-PL',
  publisher: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
  blogPost: wpisy.map((w) => ({
    '@type': 'BlogPosting',
    headline: w.tytul,
    url: `${baza}${w.adres}`,
    datePublished: w.iso,
  })),
};
---

<Bazowy
  tytul={tekst(teksty.tytulKarty, 'Blog — EcoPower Polska')}
  opis={tekst(teksty.opisWyszukiwarki, 'Wpisy EcoPower Polska o budowie stron i sklepów internetowych dla firm: wybór drogi, czas budowy, panel treści, hosting i widoczność w Google.')}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="blog">
    <h1 class="blog__tytul">{naglowek}</h1>
    <p class="blog__lead">{tekst(teksty.lead, 'Piszemy o tym, jak budujemy strony i sklepy internetowe dla firm: od wyboru drogi, przez panel treści, po publikację i utrzymanie.')}</p>

    {
      sciezki.length > 0 && (
        <section class="blog__start" aria-labelledby="od-czego-zaczac">
          <h2 id="od-czego-zaczac" class="blog__start-tytul">{tekst(odCzego.naglowek, 'Od czego zacząć')}</h2>
          <div class="blog__sciezki">
            {sciezki.map((s) => (
              <div class="blog__sciezka">
                <h3 class="blog__sciezka-tytul">{s.tytul}</h3>
                <ol class="blog__sciezka-lista">
                  {s.wpisy.map((w) => (
                    <li>
                      <a class="karta karta--link blog__sciezka-karta" href={w.adres}>{w.tytul}</a>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      wpisy.length > 0 ? (
        <ul class="blog__lista">
          {wpisy.map((w, i) => (
            <li data-ujawnij>
              <a class="karta karta--link" href={w.adres}>
                {w.obraz && (
                  <Image
                    class="karta__zdjecie"
                    src={w.obraz}
                    alt=""
                    widths={[360, 540, 720, 1080]}
                    width={1080}
                    height={720}
                    fit="cover"
                    sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 36rem, calc(100vw - 3rem)"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                  />
                )}
                <div class="karta__tresc">
                  <h2 class="karta__tytul">{w.tytul}</h2>
                  <time class="karta__data" datetime={w.iso}>{w.data}</time>
                  {w.zajawka && <p class="karta__zajawka">{w.zajawka}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="blog__pusto">{tekst(teksty.pusto, 'Nie ma jeszcze wpisów.')}</p>
      )
    }
  </main>

  <Stopka />
</Bazowy>

<style>
  .blog {
    max-width: var(--szerokosc-tresci);
    width: 100%;
    margin: 0 auto;
    padding: var(--o-16) var(--o-6);
  }

  .blog__tytul {
    /* Jak .wpis__tytul: przy 320 px słowo „internetowych” w --t-xxl (44 px) miało 307 px i rozpychało stronę do 355 px. */
    font-size: clamp(var(--t-xl), 3vw + 1rem, var(--t-xxl));
    text-align: center;
  }

  .blog__lead {
    margin: var(--o-4) auto var(--o-12);
    max-width: 44rem;
    text-align: center;
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  /* Siatka na pełną szerokość kontenera (76rem): 1 kolumna na telefonie, 2 od 48rem, 3 od 64rem; niepełny rząd do lewej (D22/D23). */
  .blog__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--o-6);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .blog__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .blog__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Karta jak kafelek serwisu: wypełnienie zamiast kreski, promień 6 px (motyw.css). */
  .karta {
    /* spoczynek */
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--tekst);
    text-decoration: none;
  }

  /* aktywny (wciśnięty) */
  .karta:active {
    transform: translateY(1px);
  }

  .karta:hover .karta__tytul {
    color: var(--akcent);
  }

  /* Kadr 3:2 `cover` jednakowy na wszystkich kartach; miejsce zarezerwowane przed pobraniem, CLS 0. */
  .karta__zdjecie {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    border-bottom: 1px solid var(--linia);
    object-fit: cover;
  }

  .karta__tresc {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--o-2);
    padding: var(--o-6);
  }

  .karta__tytul {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-l);
    line-height: 1.2;
  }

  .karta__data,
  .karta__zajawka {
    margin: 0;
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Zajawka: najwyżej 3 linie, żeby karty w rzędzie były równe. */
  .karta__zajawka {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  /* „Od czego zacząć”: dwie ścieżki obok siebie od 56rem (3 + 2 karty-odnośniki), jedna pod drugą niżej. */
  .blog__start {
    margin: 0 0 var(--o-16);
  }

  .blog__start-tytul {
    margin: 0 0 var(--o-6);
    text-align: center;
    font-size: var(--t-xl);
  }

  .blog__sciezki {
    display: grid;
    gap: var(--o-8);
  }

  @media (min-width: 56rem) {
    .blog__sciezki {
      grid-template-columns: 3fr 2fr;
    }
  }

  .blog__sciezka-tytul {
    margin: 0 0 var(--o-3);
    font-size: var(--t-l);
  }

  .blog__sciezka-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--o-3);
  }

  .blog__sciezka-karta {
    display: flex;
    /* Reguła kart listy niżej ustawia kolumnę; tu wiersz, inaczej krótki tytuł staje na środku karty. */
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    height: auto;
    padding: var(--o-4) var(--o-6);
    background: #fff;
    border: var(--obrys-karty, 1px solid var(--linia));
    box-shadow: var(--cien-karty, none);
    border-radius: var(--promien-karty, var(--promien));
    font-weight: 600;
    line-height: 1.35;
    justify-content: flex-start;
    text-align: left;
  }

  .blog__sciezka-karta:hover {
    background: #fff;
    color: var(--akcent);
  }

  .blog__pusto {
    color: var(--tekst-cichy);
  }
</style>
