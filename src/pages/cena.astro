---
// /cena — cennik orientacyjny EcoPower Polska (netto): wykonanie i prowadzenie strony www i sklepu (od 2026-10-27).
// Treść: src/data/cena.json (panel: Teksty strony → Cennik). Każda kwota jest tekstem — panel zapisze dowolny
// napis, build się nie zatrzyma (docs/CMS-ZASADY-PRACY.md ③). Puste pole ceny = napis `brakCeny`.
// Tabele: prawdziwe <table> z <th scope>; poniżej 40 rem wiersz jest kartą.
// Nad tabelami kalkulator (src/components/Kalkulator.astro, teksty src/data/kalkulator.json, kotwica #kalkulator).
// Faza 2 (2026-11-06): nad kalkulatorem trzy ceny „od” z linkiem do kalkulatora z wybranym rodzajem (?co=<id> z kalkulator.json),
// pod nim karta „Przykład wyliczenia” — wszystkie kwoty liczone przy buildzie z cena.json; brak pozycji = karta nie powstaje.
import Bazowy from '../layouts/Bazowy.astro';
import PasekMarki from '../components/PasekMarki.astro';
import Stopka from '../components/Stopka.astro';
import Kalkulator from '../components/Kalkulator.astro';
import cenaJson from '../data/cena.json';
import kalkJson from '../data/kalkulator.json';
import { opublikowane, adresWpisu } from '../lib/wpisy';
import firma from '../data/firma.json';
import blog from '../data/blog.json';
import { tekst } from '../lib/tekst';

const cena = cenaJson as Record<string, unknown>;
const naTekst = (v: unknown): string => (typeof v === 'string' ? v.trim() : v == null ? '' : String(v).trim());
const napis = (klucz: string, domyslny: string) => tekst(naTekst(cena[klucz]), domyslny);

interface Wiersz {
  pozycja: string;
  opis: string;
  cena: string;
  jednostka: string;
}

const wiersze = (klucz: string): Wiersz[] =>
  (Array.isArray(cena[klucz]) ? (cena[klucz] as Record<string, unknown>[]) : [])
    .map((w) => ({
      pozycja: naTekst(w?.pozycja),
      opis: naTekst(w?.opis),
      cena: naTekst(w?.cena),
      jednostka: naTekst(w?.jednostka),
    }))
    .filter((w) => w.pozycja);

const brak = napis('brakCeny', 'wycena indywidualna');
const generatoryLinki = (Array.isArray(cena.generatoryLinki) ? (cena.generatoryLinki as Record<string, unknown>[]) : [])
  .map((l) => ({ tekst: naTekst(l?.tekst), adres: naTekst(l?.adres) }))
  .filter((l) => l.tekst && l.adres);

/** "5 750 zł" → 5750; brak kwoty → null (ta sama reguła co w Kalkulator.astro). */
const kwotaZ = (s: string): number | null => {
  const m = s.match(/(\d[\d\s]*)(?:,(\d{1,2}))?\s*zł/);
  if (!m) return null;
  const n = Number(m[1].replace(/\D/g, '')) + (m[2] ? Number(m[2].padEnd(2, '0')) / 100 : 0);
  return Number.isFinite(n) && n > 0 ? n : null;
};
/** 9286.5 → "9 286,50 zł" (jak w kalkulatorze). */
const zl = (x: number): string => {
  const [c, g] = (Math.round(x * 100) / 100).toFixed(2).split('.');
  return `${c.replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0')}${g === '00' ? '' : `,${g}`}\u00a0zł`;
};
const znajdz = (klucz: string, fragment: string) =>
  wiersze(klucz).find((w) => w.pozycja.toLowerCase().includes(fragment.toLowerCase()) && kwotaZ(w.cena) !== null);
const wielka = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const mala = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
const pierwszeZdanie = (t: string) => (t.match(/^[^.]*\./)?.[0] ?? t).trim();

// Id rodzaju w kalkulatorze dla pozycji cennika (para tabela + szukaj z kalkulator.json) → ?co=<id>#kalkulator.
const rodzajeKalk = ((kalkJson as Record<string, unknown>).rodzaje ?? []) as { id?: string; tabela?: string; szukaj?: string }[];
const doKalkulatora = (tabela: string, pozycja: string, dodatki = ''): string => {
  const z = rodzajeKalk.find((r) => r.tabela === tabela && r.szukaj && pozycja.toLowerCase().includes(r.szukaj.toLowerCase()));
  return z?.id ? `/cena/?co=${encodeURIComponent(z.id)}${dodatki}#kalkulator` : '#kalkulator';
};

// Trzy ceny „od”: wizytówka, strona firmowa i najtańszy sklep z tabeli uruchomienia sklepu.
const wiz = znajdz('stronaWykonanie', 'wizytówka');
const firmowa = znajdz('stronaWykonanie', 'strona firmowa');
const sklep = wiersze('sklepWykonanie')
  .filter((w) => kwotaZ(w.cena) !== null)
  .sort((a, b) => (kwotaZ(a.cena) as number) - (kwotaZ(b.cena) as number))[0];
const ceny = [
  wiz && { nazwa: 'Wizytówka', kwota: kwotaZ(wiz.cena) as number, opis: wiz.opis, adres: doKalkulatora('stronaWykonanie', wiz.pozycja) },
  firmowa && { nazwa: 'Strona firmowa', kwota: kwotaZ(firmowa.cena) as number, opis: firmowa.opis, adres: doKalkulatora('stronaWykonanie', firmowa.pozycja) },
  sklep && { nazwa: 'Sklep internetowy', kwota: kwotaZ(sklep.cena) as number, opis: `${sklep.pozycja}: ${mala(sklep.opis)}`, adres: doKalkulatora('sklepWykonanie', sklep.pozycja) },
].filter(Boolean) as { nazwa: string; kwota: number; opis: string; adres: string }[];
const cenyNaglowek = wiz && sklep ? `Strona od ${zl(kwotaZ(wiz.cena) as number)}, sklep od ${zl(kwotaZ(sklep.cena) as number)} netto` : '';

// Przykład wyliczenia: strona firmowa + 4 wpisy na blogu; obok tylko pozycje, które cennik już nazywa.
const VAT = Number(napis('zastrzezenie', '').match(/(\d+)\s*%/)?.[1] ?? 23) || 23;
const wpis = znajdz('stronaProwadzenie', 'wpis na blogu');
const opieka = znajdz('stronaProwadzenie', 'opieka techniczna');
const blogAbonament = znajdz('stronaProwadzenie', 'prowadzenie bloga');
const ILE_WPISOW = 4;
const przyklad = firmowa && wpis
  ? (() => {
      const cStrony = kwotaZ(firmowa.cena) as number;
      const cWpisu = kwotaZ(wpis.cena) as number;
      const netto = cStrony + ILE_WPISOW * cWpisu;
      const osobnoZOpisu = napis('stronaWykonanieOpis', '').split('.').map((x) => x.trim()).find((x) => /osobno/i.test(x));
      return {
        strona: { nazwa: firmowa.pozycja, kwota: cStrony },
        wpis: { nazwa: wielka(wpis.pozycja.replace(/^Treści:\s*/i, '')), kwota: cWpisu },
        netto,
        brutto: Math.round(netto * (100 + VAT)) / 100,
        wCenie: [
          `${firmowa.pozycja}: ${mala(firmowa.opis.replace(/\.$/, ''))}.`,
          'Hosting i certyfikat SSL.',
          `W każdym wpisie: ${pierwszeZdanie(wpis.opis).replace(/^[^:]*:\s*/, '')}`,
        ],
        osobno: [
          osobnoZOpisu && `${osobnoZOpisu}.`,
        ].filter(Boolean) as string[],
        coMiesiac: [
          opieka && `${opieka.pozycja}: ${zl(kwotaZ(opieka.cena) as number)} ${opieka.jednostka}.`,
          blogAbonament && `${wielka(blogAbonament.pozycja.replace(/^Treści:\s*/i, ''))}, ${ILE_WPISOW} wpisy: ${zl(kwotaZ(blogAbonament.cena) as number)} ${blogAbonament.jednostka}.`,
        ].filter(Boolean) as string[],
        adres: doKalkulatora('stronaWykonanie', firmowa.pozycja, `&wpisy=${ILE_WPISOW}`),
      };
    })()
  : null;

// Dwa wpisy bloga o cenie i czasie budowy (D poz. 2); wpis nieopublikowany albo usunięty = bez linku.
const WPISY_O_CENIE = ['ile-kosztuje-strona-i-sklep-internetowy', 'ile-trwa-budowa-strony-i-co-dostajesz'];
const wszystkieWpisy = await opublikowane();
const wpisyOCenie = WPISY_O_CENIE.map((id) => wszystkieWpisy.find((w) => w.id === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w))
  .map((w) => ({ tytul: w.data.tytul, adres: adresWpisu(w.id) }));

// Linki do stron usług pod nagłówkami tabel (plan SEO §3 D, runda 5).
const linkiTabel: Record<string, { tekst: string; adres: string }[]> = {
  'strona-wykonanie': [
    { tekst: 'co zawiera strona firmowa', adres: '/strony-internetowe-warszawa/' },
    { tekst: 'co zawiera strona wizytówka', adres: '/strona-wizytowka/' },
  ],
  'strona-prowadzenie': [{ tekst: 'co obejmuje prowadzenie strony', adres: '/prowadzenie-strony-internetowej/' }],
  'sklep-wykonanie': [{ tekst: 'jak budujemy sklep internetowy', adres: '/sklepy-internetowe-warszawa/' }],
};
// Tabele „wykonanie” nie niosą jednostki w danych: to opłata jednorazowa (tak mówi opis tabeli).
const jednorazowo = napis('jednostkaWykonania', 'jednorazowo');
const tabele = [
  { id: 'strona-wykonanie', domyslna: jednorazowo, naglowek: napis('stronaWykonanieNaglowek', 'Strona internetowa: wykonanie'), opis: napis('stronaWykonanieOpis', ''), wiersze: wiersze('stronaWykonanie') },
  { id: 'strona-prowadzenie', domyslna: '', naglowek: napis('stronaProwadzenieNaglowek', 'Strona internetowa: prowadzenie'), opis: napis('stronaProwadzenieOpis', ''), wiersze: wiersze('stronaProwadzenie') },
  { id: 'sklep-wykonanie', domyslna: jednorazowo, naglowek: napis('sklepWykonanieNaglowek', 'Sklep internetowy: uruchomienie'), opis: napis('sklepWykonanieOpis', ''), wiersze: wiersze('sklepWykonanie') },
  { id: 'sklep-prowadzenie', domyslna: '', naglowek: napis('sklepProwadzenieNaglowek', 'Sklep internetowy: prowadzenie'), opis: napis('sklepProwadzenieOpis', ''), wiersze: wiersze('sklepProwadzenie') },
].filter((t) => t.wiersze.length > 0);

const kolumny = {
  pozycja: napis('kolumnaPozycji', 'Pozycja'),
  opis: napis('kolumnaOpisu', 'Zakres'),
  cena: napis('kolumnaCeny', 'Cena'),
  jednostka: napis('kolumnaJednostki', 'Rozliczenie'),
};

const tytul = napis('tytulKarty', 'Cennik stron i sklepów internetowych — EcoPower Polska');
const opis = napis('opisWyszukiwarki', 'Cennik EcoPower Polska: wykonanie i prowadzenie strony internetowej oraz sklepu. Ceny netto.');
const naglowek = napis('naglowek', 'Cennik stron i sklepów internetowych');

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adres = new URL('/cena/', import.meta.env.SITE).href;
const okruszki = [
  { nazwa: napis('stronaGlowna', 'Strona główna'), adres: '/' },
  { nazwa: tekst(blog.menuCena, 'Cena'), adres: '/cena/' },
];

const mail = naTekst(firma.email).toLowerCase();
const cyfry = naTekst(firma.telefon).replace(/\D/g, '');
const telefon = cyfry.length === 9 ? cyfry.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3') : naTekst(firma.telefon);

const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${adres}#strona`,
      url: adres,
      name: naglowek,
      description: opis,
      inLanguage: 'pl-PL',
      isPartOf: { '@type': 'WebSite', '@id': `${baza}/#witryna` },
      about: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: o.nazwa,
        item: new URL(o.adres, import.meta.env.SITE).href,
      })),
    },
  ],
};
---

<Bazowy tytul={tytul} opis={opis}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="cena">
    <nav class="okruszki" aria-label={napis('okruszkiEtykieta', 'Ścieżka')}>
      <ol>
        {okruszki.map((o, i) => (
          <li>
            {i < okruszki.length - 1 ? <a href={o.adres}>{o.nazwa}</a> : <span aria-current="page">{o.nazwa}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="cena__tytul">{naglowek}</h1>
    {napis('lead', '') && <p class="cena__lead">{napis('lead', '')}</p>}
    <p class="cena__zastrzezenie">
      {napis('zastrzezenie', 'Ceny netto, do faktury doliczamy 23 % VAT.')}
    </p>

    {ceny.length === 3 && (
      <section class="od" aria-labelledby="ceny-od">
        <p class="etykieta od__etykieta">Ceny od</p>
        <h2 id="ceny-od" class="od__tytul">{cenyNaglowek}</h2>
        <ul class="siatka-3 od__siatka">
          {ceny.map((c) => (
            <li class="karta od__karta">
              <h3 class="od__nazwa">{c.nazwa}</h3>
              <p class="od__cena"><span class="od__slowo">od</span> <span class="liczba">{zl(c.kwota)}</span> <span class="od__slowo">netto</span></p>
              <p class="od__opis">{c.opis}</p>
              <a class="od__link" href={c.adres}>Policz dokładnie<span class="sr-only">: {c.nazwa}</span> →</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Kalkulator na górze, pod ramką VAT (runda 4, 2026-10-27): „żeby każdy mógł sobie wycenić”. Kwoty czyta z cena.json. */}
    <Kalkulator />

    {przyklad && (
      <section class="karta przyklad" aria-labelledby="przyklad-tytul">
        <p class="etykieta">Przykład wyliczenia</p>
        <h2 id="przyklad-tytul" class="przyklad__tytul">
          Strona firmowa z {ILE_WPISOW} wpisami na blogu: {zl(przyklad.netto)} netto
        </h2>
        <table class="przyklad__tabela">
          <caption class="sr-only">Wyliczenie: strona firmowa i {ILE_WPISOW} wpisy na blogu</caption>
          <tbody>
            <tr><th scope="row">{przyklad.strona.nazwa}</th><td>{zl(przyklad.strona.kwota)}</td></tr>
            <tr><th scope="row">{przyklad.wpis.nazwa} × {ILE_WPISOW} ({zl(przyklad.wpis.kwota)} za wpis)</th><td>{zl(ILE_WPISOW * przyklad.wpis.kwota)}</td></tr>
          </tbody>
          <tfoot>
            <tr><th scope="row">Razem netto, jednorazowo</th><td>{zl(przyklad.netto)}</td></tr>
            <tr><th scope="row">Razem brutto z {VAT} % VAT</th><td>{zl(przyklad.brutto)}</td></tr>
          </tfoot>
        </table>
        <div class="przyklad__kolumny">
          <div>
            <h3>W cenie</h3>
            <ul>{przyklad.wCenie.map((x) => <li>{x}</li>)}</ul>
          </div>
          {przyklad.osobno.length > 0 && (
            <div>
              <h3>Osobno</h3>
              <ul>{przyklad.osobno.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
          {przyklad.coMiesiac.length > 0 && (
            <div>
              <h3>Co miesiąc, jeśli wybierzesz</h3>
              <ul>{przyklad.coMiesiac.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
        </div>
        <p class="przyklad__link"><a href={przyklad.adres}>Policz ten wariant w kalkulatorze →</a></p>
      </section>
    )}

    <nav class="spis" aria-labelledby="spis-tabel">
      <h2 id="spis-tabel" class="sr-only">Spis tabel</h2>
      <ul>
        {tabele.map((t) => <li><a href={`#${t.id}`}>{t.naglowek}</a></li>)}
      </ul>
    </nav>

    {tabele.map((t) => (
      <section class="tabela" aria-labelledby={t.id} data-ujawnij>
        <h2 id={t.id} class="tabela__tytul">{t.naglowek}</h2>
        {t.opis && <p class="tabela__opis">{t.opis}</p>}
        {linkiTabel[t.id] && (
          <p class="tabela__linki">
            Zobacz, {linkiTabel[t.id].map((l, i) => (
              <>{i > 0 && ' i '}<a href={l.adres}>{l.tekst}</a></>
            ))}.
          </p>
        )}
        <div class="przewijanie" role="region" aria-labelledby={t.id} tabindex="0">
          <table role="table">
            <thead role="rowgroup">
              <tr role="row">
                <th scope="col" role="columnheader">{kolumny.pozycja}</th>
                <th scope="col" role="columnheader">{kolumny.opis}</th>
                <th scope="col" role="columnheader">{kolumny.cena}</th>
                <th scope="col" role="columnheader">{kolumny.jednostka}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {t.wiersze.map((w) => (
                <tr role="row">
                  <th scope="row" role="rowheader">
                    <span class="pozycja">{w.pozycja}</span>
                  </th>
                  <td class="uwagi" role="cell">{w.opis}</td>
                  <td class="kwota" role="cell" data-etykieta={kolumny.cena}>{w.cena || brak}</td>
                  <td class="jednostka" role="cell" data-etykieta={kolumny.jednostka}>{w.cena ? w.jednostka || t.domyslna : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    {wpisyOCenie.length > 0 && (
      <p class="tabela__linki cena__blog">
        Skąd biorą się te kwoty i ile trwa budowa, piszemy na blogu:{' '}
        {wpisyOCenie.map((w, i) => (
          <>{i > 0 && ' oraz '}<a href={w.adres}>{w.tytul}</a></>
        ))}.
      </p>
    )}

    {napis('generatoryTekst', '') && generatoryLinki.length > 0 && (
      <p class="tabela__linki cena__blog">
        {napis('generatoryTekst', '')}{' '}
        {generatoryLinki.map((l, i) => (
          <>{i > 0 && ' i '}<a href={l.adres}>{l.tekst}</a></>
        ))}.
      </p>
    )}

    <section class="kontakt" aria-labelledby="cena-kontakt" data-ujawnij>
      <h2 id="cena-kontakt" class="kontakt__tytul">{napis('ctaNaglowek', 'Dokładną cenę podamy, gdy opiszesz zakres')}</h2>
      <p>{napis('ctaTekst', 'Napisz albo zadzwoń.')}</p>
      <p class="kontakt__guzik"><a class="guzik" href="/kontakt/">{napis('ctaLink', 'Przejdź do kontaktu')}</a></p>
      <ul class="kontakt__dane">
        {mail && <li><a href={`mailto:${mail}`}>{mail}</a></li>}
        {cyfry && <li><a href={`tel:+48${cyfry.slice(-9)}`}>{telefon}</a></li>}
      </ul>
    </section>
  </main>

  <Stopka />
</Bazowy>

<style>
  .cena {
    max-width: var(--szerokosc-tresci);
    width: 100%;
    margin: 0 auto;
    padding: var(--o-8) var(--o-6) var(--o-16);
  }

  /* Okruszki: ten sam wygląd co na /faq/ i nad wpisem bloga. */
  .okruszki ol {
    list-style: none;
    margin: 0 0 var(--o-6);
    padding: 0;
    display: flex;
    gap: 0 var(--o-2);
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Jedna linia na każdej szerokości (D14): bieżąca strona skraca się wielokropkiem,
     pełny tytuł stoi tuż niżej w H1. */
  .okruszki li {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* contain: inline-size — długi tytuł nie poszerza strony (min-content = 0), dostaje resztę wiersza. */
  .okruszki li:last-child {
    flex: 1 1 0;
    min-width: 0;
    contain: inline-size;
  }

  .okruszki [aria-current] {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 44px;
  }

  .okruszki li + li::before {
    content: '›';
    margin-right: var(--o-2);
  }

  .okruszki a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .okruszki a:hover {
    color: var(--tekst);
  }

  /* Runda 7 (2026-10-30): wszystko na pełną szerokość kontenera (--szerokosc-tresci); H1 i wstęp na środku. */

  .cena__tytul {
    font-size: clamp(var(--t-xl), 3vw + 1rem, var(--t-xxl));
    text-align: center;
  }

  .cena__lead {
    margin-block: var(--o-4) 0;
    text-align: center;
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  /* Ramka „ceny netto + VAT, aktualność cennika” — wypełnienie i kreska akcentu, żeby nie zginęła. */
  .cena__zastrzezenie {
    margin-block: var(--o-6) var(--o-8);
    padding: var(--o-4) var(--o-6);
    text-align: center;
    background: var(--powierzchnia);
    border-left: 4px solid var(--akcent);
    border-radius: var(--promien-maly);
    font-weight: 600;
  }

