---
// /dziekujemy/ — strona po wysłaniu formularza /kontakt/ (handler PHP odpowiada 303 tutaj). Poza indeksem: noindex
// w <head> (dwa meta robots łączą się w Google; Bazowy.astro ma własny) i filtr sitemapy w astro.config.mjs (integrator).
// Skrypt czyści koszyk wycen i szkic formularza z pamięci sesji (src/lib/wyceny.ts → wyczysc()).
import Bazowy from '../layouts/Bazowy.astro';
import PasekMarki from '../components/PasekMarki.astro';
import Stopka from '../components/Stopka.astro';
import k from '../data/kontakt.json';
import firma from '../data/firma.json';
import { tekst } from '../lib/tekst';

const cyfry = firma.telefon.replace(/\D/g, '');
const telefon = cyfry.length === 9 ? cyfry.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3') : firma.telefon;
---

<Bazowy tytul={tekst(k.dziekujemyTytulKarty, 'Dziękujemy za zapytanie — EcoPower Polska')} opis={tekst(k.dziekujemyTekst, 'Zapytanie dotarło.')}>
  <meta slot="head" name="robots" content="noindex, follow" />

  <PasekMarki />

  <main id="tresc" class="dzieki">
    <h1 class="dzieki__tytul">{tekst(k.dziekujemyNaglowek, 'Dziękujemy, zapytanie dotarło')}</h1>
    <p class="dzieki__tekst">{k.dziekujemyTekst}</p>
    {cyfry && <p class="dzieki__tel"><a href={`tel:+48${cyfry.slice(-9)}`}>{telefon}</a></p>}
    <ul class="dzieki__linki">
      <li><a class="guzik" href="/">{tekst(k.dziekujemyPowrot, 'Wróć na stronę główną')}</a></li>
      <li><a class="guzik guzik--drugi" href="/cena/">{tekst(k.dziekujemyCennik, 'Zobacz cennik')}</a></li>
    </ul>
  </main>

  <Stopka />
</Bazowy>

<script>
  import { wyczysc } from '../lib/wyceny';
  wyczysc();
</script>

<style>
  /* Kontener 76 rem jak na pozostałych stronach, treść na środku; rozmiar H1 z motywu. */
  .dzieki { max-width: var(--szerokosc-tresci); width: 100%; margin: 0 auto; padding: var(--o-16) var(--o-6); text-align: center; }
  .dzieki__tekst { margin: var(--o-6) 0 var(--o-4); font-size: var(--t-l); line-height: 1.5; }
  .dzieki__tel a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-size: var(--t-l); }
  .dzieki__linki { list-style: none; margin: var(--o-8) 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--o-3) var(--o-4); }
</style>
