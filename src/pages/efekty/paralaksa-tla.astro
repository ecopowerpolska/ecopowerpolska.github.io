---
// /efekty/paralaksa-tla/ - paralaksa w sekcji hero: warstwy tła (słońce, dalekie i bliskie wzgórza) przesuwają się z różną prędkością
// podczas przewijania. Sam CSS (animation-timeline z nazwanym view-timeline), zero JS. Pomysł: wzorzec „CSS-only parallax z view()"
// z poradników scroll-driven animations (m.in. rebeccamdeprey.com/blog/scroll-driven-animations-css, 12daysofweb.dev/2023/css-scroll-driven-animations/).
// Bez wsparcia osi przewijania i przy ograniczonym ruchu: nieruchomy obraz.
import SzkieletEfektu from '../../components/efekty/SzkieletEfektu.astro';
---

<SzkieletEfektu slug="paralaksa-tla">
  <section class="paralaksa" aria-label="Pokaz: paralaksa tła w sekcji hero">
    <div class="paralaksa__scena">
      <span class="paralaksa__warstwa paralaksa__slonce" aria-hidden="true"></span>
      <span class="paralaksa__warstwa paralaksa__daleko" aria-hidden="true"></span>
      <span class="paralaksa__warstwa paralaksa__blisko" aria-hidden="true"></span>
      <p class="paralaksa__haslo">Tu może być Twój nagłówek</p>
    </div>
    <p class="paralaksa__podpis">Przewijaj stronę w górę i w dół: słońce i wzgórza przesuwają się z różną prędkością, więc obraz ma głębię.</p>
  </section>
</SzkieletEfektu>

<style>
  .paralaksa__scena {
    position: relative;
    height: clamp(18rem, 60svh, 32rem);
    overflow: hidden;
    border-radius: var(--promien);
    background: linear-gradient(var(--powierzchnia), var(--tlo));
    display: grid;
    place-items: start center;
    isolation: isolate;
  }

  .paralaksa__warstwa {
    position: absolute;
    display: block;
  }

  .paralaksa__slonce {
    top: 14%;
    right: 12%;
    width: clamp(4rem, 9vw, 7rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--akcent);
    opacity: 0.35;
    --przes: 2.5rem;
  }

  .paralaksa__daleko,
  .paralaksa__blisko {
    left: -20%;
    width: 140%;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }

  .paralaksa__daleko {
    bottom: -2.5rem;
    height: 52%;
    background: var(--linia);
    --przes: 2rem;
  }

  .paralaksa__blisko {
    bottom: -2.5rem;
    height: 34%;
    left: -5%;
    background: var(--akcent);
    --przes: -1.5rem;
  }

  .paralaksa__haslo {
    position: relative;
    z-index: 1;
    margin: clamp(2rem, 9vw, 5rem) var(--o-6) 0;
    font-family: var(--font-display);
    font-size: clamp(var(--t-xl), 4vw + 0.5rem, var(--t-display));
    font-weight: 600;
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
    color: var(--tekst);
  }

  .paralaksa__podpis {
    margin: var(--o-4) 0 0;
    text-align: center;
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Właściwości animacji rozpisane osobno, oś przez zmienną (minifikator składa skrót `animation` i zeruje animation-timeline;
     ta sama pułapka co w Ujawnianie.astro). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .paralaksa__scena {
        view-timeline-name: --paralaksa;
        view-timeline-axis: block;
      }

      .paralaksa__warstwa {
        --os-paralaksy: --paralaksa;
        animation-name: paralaksa;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--os-paralaksy);
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes paralaksa {
    from {
      transform: translateY(calc(var(--przes) * -1));
    }

    to {
      transform: translateY(var(--przes));
    }
  }
</style>
