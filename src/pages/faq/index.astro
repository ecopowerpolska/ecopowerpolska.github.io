---
// /faq/ — pytania klientów o strony i sklepy (dist/faq/index.html). Treść: src/data/faq.json (panel: Pytania i odpowiedzi).
// Pytanie = <details name="faq" id="kotwica"> z H2 w <summary> (D14, Piotr 2026-10-27): klik otwiera jedno pytanie i zamyka resztę;
// układ na całą szerokość kontenera (--szerokosc-tresci), długa odpowiedź w dwóch kolumnach od 64 rem (runda 7, Piotr 2026-10-30);
// odpowiedź zostaje w HTML (zamknięty <details> nie ukrywa tekstu przed robotem ani przed wyszukiwaniem w stronie).
// 🔴 Bez FAQPage w JSON-LD: wynik FAQ Google wycofał 2026-05-07, a bramka zatrzymuje publikację blokadą A10
// (potwor-www §I, precedens pan-stolarz.pl). JSON-LD: WebPage + BreadcrumbList w @graph, jak wpis bloga.
import Bazowy from '../../layouts/Bazowy.astro';
import PasekMarki from '../../components/PasekMarki.astro';
import Stopka from '../../components/Stopka.astro';
import faqJson from '../../data/faq.json';
import firma from '../../data/firma.json';
import { tekst } from '../../lib/tekst';
import { kawalki } from '../../lib/odnosniki';

// Panel może zapisać null w wyczyszczonym polu albo usunąć pole — wszystko sprowadzone do tekstu, nic nie zatrzymuje builda.
const faq = faqJson as Record<string, unknown>;
const naTekst = (v: unknown): string => (typeof v === 'string' ? v.trim() : v == null ? '' : String(v).trim());
const napis = (klucz: string, domyslny: string) => tekst(naTekst(faq[klucz]), domyslny);

// Kotwica: pole z panelu albo nazwa z pytania; zawsze unikalna i bez polskich znaków.
const PL: Record<string, string> = { ą: 'a', ć: 'c', ę: 'e', ł: 'l', ń: 'n', ó: 'o', ś: 's', ź: 'z', ż: 'z' };
const naKotwice = (t: string) =>
  t
    .toLowerCase()
    .replace(/[ąćęłńóśźż]/g, (z) => PL[z] ?? z)
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-+|-+$)/g, '')
    .slice(0, 60);
const DLUGA = 450;
const zajete = new Set<string>();
const pytania = (Array.isArray(faq.pytania) ? (faq.pytania as Record<string, unknown>[]) : [])
  .map((p) => ({ pytanie: naTekst(p?.pytanie), odpowiedz: naTekst(p?.odpowiedz), kotwica: naKotwice(naTekst(p?.kotwica)) }))
  .filter((p) => p.pytanie && p.odpowiedz)
  .map((p, i) => {
    let k = p.kotwica || naKotwice(p.pytanie) || `pytanie-${i + 1}`;
    if (/^[0-9]/.test(k)) k = `p-${k}`;
    for (let n = 2; zajete.has(k); n++) k = `${p.kotwica || naKotwice(p.pytanie)}-${n}`;
    zajete.add(k);
    // Pusty wiersz w odpowiedzi = nowy akapit. Odpowiedź dłuższa niż DLUGA znaków (przy 76 rem to > 3 linie
    // po ok. 150 znaków) układa się na komputerze w dwie kolumny — krótsza miara, mniej przewijania (D23).
    return {
      ...p,
      kotwica: k,
      akapity: p.odpowiedz.split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean),
      dluga: p.odpowiedz.length > DLUGA,
    };
  });

const tytul = napis('tytulKarty', 'Pytania o strony i sklepy internetowe — EcoPower Polska');
const opis = napis(
  'opisWyszukiwarki',
  'Odpowiedzi EcoPower Polska na pytania o strony i sklepy internetowe: czas, treść, hosting, domena, poczta i Google.',
);
const naglowek = napis('naglowek', 'Pytania o strony i sklepy internetowe');

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adres = new URL('/faq/', import.meta.env.SITE).href;
const okruszki = [
  { nazwa: napis('stronaGlowna', 'Strona główna'), adres: '/' },
  { nazwa: naglowek, adres: '/faq/' },
];

const mail = naTekst(firma.email).toLowerCase();
const cyfry = naTekst(firma.telefon).replace(/\D/g, '');
const telefon = cyfry.length === 9 ? cyfry.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3') : naTekst(firma.telefon);

const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${adres}#strona`,
      url: adres,
      name: tytul,
      description: opis,
      inLanguage: 'pl-PL',
      isPartOf: { '@type': 'WebSite', '@id': `${baza}/#witryna` },
      about: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: o.nazwa,
        item: new URL(o.adres, import.meta.env.SITE).href,
      })),
    },
  ],
};
---

<Bazowy tytul={tytul} opis={opis}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="faq">
    <nav class="okruszki" aria-label={napis('okruszkiEtykieta', 'Ścieżka')}>
      <ol>
        {okruszki.map((o, i) => (
          <li>
            {i < okruszki.length - 1 ? <a href={o.adres}>{o.nazwa}</a> : <span aria-current="page">{o.nazwa}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="faq__tytul">{naglowek}</h1>
    <p class="faq__lead">
      {napis('lead', 'Krótkie odpowiedzi o tym, jak robimy strony i sklepy internetowe.')}
    </p>

    {/* Akordeon wyłączny (D14): wspólne name="faq" — otwarcie jednego pytania zamyka pozostałe.
        Bez data-ujawnij: pytania nie mogą być schowane przez animację wejścia. */}
    <div class="lista">
      {pytania.map((p) => (
        <details class="pytanie" name="faq" id={p.kotwica}>
          <summary class="pytanie__tytul"><h2>{p.pytanie}</h2></summary>
          <div class:list={['pytanie__odpowiedz', { 'pytanie__odpowiedz--dluga': p.dluga }]}>
            {p.akapity.map((a) => <p>{kawalki(a).map((c) => (c.adres ? <a href={c.adres}>{c.tekst}</a> : c.tekst))}</p>)}
          </div>
        </details>
      ))}
    </div>

    {/* Wejście z adresu z #kotwica (z bloga, ze strony głównej) otwiera to jedno pytanie. */}
    <script is:inline>
      (() => {
        const otworz = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          const el = id && document.getElementById(id);
          if (el && el.tagName === 'DETAILS') {
            el.open = true;
            el.scrollIntoView();
          }
        };
        addEventListener('hashchange', otworz);
        if (document.readyState === 'complete') otworz();
        else addEventListener('load', otworz);
      })();
    </script>

    <section class="kontakt" aria-labelledby="faq-kontakt" data-ujawnij>
      <h2 id="faq-kontakt" class="kontakt__tytul">{napis('kontaktNaglowek', 'Nie ma tu Twojego pytania?')}</h2>
      <p>{napis('kontaktTekst', 'Napisz albo zadzwoń.')}</p>
      <ul class="kontakt__dane">
        {mail && <li><a href={`mailto:${mail}`}>{mail}</a></li>}
        {cyfry && <li><a href={`tel:+48${cyfry.slice(-9)}`}>{telefon}</a></li>}
      </ul>
    </section>
  </main>

  <Stopka />
</Bazowy>

<style>
  .faq {
    max-width: var(--szerokosc-tresci);
    width: 100%;
    margin: 0 auto;
    padding: var(--o-8) var(--o-6) var(--o-16);
  }

  /* Okruszki: ten sam wygląd co nad wpisem bloga (src/pages/blog/[slug].astro). */
  .okruszki ol {
    list-style: none;
    margin: 0 0 var(--o-6);
    padding: 0;
    display: flex;
    gap: 0 var(--o-2);
    font-size: var(--t-s);
    color: var(--tekst-cichy);
  }

  /* Jedna linia na każdej szerokości (D14): bieżąca strona skraca się wielokropkiem,
     pełny tytuł stoi tuż niżej w H1. */
  .okruszki li {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* contain: inline-size — długi tytuł nie poszerza strony (min-content = 0), dostaje resztę wiersza. */
  .okruszki li:last-child {
    flex: 1 1 0;
    min-width: 0;
    contain: inline-size;
  }

  .okruszki [aria-current] {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .okruszki li + li::before {
    content: '›';
    margin-right: var(--o-2);
  }

  .okruszki a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .okruszki [aria-current] {
    line-height: 44px;
  }

  .okruszki a:hover {
    color: var(--tekst);
  }

  .faq__tytul,
  .faq__lead {
    text-align: center;
  }

  .faq__tytul {
    font-size: clamp(var(--t-xl), 3vw + 1rem, var(--t-xxl));
    text-wrap: balance;
  }

  .faq__lead {
    margin-block: var(--o-4) var(--o-8);
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  /* Akordeon: kreska między pytaniami, plus/minus jak FAQ satelit (details.karta). */
  .lista {
    border-top: 1px solid var(--linia);
  }

  /* Wejście z #kotwicy: pytanie nie chowa się pod przyklejonym paskiem. */
  .pytanie {
    border-bottom: 1px solid var(--linia);
    scroll-margin-top: 7rem;
  }

  .pytanie__tytul {
    display: flex;
    align-items: center;
    gap: var(--o-3);
    min-height: 44px;
    padding: var(--o-4) 0;
    cursor: pointer;
    list-style: none;
  }

  .pytanie__tytul::-webkit-details-marker {
    display: none;
  }

  .pytanie__tytul::before {
    content: '';
    flex: 0 0 auto;
    width: 0.875rem;
    height: 0.875rem;
    background:
      linear-gradient(var(--akcent), var(--akcent)) center / 100% 2px no-repeat,
      linear-gradient(var(--akcent), var(--akcent)) center / 2px 100% no-repeat;
  }

  /* Otwarte: sam minus (bez obrotu — obrócona kreska wyglądała jak „|”). */
  .pytanie[open] > .pytanie__tytul::before {
    background: linear-gradient(var(--akcent), var(--akcent)) center / 100% 2px no-repeat;
  }

  .pytanie__tytul h2 {
    margin: 0;
    font-size: var(--t-l);
    line-height: 1.25;
  }

  .pytanie__tytul:hover h2 {
    color: var(--akcent);
  }

  .pytanie__odpowiedz {
    padding: 0 0 var(--o-4) calc(0.875rem + var(--o-3));
  }

  /* Długa odpowiedź: dwie kolumny od 64 rem. Akapity i listy nie pękają w połowie, jeśli jest ich kilka;
     pojedynczy długi akapit płynie przez obie kolumny. */
  @media (min-width: 64rem) {
    .pytanie__odpowiedz--dluga {
      columns: 2;
      column-gap: var(--o-12);
    }

    .pytanie__odpowiedz--dluga :is(ul, ol, blockquote),
    .pytanie__odpowiedz--dluga p:not(:only-child) {
      break-inside: avoid;
    }
  }

  .pytanie__odpowiedz p {
    margin: 0 0 var(--o-3);
  }

  /* Linki w odpowiedziach podkreślone (Lighthouse link-in-text-block, runda 5). */
  .pytanie__odpowiedz a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .kontakt {
    margin-top: var(--o-16);
    padding: var(--o-6);
    background: var(--powierzchnia);
    border-radius: var(--promien);
  }

  /* Komputer: nagłówek z tekstem po lewej, dane kontaktowe po prawej — pełna szerokość kontenera. */
  @media (min-width: 48rem) {
    .kontakt {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--o-12);
      align-items: center;
    }

    .kontakt__tytul,
    .kontakt p {
      grid-column: 1;
    }

    .kontakt__dane {
      grid-column: 2;
      grid-row: 1 / span 2;
      flex-direction: column;
    }
  }

  .kontakt__tytul {
    font-size: var(--t-l);
  }

  .kontakt p {
    margin: var(--o-2) 0 var(--o-3);
  }

  .kontakt__dane {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--o-6);
  }

  .kontakt__dane a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .kontakt__dane a:hover {
    color: var(--tekst);
  }
</style>
