---
// index.astro — strona główna firmy od stron WWW i sklepów (przebudowa 2026-10-23).
// Układ: nagłówek firmy → oferta → realizacje → skrót FAQ → kontakt → o spółce.
// Napisy z src/data/strona.json i src/data/oferta.json (panel), realizacje z kolekcji
// `serwisy` (src/data/serwisy.json). Wygląd bez zmian: tokeny motyw.css, PasekMarki, Stopka,
// kierunek „rejestr" (docs/DECYZJE-WIZUALNE.md). Zero JS na tej trasie poza stopką.
import { getCollection } from 'astro:content';
import Bazowy from '../layouts/Bazowy.astro';
import PasekMarki from '../components/PasekMarki.astro';
import Stopka from '../components/Stopka.astro';
import DaneStrukturalne from '../components/DaneStrukturalne.astro';
import Oferta from '../components/Oferta.astro';
import Realizacje from '../components/Realizacje.astro';
import FaqSkrot from '../components/FaqSkrot.astro';
import { tekst } from '../lib/tekst';
import stronaJson from '../data/strona.json';

// Panel może pole wyczyścić albo zapisać `null` — każdy napis idzie przez tekst().
const strona = stronaJson as Record<string, string | null | undefined>;

// Kolejność = kolejność w serwisy.json (przeciąganie w panelu, D8); ukryte nie wchodzą.
const realizacje = await getCollection('serwisy', ({ data }) => !data.ukryty);

// D2: nazwa spółki pada raz na ekran — niesie ją tytuł karty i logo, H1 mówi, co firma robi.
const tytul = tekst(strona.tytulKarty, 'Strony i sklepy internetowe dla firm — EcoPower Polska');
// D3: opis meta zbieżny z nagłówkiem i zdaniem pod nim.
const opis = tekst(
  strona.opisWyszukiwarki,
  'Budujemy strony internetowe i sklepy internetowe dla firm: projekt, panel do edycji treści, hosting, domena i widoczność w Google.',
);
const naglowek = tekst(strona.naglowek, 'Budujemy strony i sklepy internetowe dla firm.');
const lead = tekst(
  strona.zdanieNaglowka,
  'Projekt, panel do edycji treści, hosting, domena, poczta i widoczność w Google. Potem stronę utrzymujemy.',
);
---

<Bazowy tytul={tytul} opis={opis}>
  <DaneStrukturalne
    slot="head"
    serwisy={realizacje.map((s) => ({ nazwa: s.data.nazwa, adres: s.data.adres }))}
  />

  <PasekMarki />

  <main id="tresc">
    <section class="hero">
      <h1 class="hero__tytul">{naglowek}</h1>
      <p class="hero__opis">{lead}</p>
      <p class="hero__akcja">
        <a class="hero__link" href="#kontakt">{tekst(strona.hasloAkcji, 'Zapytaj o stronę')}</a>
      </p>
    </section>

    <Oferta czesc="oferta" />

    <Realizacje naglowek={strona.naglowekRealizacji} wstep={strona.wstepRealizacji} />

    <FaqSkrot />

    <Oferta czesc="kontakt" />

    {/* Zamknięcie: puste pole w panelu = sekcja znika (D9), więc bez tekst(). */}
    {strona.zdanieKoncowe?.trim() && (
      <section id="o-spolce" class="zamkniecie" aria-label={tekst(strona.etykietaSekcjiZamykajacej, 'O spółce')}>
        <p>{strona.zdanieKoncowe}</p>
      </section>
    )}
  </main>

  <Stopka />
</Bazowy>

<style>
  /* Hero lewostronny, H1 płynny (clamp) — jak dotąd; dłuższe zdanie dostaje 22ch miary. */
  .hero {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: var(--o-16) var(--o-6) var(--o-12);
  }

  .hero__tytul {
    font-size: clamp(var(--t-xxl), 3.4vw + 1.4rem, var(--t-display));
    letter-spacing: -0.015em;
    max-width: 22ch;
  }

  .hero__opis {
    margin: var(--o-4) 0 0;
    max-width: var(--miara);
    font-size: var(--t-l);
    color: var(--tekst-cichy);
    line-height: 1.5;
  }

  .hero__akcja {
    margin: var(--o-8) 0 0;
  }

  /* Odnośnik z obrysem: pary akcent/tło i akcent/powierzchnia z motyw.css, bez nowego koloru. */
  .hero__link {
    /* spoczynek */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--o-6);
    border: 2px solid var(--akcent);
    border-radius: var(--promien);
    font-weight: 600;
    color: var(--akcent);
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  /* najechanie */
  .hero__link:hover {
    background: var(--powierzchnia);
    text-decoration: none;
  }

  /* aktywny (wciśnięty) */
  .hero__link:active {
    transform: translateY(1px);
  }

  .zamkniecie {
    max-width: var(--szerokosc-tresci);
    margin: 0 auto;
    padding: 0 var(--o-6) var(--o-24);
  }

  .zamkniecie p {
    max-width: var(--miara);
    margin: 0;
    padding-top: var(--o-8);
    border-top: 1px solid var(--linia);
    font-size: var(--t-m);
    line-height: 1.5;
    color: var(--tekst-cichy);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__link {
      transition: none;
    }
  }
</style>
