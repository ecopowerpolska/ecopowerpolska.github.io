---
// /jak-sprawdzic-szybkosc-strony — poradnik + test szybkości strony w Google PageSpeed Insights (od 2026-10-27, D15).
// Bez JS: formularz GET otwiera oficjalny raport pagespeed.web.dev/analysis?url=… w nowej karcie.
// Adres wpisuje się bez https:// (pole tekstowe, skrypt dopisuje schemat także przed zwykłym wysłaniem formularza).
// Pod wynikiem: zdanie po ludzku z wyniku telefonu i wezwanie do /kontakt/ (też po błędzie pomiaru).
// Z JS: wynik na miejscu z PSI API v5 — TYLKO gdy build dostał klucz przeglądarkowy (PUBLIC_PSI_KLUCZ, ograniczony
// do adresu strony). Bez klucza Google nie przyjmuje zapytań (limit 0 na dobę, zmierzone 2026-10-27: 429) — wtedy
// skrypt nic nie przechwytuje i działa formularz. Klucza pagespeed-z440 z ~/.sekrety/ tu nie wolno.
import Bazowy from '../layouts/Bazowy.astro';
import PasekMarki from '../components/PasekMarki.astro';
import Stopka from '../components/Stopka.astro';
import Zegar from '../components/narzedzia/Zegar.astro';
import firma from '../data/firma.json';
import blog from '../data/blog.json';
import { tekst } from '../lib/tekst';

const klucz = (import.meta.env.PUBLIC_PSI_KLUCZ ?? '').trim();
const naglowek = 'Darmowe narzędzie do sprawdzania szybkości strony';
const tytul = 'Darmowe narzędzie do sprawdzania szybkości strony | EcoPower Polska';
const opis =
  'Darmowe narzędzie do sprawdzania szybkości strony: wpisz adres, a wynik Google PageSpeed dla telefonu i komputera zobaczysz od razu, po polsku.';

const baza = new URL('/', import.meta.env.SITE).href.replace(/\/$/, '');
const adres = new URL('/jak-sprawdzic-szybkosc-strony/', import.meta.env.SITE).href;
const okruszki = [
  { nazwa: tekst(blog.stronaGlowna, 'Strona główna'), adres: '/' },
  { nazwa: tekst(blog.menuSzybkosc, 'Szybkość'), adres: '/jak-sprawdzic-szybkosc-strony/' },
];

const strony = [
  ['mobile', 'Telefon'],
  ['desktop', 'Komputer'],
];
const kategorie = [
  ['accessibility', 'Ułatwienia dostępu'],
  ['best-practices', 'Sprawdzone metody'],
  ['seo', 'SEO'],
  ['agentic-browsing', 'Przeglądanie agentowe'],
];
// Progi Google: [dobry do, słaby od]. Szerokość paska w skrypcie = wartość / próg „słaby”.
const metryki = [
  ['first-contentful-paint', 'Pierwsza treść (FCP)', '1800,3000'],
  ['largest-contentful-paint', 'Największy element (LCP)', '2500,4000'],
  ['total-blocking-time', 'Blokowanie (TBT)', '200,600'],
  ['cumulative-layout-shift', 'Przesunięcie układu (CLS)', '0.1,0.25'],
  ['speed-index', 'Indeks szybkości (SI)', '3400,5800'],
];

const daneStrukturalne = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${adres}#strona`,
      url: adres,
      name: naglowek,
      description: opis,
      inLanguage: 'pl-PL',
      isPartOf: { '@type': 'WebSite', '@id': `${baza}/#witryna` },
      about: { '@type': 'Organization', '@id': `${baza}/#organizacja`, name: firma.nazwaKrotka },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((o, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: o.nazwa,
        item: new URL(o.adres, import.meta.env.SITE).href,
      })),
    },
  ],
};
---

<Bazowy tytul={tytul} opis={opis}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(daneStrukturalne)} />

  <PasekMarki />

  <main id="tresc" class="szybkosc">
    <nav class="okruszki" aria-label="Ścieżka">
      <ol>
        {okruszki.map((o, i) => (
          <li>
            {i < okruszki.length - 1 ? <a href={o.adres}>{o.nazwa}</a> : <span aria-current="page">{o.nazwa}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="szybkosc__tytul">{naglowek}</h1>
    <p class="szybkosc__lead">
      Sprawdź za darmo szybkość strony internetowej: wpisz adres, a Google zmierzy ją w PageSpeed Insights i pokaże
      oficjalny wynik na telefonie i na komputerze.
    </p>

    <section class="test" aria-labelledby="test-tytul">
      <h2 id="test-tytul" class="test__tytul">Sprawdź szybkość swojej strony za darmo</h2>
      <form
        id="psi"
        class="test__formularz"
        action="https://pagespeed.web.dev/analysis"
        method="get"
        target="_blank"
        {...{ rel: 'noopener' }}
        data-klucz={klucz || undefined}
      >
        <label for="psi-adres">Adres strony</label>
        <p class="test__podpowiedz" id="psi-podpowiedz">Bez https:// i www, same wpiszemy.</p>
        <div class="test__wiersz">
          <input
            id="psi-adres"
            type="text"
            name="url"
            required
            inputmode="url"
            autocomplete="url"
            autocapitalize="off"
            spellcheck="false"
            aria-describedby="psi-podpowiedz"
            placeholder="twojafirma.pl"
          />
          <button type="submit">Sprawdź szybkość twojej strony</button>
        </div>
      </form>
      <p class="test__nota">Pomiar wykonuje Google. Adres strony trafia do Google, my go nie zapisujemy.</p>
      <p class="trwa" id="psi-trwa" role="status" hidden>
        Trwa sprawdzanie, nie zamykaj strony. To potrwa około 20–40 sekund.
      </p>
      <div class="test__stan" id="psi-stan" aria-live="polite">
        <p class="test__stan-opis" id="psi-stan-opis"></p>
      </div>

      <div class="zegary" id="psi-zegary" hidden>
        {strony.map(([s, nazwa]) => (
          <div class="zegar-kol" data-s={s} data-na={s === 'mobile' ? 'telefonie' : 'komputerze'}>
            <h3 class="zegar__nazwa">{nazwa}</h3>
            <Zegar id={`psi-zegar-${s}`} etykieta={`Wydajność, ${nazwa.toLowerCase()}`} />
            <p class="zegar__podpis" data-e={s}></p>
          </div>
        ))}
      </div>

      <div class="wynik" id="psi-wynik" hidden>
        <p class="werdykt" id="psi-werdykt" hidden></p>
        <p class="werdykt werdykt--lcp" id="psi-lcp" hidden></p>
        <section class="zalecenia" id="psi-zalecenia" aria-labelledby="psi-zal-tytul" hidden>
          <h3 class="zalecenia__tytul" id="psi-zal-tytul">Co poprawić na tej stronie</h3>
          <ol class="zalecenia__lista" id="psi-zal-lista"></ol>
          <p class="zalecenia__brak" id="psi-zal-brak" hidden>
            Nie ma nic pilnego do poprawy. Utrzymaj to przy kolejnych zmianach na stronie.
          </p>
        </section>
        <div class="paski">
          {strony.map(([s, nazwa]) => (
            <section class="paski__kol" data-s={s} aria-label={`Szczegóły wyniku: ${nazwa.toLowerCase()}`}>
              <p class="paski__nag">{nazwa}: kategorie (0–100)</p>
              {kategorie.map(([id, n]) => (
                <div class="wiersz" data-k={id}>
                  <span class="wiersz__nazwa">{n}</span>
                  <span class="wiersz__wart">…</span>
                  <div class="pasek" role="meter" aria-valuemin="0" aria-valuemax="100" aria-label={`${n}, ${nazwa.toLowerCase()}`}><span></span></div>
                </div>
              ))}
              <p class="paski__nag paski__nag--m">{nazwa}: metryki z testu laboratoryjnego</p>
              {metryki.map(([id, n, pr]) => (
                <div class="wiersz" data-m={id} data-p={pr}>
                  <span class="wiersz__nazwa">{n}</span>
                  <span class="wiersz__wart">…</span>
                  <div class="pasek" role="meter" aria-valuemin="0" aria-valuemax="100" aria-label={`${n}, ${nazwa.toLowerCase()}`}><span></span></div>
                </div>
              ))}
            </section>
          ))}
        </div>
      </div>
      <div class="wezwanie" id="psi-wezwanie" data-strona={adres} hidden>
        <p class="wezwanie__tekst">
          Chcesz, żeby było szybciej? Napisz do nas — sprawdzimy, co spowalnia stronę, i podamy cenę.
        </p>
        <div class="wezwanie__guziki">
          <a class="wezwanie__guzik" href="/kontakt/#formularz">Napisz do nas</a>
          <button class="wezwanie__guzik wezwanie__guzik--drugi" type="button" id="psi-kopiuj" aria-live="polite" hidden>Skopiuj wyniki</button>
        </div>
        <textarea class="test__kopia" id="psi-kopia" rows="6" readonly hidden aria-label="Wyniki do skopiowania"></textarea>
      </div>
      <p class="test__raport" id="psi-raport" hidden>
        <a href="https://pagespeed.web.dev/" target="_blank" rel="noopener">Pełny raport w PageSpeed Insights</a>
      </p>
    </section>

    <div class="tresc">
      <h2>Darmowe narzędzia do sprawdzania strony: szybkość, SEO, dostępność</h2>
      <p>
        PageSpeed Insights to bezpłatne narzędzie Google. Uruchamia na stronie test Lighthouse i daje pięć wyników od 0
        do 100. Wydajność mówi, jak szybko strona się pokazuje i reaguje. Ułatwienia dostępu sprawdzają kontrast, opisy
        zdjęć i etykiety pól. Sprawdzone metody obejmują HTTPS i błędy w przeglądarce. SEO sprawdza tytuł, opis i to,
        czy wyszukiwarka może stronę odczytać. Przeglądanie agentowe mówi, czy z treści skorzystają asystenci AI.
      </p>
      <p>
        Każdy wynik jest osobno dla telefonu i dla komputera. Test na telefonie symuluje wolniejsze urządzenie i słabszą
        sieć, dlatego zwykle wypada niżej.
      </p>

      <h2>Jak czytać wynik</h2>
      <p>
        Google uznaje 90–100 punktów za wynik dobry, 50–89 za wymagający poprawy, a 0–49 za słaby. Pod wynikami są
        metryki. LCP to czas, po którym widać największy element strony. CLS mówi, czy treść skacze podczas ładowania.
        TBT pokazuje, jak długo strona nie reaguje na dotyk.
      </p>

      <h2>Dlaczego szybkość ma znaczenie</h2>
      <p>
        Google bierze pod uwagę wrażenia użytkownika, w tym szybkość, gdy ustala kolejność wyników. Ważniejsi są jednak
        klienci. Strona, która ładuje się kilka sekund, traci część odwiedzających, zanim cokolwiek zobaczą. Szybka
        strona to więcej telefonów i zapytań z tej samej liczby wejść. Dlatego robimy{' '}
        <a href="/strony-internetowe-warszawa/">strony budowane pod wynik 97–100 w PageSpeed</a>.
      </p>

      <h2>Co znaczy „Brak danych”</h2>
      <p>
        U góry raportu jest sekcja z wrażeniami prawdziwych użytkowników. Google zbiera je z przeglądarki Chrome przez 28
        dni (raport CrUX). Mała albo nowa strona często nie ma tylu odwiedzin i widzi napis „Brak danych”. To nie błąd.
        Wtedy liczy się test laboratoryjny poniżej. Więcej piszemy w odpowiedzi{' '}
        <a href="/faq/#brak-danych">o braku danych w PageSpeed Insights</a>.
      </p>

      <h2>Jak sprawdzić, czy strona jest szybka w Google</h2>
      <p>
        Wpisz adres w polu na górze tej strony albo otwórz <a href="https://pagespeed.web.dev/" target="_blank" rel="noopener"
          >pagespeed.web.dev</a
        >. Odczekaj około minuty. Sprawdź wynik na telefonie i na komputerze. Zmierz kilka podstron, nie tylko stronę
        główną, bo każda ma inne zdjęcia i inny kod.
      </p>
      <p>
        Nasze strony mierzymy tak samo. Wyniki każdej realizacji pokazujemy w sekcji{' '}
        <a href="/#realizacje">Realizacje</a>, a ceny wykonania i prowadzenia strony są w <a href="/cena/">cenniku</a>.
      </p>
    </div>
  </main>

  <Stopka />
</Bazowy>

<script>
  import { zalecenia, zaleceniaTekst } from '../lib/psi-zalecenia';
  // Wynik na miejscu z PSI API v5 (D15). Bez klucza w data-klucz nic nie przechwytuje: formularz otwiera raport Google,
  // ale adres bez https:// i tak dostaje schemat przed wysłaniem. Zegary i paski: czysty SVG/CSS, bez bibliotek.
  (() => {
    const f = document.getElementById('psi') as HTMLFormElement | null;
    if (!f) return;
    const $ = (s: string) => document.getElementById(s) as HTMLElement;
    const opis = $('psi-stan-opis'), trwa = $('psi-trwa'), zegary = $('psi-zegary'), wynik = $('psi-wynik');
    const werdykt = $('psi-werdykt'), lcp = $('psi-lcp'), zal = $('psi-zalecenia'), zalLista = $('psi-zal-lista'), zalBrak = $('psi-zal-brak'), wezwanie = $('psi-wezwanie'), raport = $('psi-raport');
    const kopiuj = $('psi-kopiuj') as HTMLButtonElement, kopia = $('psi-kopia') as HTMLTextAreaElement;
    const guzik = f.querySelector('button') as HTMLButtonElement;
    const adres = f.elements.namedItem('url') as HTMLInputElement;
    const KAT = ['performance', 'accessibility', 'best-practices', 'seo', 'agentic-browsing'];
    const STRONY = ['mobile', 'desktop'];
    const spokoj = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const BLAD_ADRESU = 'To nie wygląda na adres strony. Wpisz na przykład twojafirma.pl.';
    const dane: Record<string, any> = {};
    const timery: Record<string, any> = {};
    let ostatni = '', zalTekst = '', zalPelna: any[] = [];
    const URZ: Record<string, string> = { telefon: 'Telefon', komputer: 'Komputer', oba: 'Telefon i komputer' };

    // Adres jak komu wygodnie: twojafirma.pl, www.twojafirma.pl, https://twojafirma.pl/oferta. Zwraca pełny adres albo null.
    const normalizuj = (raw: string): string | null => {
      let u = raw.trim().split(/\s+/)[0] || '';
      if (!u) return null;
      if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(u)) u = 'https://' + u.replace(/^\/+/, '');
      try {
        const a = new URL(u);
        if (!/^https?:$/.test(a.protocol) || !/\.[^.]/.test(a.hostname)) return null;
        return a.href;
      } catch { return null; }
    };
    const ustaw = (el: HTMLElement, t: string) => { el.textContent = t; el.hidden = !t; };
    const zapytaj = (u: string, s: string, k: string): Promise<any> =>
      fetch('https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=' + encodeURIComponent(u) + '&locale=pl&strategy=' + s +
        KAT.map((c) => '&category=' + c).join('') + '&key=' + encodeURIComponent(k)).then((r) =>
        r.json().then((j) => { if (!r.ok) throw r.status; return j.lighthouseResult; }));
    const stanOceny = (w: number) => (w >= 90 ? 'dobry' : w >= 50 ? 'sredni' : 'zly');
    const ocena = (l: any, k: string): number | null => {
      const c = l && l.categories && l.categories[k];
      return c && c.score != null ? Math.round(c.score * 100) : null;
    };
    const opisz = (l: any) => {
      const w = ocena(l, 'performance');
      ustaw(werdykt, w == null ? '' : w >= 90 ? 'Strona na telefonie ładuje się szybko.'
        : w >= 50 ? 'Na telefonie jest przeciętnie — da się przyspieszyć.'
        : 'Na telefonie strona ładuje się wolno — to pierwsza rzecz do poprawy.');
      const a = l.audits['largest-contentful-paint'], sek = a && typeof a.numericValue === 'number' ? a.numericValue / 1000 : 0;
      ustaw(lcp, sek > 2.5 ? 'Największy element pojawia się po ' + sek.toFixed(1).replace('.', ',') + ' s, Google oczekuje do 2,5 s.' : '');
    };

    // ── zegary ──
    const zg = (s: string) => zegary.querySelector('.zegar-kol[data-s="' + s + '"]') as HTMLElement;
    const czesc = (s: string) => {
      const k = zg(s), z = k.querySelector('.zegar') as HTMLElement, q = (x: string) => k.querySelector(x) as SVGElement;
      return { z, na: k.dataset.na, svg: q('svg'), luk: q('.zegar__luk'), igla: q('.zegar__igla'), liczba: q('.zegar__liczba'), podpis: q('.zegar__podpis') as unknown as HTMLElement };
    };
    const licz = (el: Element, w: number) => {
      if (spokoj) { el.textContent = String(w); return; }
      const t0 = performance.now();
      const krok = (t: number) => {
        const p = Math.min(1, (t - t0) / 1200);
        el.textContent = String(Math.round(w * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(krok);
      };
      requestAnimationFrame(krok);
    };
    const startZegara = (s: string) => {
      const c = czesc(s);
      clearInterval(timery[s]);
      c.z.removeAttribute('data-stan');
      c.svg.removeAttribute('aria-valuenow');
      c.luk.style.setProperty('--off', '100');
      c.igla.style.setProperty('--w', '0');
      c.z.classList.add('zegar--pracuje');
      c.podpis.textContent = 'Mierzymy na ' + c.na + '…';
      const los = () => { const v = 15 + Math.floor(Math.random() * 71); c.liczba.textContent = String(v); c.igla.style.setProperty('--w', String(v)); };
      if (spokoj) c.liczba.textContent = '…';
      else { los(); timery[s] = setInterval(los, 300); }
    };
    const dojedzZegar = (s: string, w: number | null) => {
      const c = czesc(s);
      clearInterval(timery[s]);
      c.z.classList.remove('zegar--pracuje');
      if (w == null) {
        c.liczba.textContent = '0';
        c.igla.style.setProperty('--w', '0');
        c.z.dataset.stan = 'brak';
        c.podpis.textContent = 'Bez wyniku.';
        return;
      }
      void c.luk.getBoundingClientRect();
      c.z.dataset.stan = stanOceny(w);
      c.luk.style.setProperty('--off', String(100 - w));
      c.igla.style.setProperty('--w', String(w));
      c.svg.setAttribute('aria-valuenow', String(w));
      c.podpis.textContent = 'Gotowe.';
      licz(c.liczba, w);
    };

    // ── paski ──
    const kolumna = (s: string) => wynik.querySelector('.paski__kol[data-s="' + s + '"]') as HTMLElement;
    const resetPaskow = () => {
      STRONY.forEach((s) => {
        const kol = kolumna(s);
        kol.classList.add('paski__kol--pracuje');
        kol.querySelectorAll<HTMLElement>('.wiersz').forEach((w) => {
          const p = w.querySelector('.pasek') as HTMLElement;
          (p.firstElementChild as HTMLElement).style.width = '0%';
          p.removeAttribute('aria-valuenow'); p.removeAttribute('aria-valuetext');
          w.removeAttribute('data-stan');
          (w.querySelector('.wiersz__wart') as HTMLElement).textContent = '…';
        });
      });
    };
    const paski = (s: string, l: any) => {
      const kol = kolumna(s);
      kol.classList.remove('paski__kol--pracuje');
      void kol.offsetWidth;
      let i = 0;
      kol.querySelectorAll<HTMLElement>('.wiersz').forEach((w) => {
        const p = w.querySelector('.pasek') as HTMLElement, wypelnienie = p.firstElementChild as HTMLElement;
        let pct = 0, st = '', txt = '–';
        if (w.dataset.k) {
          const sc = ocena(l, w.dataset.k);
          if (sc != null) { pct = sc; st = stanOceny(sc); txt = String(sc); }
        } else {
          const a = l.audits[w.dataset.m as string], pr = (w.dataset.p as string).split(',').map(Number);
          if (a && typeof a.numericValue === 'number') {
            const v = a.numericValue;
            pct = Math.min(100, Math.max(2, (v / pr[1]) * 100));
            st = v <= pr[0] ? 'dobry' : v <= pr[1] ? 'sredni' : 'zly';
            txt = a.displayValue || String(v);
          }
        }
        (w.querySelector('.wiersz__wart') as HTMLElement).textContent = txt;
        if (st) { w.dataset.stan = st; p.setAttribute('aria-valuenow', String(Math.round(pct))); p.setAttribute('aria-valuetext', txt); }
        wypelnienie.style.setProperty('--i', String(i++));
        wypelnienie.style.width = pct + '%';
      });
    };

    // ── zalecenia (moduł src/lib/psi-zalecenia.ts: progi Google + audyty Lighthouse) ──
    const pokazZalecenia = () => {
      const lista = zalecenia(dane.mobile || null, dane.desktop || null);
      zalLista.textContent = '';
      lista.forEach((x) => {
        const li = document.createElement('li'), t = document.createElement('strong'), o = document.createElement('span'), e = document.createElement('small');
        t.textContent = x.tytul; o.textContent = x.opis; e.textContent = URZ[x.urzadzenie];
        li.append(t, o, e);
        zalLista.append(li);
      });
      zalBrak.hidden = lista.length > 0;
      zalLista.hidden = !lista.length;
      zal.hidden = false;
      zalPelna = lista;
      zalTekst = lista.length ? zaleceniaTekst(lista) : zalBrak.textContent!.trim();
    };

    // ── kopiowanie ──
    const met = (l: any, id: string) => {
      const a = l && l.audits && l.audits[id];
      return a && a.displayValue ? a.displayValue : 'brak';
    };
    const LIMIT = 3900; // ten sam próg co w Formularz.astro (pole wiadomości ma 4000 znaków)
    const tekstKopii = (u: string) => {
      const m = dane.mobile, d = dane.desktop;
      const o = (l: any, k: string) => { const w = l ? ocena(l, k) : null; return w == null ? 'brak' : String(w); };
      const para = (k: string) => o(m, k) + '/' + o(d, k);
      const par = (id: string) => 'telefon ' + met(m, id) + ', komputer ' + met(d, id);
      const data = new Date().toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });
      const sklej = (z: string) => 'Wynik PageSpeed dla ' + u + ' (' + data + '): telefon ' + o(m, 'performance') + '/100, komputer ' + o(d, 'performance') + '/100. ' +
        'Ułatwienia dostępu ' + para('accessibility') + ', Sprawdzone metody ' + para('best-practices') + ', SEO ' + para('seo') + ' (telefon/komputer). ' +
        'LCP ' + par('largest-contentful-paint') + '; CLS ' + par('cumulative-layout-shift') + '; TBT ' + par('total-blocking-time') + '. ' +
        'Zmierzono na ' + (wezwanie.dataset.strona || location.href) +
        (z ? '\n\nCo poprawić na tej stronie:\n' + z : '');
      const pelny = sklej(zalTekst);
      return pelny.length > LIMIT && zalPelna.length > 3
        ? sklej(zaleceniaTekst(zalPelna.slice(0, 3)) + '\n(pełna lista na stronie testu)')
        : pelny;
    };
    const zapamietaj = (u: string) => {
      try {
        const d = new Date().toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });
        sessionStorage.setItem('ep.psi', JSON.stringify({ adres: u, data: d, tekst: tekstKopii(u) }));
      } catch { /* tryb prywatny */ }
    };
    const zapomnij = () => { try { sessionStorage.removeItem('ep.psi'); } catch { /* tryb prywatny */ } };
    let zegarKopii: any;
    kopiuj.addEventListener('click', async () => {
      const t = tekstKopii(ostatni);
      try {
        if (!navigator.clipboard) throw 0;
        await navigator.clipboard.writeText(t);
        kopia.hidden = true;
        kopiuj.textContent = 'Skopiowano';
        clearTimeout(zegarKopii);
        zegarKopii = setTimeout(() => { kopiuj.textContent = 'Skopiuj wyniki'; }, 2000);
      } catch {
        kopia.value = t;
        kopia.hidden = false;
        kopia.focus();
        kopia.select();
      }
    });

    f.addEventListener('submit', (e) => {
      const u = normalizuj(adres.value);
      if (!u) { e.preventDefault(); opis.textContent = BLAD_ADRESU; return; }
      adres.value = u;
      (raport.querySelector('a') as HTMLAnchorElement).href = 'https://pagespeed.web.dev/analysis?url=' + encodeURIComponent(u);
      const k = f.dataset.klucz;
      if (!k) return;
      e.preventDefault();
      ostatni = u;
      Object.keys(dane).forEach((x) => delete dane[x]);
      zalTekst = ''; zalPelna = []; zal.hidden = true;
      wynik.hidden = true; raport.hidden = true; wezwanie.hidden = true; kopiuj.hidden = true; kopia.hidden = true;
      ustaw(werdykt, ''); ustaw(lcp, ''); guzik.disabled = true;
      resetPaskow();
      zegary.hidden = false; trwa.hidden = false; opis.textContent = '';
      STRONY.forEach(startZegara);
      // Enter na telefonie: chowamy klawiaturę i pokazujemy komunikat z zegarami (po schowaniu klawiatury zmienia się wysokość okna).
      adres.blur();
      const doKomunikatu = () => trwa.scrollIntoView({ block: 'start', behavior: spokoj ? 'auto' : 'smooth' });
      doKomunikatu();
      setTimeout(doKomunikatu, 350);
      let limit = false;
      Promise.all(STRONY.map((s) => zapytaj(u, s, k).then((l) => {
        dane[s] = l;
        dojedzZegar(s, ocena(l, 'performance'));
        wynik.hidden = false;
        paski(s, l);
        if (s === 'mobile') opisz(l);
      }).catch((b) => {
        limit = limit || b === 429 || b === 403;
        dojedzZegar(s, null);
        kolumna(s).classList.remove('paski__kol--pracuje');
      }))).then(() => {
        trwa.hidden = true;
        const ile = Object.keys(dane).length;
        if (!ile) {
          opis.textContent = limit
            ? 'Google chwilowo nie przyjmuje kolejnych pomiarów. Spróbuj za chwilę albo otwórz pełny raport.'
            : 'Google nie zdołał zmierzyć tej strony. Sprawdź, czy adres działa, albo otwórz pełny raport.';
          zapomnij();
        } else {
          kopiuj.hidden = false;
          pokazZalecenia();
          zapamietaj(u);
          opis.textContent = ile < 2 ? 'Google zmierzył tylko część wyniku.' : 'Gotowe. Wynik z PageSpeed Insights dla ' + u + '.';
        }
      }).finally(() => { raport.hidden = false; wezwanie.hidden = false; guzik.disabled = false; });
    });
  })();
</script>

