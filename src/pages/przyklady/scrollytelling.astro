---
// /przyklady/scrollytelling/ — stary adres strony przykładowej (do 2026-10-27). Przekierowanie na /efekty/animacja-przewijaniem/.
// Własna strona zamiast `redirects` w astro.config.mjs: strona Astro z redirects nie ma <html lang>, a audyt dist
// (scripts/audit-dist.mjs, B10) traktuje to jako błąd. GitHub Pages nie daje 301, więc meta refresh + canonical.
const cel = '/efekty/animacja-przewijaniem/';
const kanoniczny = new URL(cel, import.meta.env.SITE).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Animacja sterowana przewijaniem — strona przeniesiona — EcoPower Polska</title>
    <meta name="description" content="Strona z animacją sterowaną przewijaniem jest teraz w zakładce Efekty: /efekty/animacja-przewijaniem/." />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={kanoniczny} />
    <meta http-equiv="refresh" content={`0;url=${cel}`} />
  </head>
  <body>
    <h1>Strona przeniesiona</h1>
    <p><a href={cel}>Animacja sterowana przewijaniem jest teraz w zakładce Efekty</a>.</p>
  </body>
</html>
